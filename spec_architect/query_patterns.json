{
  "QP1": {
    "id": "QP1",
    "name": "List tenant documents ready for search/playground",
    "serves": [
      "UC1",
      "J1"
    ],
    "collections": [
      "documents"
    ],
    "for": "Show uploaded documents that are ready for querying in a tenant-scoped demo/playground, optionally filtered by source type, document type, uploader, and recency.",
    "query": {
      "collection": "documents",
      "operation": "find",
      "filter": {
        "tenant_id": "<tenantId>",
        "ingestion_status": "ready",
        "document_type": {
          "$in": [
            "unstructured_document",
            "agent_memory_document"
          ]
        },
        "source_type": {
          "$in": "<optionalSourceTypes>"
        },
        "uploaded_by_user_id": "<optionalUserId>",
        "created_at": {
          "$gte": "<optionalFromDate>",
          "$lte": "<optionalToDate>"
        }
      },
      "projection": {
        "title": 1,
        "document_type": 1,
        "source_type": 1,
        "uploaded_by_user_id": 1,
        "structured_metadata": 1,
        "conversation_metadata": 1,
        "created_at": 1,
        "updated_at": 1
      },
      "sort": {
        "created_at": -1
      },
      "limit": "<pageSize>"
    }
  },
  "QP2": {
    "id": "QP2",
    "name": "Track document ingestion progress for on-the-fly uploads",
    "serves": [
      "UC1",
      "J1"
    ],
    "collections": [
      "documents"
    ],
    "for": "Monitor newly uploaded documents as they move from uploaded to ready/failed during live demo ingestion.",
    "query": {
      "collection": "documents",
      "operation": "find",
      "filter": {
        "tenant_id": "<tenantId>",
        "_id": {
          "$in": "<documentIds>"
        }
      },
      "projection": {
        "title": 1,
        "source_type": 1,
        "ingestion_status": 1,
        "updated_at": 1,
        "created_at": 1
      },
      "sort": {
        "updated_at": -1
      }
    }
  },
  "QP3": {
    "id": "QP3",
    "name": "Browse chunks for a document by chunking strategy",
    "serves": [
      "UC1",
      "UC3"
    ],
    "collections": [
      "document_chunks"
    ],
    "for": "Inspect chunk output for one document and compare fixed-length, recursive, semantic, or contextual chunking during evaluation.",
    "query": {
      "collection": "document_chunks",
      "operation": "find",
      "filter": {
        "tenant_id": "<tenantId>",
        "document_id": "<documentId>",
        "chunking_strategy": "<strategy>"
      },
      "projection": {
        "chunk_index": 1,
        "text": 1,
        "token_count": 1,
        "start_offset": 1,
        "end_offset": 1,
        "embedding_model": 1,
        "metadata.title": 1,
        "metadata.source_type": 1
      },
      "sort": {
        "chunk_index": 1
      }
    }
  },
  "QP4": {
    "id": "QP4",
    "name": "Vector search unstructured document chunks with optional structured filters",
    "serves": [
      "UC1"
    ],
    "collections": [
      "document_chunks"
    ],
    "for": "Answer user questions over uploaded documents using embedding similarity with tenant scoping, source filters, and structured/unstructured hybrid constraints.",
    "query": {
      "collection": "document_chunks",
      "operation": "aggregate",
      "pipeline": [
        {
          "$vectorSearch": {
            "index": "vector_chunks_embedding",
            "path": "embedding",
            "queryVector": "<queryEmbedding>",
            "numCandidates": "<numCandidates>",
            "limit": "<topK>",
            "filter": {
              "tenant_id": "<tenantId>",
              "document_type": "unstructured_document",
              "chunking_strategy": "<optionalStrategy>",
              "metadata.source_type": {
                "$in": "<optionalSourceTypes>"
              },
              "metadata.structured_metadata.labels": {
                "$in": "<optionalLabels>"
              },
              "metadata.structured_metadata.business_attributes.<field>": "<optionalValue>"
            }
          }
        },
        {
          "$project": {
            "_id": 1,
            "document_id": 1,
            "text": 1,
            "chunk_index": 1,
            "chunking_strategy": 1,
            "embedding_model": 1,
            "metadata.title": 1,
            "metadata.source_type": 1,
            "metadata.structured_metadata": 1,
            "score": {
              "$meta": "vectorSearchScore"
            }
          }
        },
        {
          "$limit": "<topK>"
        }
      ]
    }
  },
  "QP5": {
    "id": "QP5",
    "name": "Hybrid lexical plus vector retrieval for document search",
    "serves": [
      "UC1",
      "UC3"
    ],
    "collections": [
      "document_chunks"
    ],
    "for": "Compare semantic retrieval against hybrid retrieval by combining Atlas Search text matching with vector similarity on the same tenant corpus.",
    "query": {
      "collection": "document_chunks",
      "operation": "aggregate",
      "pipeline": [
        {
          "$unionWith": {
            "coll": "document_chunks",
            "pipeline": [
              {
                "$search": {
                  "index": "search_chunks_text",
                  "compound": {
                    "must": [
                      {
                        "text": {
                          "query": "<queryText>",
                          "path": [
                            "text",
                            "metadata.title"
                          ]
                        }
                      }
                    ],
                    "filter": [
                      {
                        "equals": {
                          "path": "tenant_id",
                          "value": "<tenantId>"
                        }
                      },
                      {
                        "equals": {
                          "path": "document_type",
                          "value": "unstructured_document"
                        }
                      },
                      {
                        "equals": {
                          "path": "chunking_strategy",
                          "value": "<optionalStrategy>"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "$project": {
                  "_id": 1,
                  "document_id": 1,
                  "text": 1,
                  "chunk_index": 1,
                  "chunking_strategy": 1,
                  "metadata.title": 1,
                  "metadata.source_type": 1,
                  "retrieval_channel": {
                    "$literal": "text"
                  },
                  "score": {
                    "$meta": "searchScore"
                  }
                }
              },
              {
                "$limit": "<textTopK>"
              }
            ]
          }
        },
        {
          "$vectorSearch": {
            "index": "vector_chunks_embedding",
            "path": "embedding",
            "queryVector": "<queryEmbedding>",
            "numCandidates": "<numCandidates>",
            "limit": "<vectorTopK>",
            "filter": {
              "tenant_id": "<tenantId>",
              "document_type": "unstructured_document",
              "chunking_strategy": "<optionalStrategy>"
            }
          }
        },
        {
          "$project": {
            "_id": 1,
            "document_id": 1,
            "text": 1,
            "chunk_index": 1,
            "chunking_strategy": 1,
            "metadata.title": 1,
            "metadata.source_type": 1,
            "retrieval_channel": {
              "$literal": "vector"
            },
            "score": {
              "$meta": "vectorSearchScore"
            }
          }
        },
        {
          "$group": {
            "_id": "$_id",
            "document_id": {
              "$first": "$document_id"
            },
            "text": {
              "$first": "$text"
            },
            "chunk_index": {
              "$first": "$chunk_index"
            },
            "chunking_strategy": {
              "$first": "$chunking_strategy"
            },
            "title": {
              "$first": "$metadata.title"
            },
            "source_type": {
              "$first": "$metadata.source_type"
            },
            "best_score": {
              "$max": "$score"
            },
            "channels": {
              "$addToSet": "$retrieval_channel"
            }
          }
        },
        {
          "$sort": {
            "best_score": -1
          }
        },
        {
          "$limit": "<topK>"
        }
      ]
    }
  },
  "QP6": {
    "id": "QP6",
    "name": "Retrieve agent memory by tenant and user access tags",
    "serves": [
      "UC2",
      "J2"
    ],
    "collections": [
      "document_chunks"
    ],
    "for": "Fetch relevant conversation-derived memory for an agent while enforcing tenant and user/group access boundaries.",
    "query": {
      "collection": "document_chunks",
      "operation": "aggregate",
      "pipeline": [
        {
          "$vectorSearch": {
            "index": "vector_chunks_embedding",
            "path": "embedding",
            "queryVector": "<queryEmbedding>",
            "numCandidates": "<numCandidates>",
            "limit": "<topK>",
            "filter": {
              "tenant_id": "<tenantId>",
              "document_type": "agent_memory_document",
              "metadata.access_tags.user_ids": "<userId>",
              "metadata.access_tags.groups": {
                "$in": "<optionalGroups>"
              },
              "chunking_strategy": "<optionalStrategy>"
            }
          }
        },
        {
          "$project": {
            "_id": 1,
            "document_id": 1,
            "text": 1,
            "chunk_index": 1,
            "metadata.title": 1,
            "metadata.access_tags": 1,
            "metadata.structured_metadata": 1,
            "score": {
              "$meta": "vectorSearchScore"
            }
          }
        },
        {
          "$limit": "<topK>"
        }
      ]
    }
  },
  "QP7": {
    "id": "QP7",
    "name": "List recent agent memory documents for a user/session",
    "serves": [
      "UC2",
      "J2"
    ],
    "collections": [
      "documents"
    ],
    "for": "Show recent conversation-derived memory documents for a tenant, optionally scoped to user or session, to inspect what memory is available before retrieval.",
    "query": {
      "collection": "documents",
      "operation": "find",
      "filter": {
        "tenant_id": "<tenantId>",
        "document_type": "agent_memory_document",
        "access_tags.user_ids": "<optionalUserId>",
        "conversation_metadata.session_id": "<optionalSessionId>",
        "ingestion_status": "ready"
      },
      "projection": {
        "title": 1,
        "source_type": 1,
        "conversation_metadata": 1,
        "access_tags": 1,
        "created_at": 1,
        "updated_at": 1
      },
      "sort": {
        "created_at": -1
      },
      "limit": "<pageSize>"
    }
  },
  "QP8": {
    "id": "QP8",
    "name": "Fetch parent documents for retrieved chunks",
    "serves": [
      "UC1",
      "UC2"
    ],
    "collections": [
      "document_chunks",
      "documents"
    ],
    "for": "Hydrate retrieved chunk hits with parent document metadata and source information for result display and agent grounding.",
    "query": {
      "collection": "document_chunks",
      "operation": "aggregate",
      "pipeline": [
        {
          "$match": {
            "_id": {
              "$in": "<chunkIds>"
            }
          }
        },
        {
          "$lookup": {
            "from": "documents",
            "localField": "document_id",
            "foreignField": "_id",
            "as": "document"
          }
        },
        {
          "$unwind": "$document"
        },
        {
          "$project": {
            "chunk_id": "$_id",
            "document_id": 1,
            "text": 1,
            "chunk_index": 1,
            "chunking_strategy": 1,
            "score": "<optionalScoreFromCaller>",
            "document.title": 1,
            "document.source_uri": 1,
            "document.source_type": 1,
            "document.mime_type": 1,
            "document.structured_metadata": 1,
            "document.created_at": 1
          }
        }
      ]
    }
  },
  "QP9": {
    "id": "QP9",
    "name": "Select benchmark queries by scenario and filters",
    "serves": [
      "UC3"
    ],
    "collections": [
      "benchmark_queries"
    ],
    "for": "Load the benchmark question set for a document-search, agent-memory, or hybrid evaluation run.",
    "query": {
      "collection": "benchmark_queries",
      "operation": "find",
      "filter": {
        "tenant_id": "<optionalTenantId>",
        "query_type": "<queryType>",
        "target_document_type": "<optionalDocumentType>",
        "filters.source_types": {
          "$in": "<optionalSourceTypes>"
        },
        "filters.user_id": "<optionalUserId>",
        "filters.chunking_strategy": "<optionalStrategy>"
      }
    }
  },
  "QP10": {
    "id": "QP10",
    "name": "Load relevance judgments for a benchmark query",
    "serves": [
      "UC3"
    ],
    "collections": [
      "benchmark_relevance_judgments"
    ],
    "for": "Get ground-truth relevant chunks/documents for one benchmark query so precision and recall can be calculated.",
    "query": {
      "collection": "benchmark_relevance_judgments",
      "operation": "find",
      "filter": {
        "query_id": "<queryId>"
      },
      "projection": {
        "document_id": 1,
        "chunk_id": 1,
        "relevance_grade": 1,
        "notes": 1
      }
    }
  },
  "QP11": {
    "id": "QP11",
    "name": "List benchmark runs and aggregate comparison metrics",
    "serves": [
      "UC3"
    ],
    "collections": [
      "benchmark_runs"
    ],
    "for": "Show recent side-by-side evaluation runs with precision, recall, and latency summaries per compared system.",
    "query": {
      "collection": "benchmark_runs",
      "operation": "find",
      "filter": {
        "tenant_id": "<optionalTenantId>",
        "status": "<optionalStatus>"
      },
      "projection": {
        "run_name": 1,
        "corpus_label": 1,
        "systems_compared": 1,
        "query_set.top_k_values": 1,
        "aggregate_metrics": 1,
        "started_at": 1,
        "completed_at": 1,
        "status": 1
      },
      "sort": {
        "started_at": -1
      },
      "limit": "<pageSize>"
    }
  },
  "QP12": {
    "id": "QP12",
    "name": "Drill into per-query benchmark run results",
    "serves": [
      "UC3"
    ],
    "collections": [
      "benchmark_run_results",
      "benchmark_queries"
    ],
    "for": "Inspect ranked hits, rerank scores, latency, and per-query precision/recall for each system in a benchmark run.",
    "query": {
      "collection": "benchmark_run_results",
      "operation": "aggregate",
      "pipeline": [
        {
          "$match": {
            "run_id": "<runId>",
            "query_id": "<optionalQueryId>"
          }
        },
        {
          "$lookup": {
            "from": "benchmark_queries",
            "localField": "query_id",
            "foreignField": "_id",
            "as": "query"
          }
        },
        {
          "$unwind": "$query"
        },
        {
          "$project": {
            "run_id": 1,
            "query_id": 1,
            "query_text": "$query.query_text",
            "query_type": "$query.query_type",
            "system_results": 1
          }
        },
        {
          "$sort": {
            "query_id": 1
          }
        }
      ]
    }
  },
  "QP13": {
    "id": "QP13",
    "name": "Compare benchmark runs across chunking strategies/systems",
    "serves": [
      "UC3"
    ],
    "collections": [
      "benchmark_runs"
    ],
    "for": "Compare completed runs to see how chunking strategy or retrieval mode affected precision, recall, and latency.",
    "query": {
      "collection": "benchmark_runs",
      "operation": "aggregate",
      "pipeline": [
        {
          "$match": {
            "tenant_id": "<optionalTenantId>",
            "status": "completed",
            "systems_compared.chunking_strategy": {
              "$in": "<optionalStrategies>"
            },
            "systems_compared.system_name": {
              "$in": "<optionalSystemNames>"
            }
          }
        },
        {
          "$unwind": "$systems_compared"
        },
        {
          "$project": {
            "run_name": 1,
            "corpus_label": 1,
            "started_at": 1,
            "completed_at": 1,
            "system_name": "$systems_compared.system_name",
            "retrieval_mode": "$systems_compared.retrieval_mode",
            "chunking_strategy": "$systems_compared.chunking_strategy",
            "aggregate_metrics": {
              "$filter": {
                "input": "$aggregate_metrics",
                "as": "m",
                "cond": {
                  "$eq": [
                    "$$m.system_name",
                    "$systems_compared.system_name"
                  ]
                }
              }
            }
          }
        },
        {
          "$sort": {
            "started_at": -1
          }
        }
      ]
    }
  },
  "QP14": {
    "id": "QP14",
    "name": "Count ready corpus by tenant, source type, and document type",
    "serves": [
      "UC1",
      "UC2",
      "UC3"
    ],
    "collections": [
      "documents"
    ],
    "for": "Summarize the indexed corpus available for search or benchmarking by tenant and content type.",
    "query": {
      "collection": "documents",
      "operation": "aggregate",
      "pipeline": [
        {
          "$match": {
            "tenant_id": "<tenantId>",
            "ingestion_status": "ready"
          }
        },
        {
          "$group": {
            "_id": {
              "document_type": "$document_type",
              "source_type": "$source_type"
            },
            "document_count": {
              "$sum": 1
            },
            "latest_created_at": {
              "$max": "$created_at"
            }
          }
        },
        {
          "$sort": {
            "_id.document_type": 1,
            "_id.source_type": 1
          }
        }
      ]
    }
  }
}
{
  "QP1": {
    "id": "QP1",
    "name": "List tenant documents for workshop session",
    "serves": [
      "UC1",
      "FR2",
      "FR3",
      "SC1"
    ],
    "collections": [
      "documents"
    ],
    "query": {
      "collection": "documents",
      "operation": "find",
      "filter": {
        "tenant_id": "<tenantId>",
        "upload_session_label": "<sessionLabel>"
      },
      "projection": {
        "_id": 1,
        "document_type": 1,
        "title": 1,
        "source_filename": 1,
        "source_system": 1,
        "ingest_status": 1,
        "chunking_runs": 1,
        "created_at": 1,
        "updated_at": 1
      },
      "sort": {
        "created_at": -1
      },
      "limit": "<pageSize>"
    },
    "purpose": "Show uploaded customer documents for a tenant/session and their current ingestion state during the live workshop."
  },
  "QP2": {
    "id": "QP2",
    "name": "Inspect document ingestion failures",
    "serves": [
      "UC1",
      "FR2",
      "FR7"
    ],
    "collections": [
      "documents"
    ],
    "query": {
      "collection": "documents",
      "operation": "find",
      "filter": {
        "tenant_id": "<tenantId>",
        "ingest_status": "failed"
      },
      "projection": {
        "_id": 1,
        "title": 1,
        "source_filename": 1,
        "document_type": 1,
        "ingest_status": 1,
        "ingest_errors": 1,
        "updated_at": 1
      },
      "sort": {
        "updated_at": -1
      }
    },
    "purpose": "Troubleshoot uploaded documents that failed parse/chunk/embed steps."
  },
  "QP3": {
    "id": "QP3",
    "name": "Tenant-scoped vector retrieval over document chunks",
    "serves": [
      "UC1",
      "AI1",
      "SC4",
      "SC5"
    ],
    "collections": [
      "document_chunks",
      "documents"
    ],
    "query": {
      "collection": "document_chunks",
      "operation": "aggregate",
      "pipeline": [
        {
          "$vectorSearch": {
            "index": "document_chunks_vector_index",
            "path": "embedding",
            "queryVector": "<queryEmbedding>",
            "numCandidates": "<numCandidates>",
            "limit": "<topK>",
            "filter": {
              "tenant_id": "<tenantId>",
              "chunking_strategy": "<chunkingStrategy>",
              "embedding_model": "<embeddingModel>"
            }
          }
        },
        {
          "$project": {
            "_id": 1,
            "tenant_id": 1,
            "document_id": 1,
            "chunking_strategy": 1,
            "chunk_index": 1,
            "text": 1,
            "page_start": 1,
            "page_end": 1,
            "section_title": 1,
            "embedding_model": 1,
            "score": {
              "$meta": "vectorSearchScore"
            }
          }
        },
        {
          "$lookup": {
            "from": "documents",
            "localField": "document_id",
            "foreignField": "_id",
            "as": "document"
          }
        },
        {
          "$unwind": "$document"
        },
        {
          "$project": {
            "_id": 1,
            "document_id": 1,
            "document_title": "$document.title",
            "source_filename": "$document.source_filename",
            "document_type": "$document.document_type",
            "chunking_strategy": 1,
            "chunk_index": 1,
            "text": 1,
            "page_start": 1,
            "page_end": 1,
            "section_title": 1,
            "embedding_model": 1,
            "score": 1
          }
        }
      ]
    },
    "purpose": "Retrieve the most semantically relevant chunks for a user question, scoped to one tenant and a chosen chunking strategy/model."
  },
  "QP4": {
    "id": "QP4",
    "name": "Keyword or metadata-filtered chunk retrieval",
    "serves": [
      "UC1",
      "UC3",
      "BO1"
    ],
    "collections": [
      "documents",
      "document_chunks"
    ],
    "query": {
      "collection": "documents",
      "operation": "aggregate",
      "pipeline": [
        {
          "$match": {
            "tenant_id": "<tenantId>",
            "document_type": {
              "$in": "<documentTypesArray>"
            },
            "metadata.language": "<language>",
            "metadata.tags": {
              "$in": "<tagsArray>"
            }
          }
        },
        {
          "$lookup": {
            "from": "document_chunks",
            "let": {
              "docId": "$_id",
              "tenantId": "$tenant_id"
            },
            "pipeline": [
              {
                "$match": {
                  "$expr": {
                    "$and": [
                      {
                        "$eq": [
                          "$document_id",
                          "$$docId"
                        ]
                      },
                      {
                        "$eq": [
                          "$tenant_id",
                          "$$tenantId"
                        ]
                      },
                      {
                        "$eq": [
                          "$chunking_strategy",
                          "<chunkingStrategy>"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "$match": {
                  "text": {
                    "$regex": "<keywordOrPhrase>",
                    "$options": "i"
                  }
                }
              },
              {
                "$project": {
                  "_id": 1,
                  "document_id": 1,
                  "chunk_index": 1,
                  "text": 1,
                  "section_title": 1,
                  "page_start": 1,
                  "page_end": 1
                }
              }
            ],
            "as": "matching_chunks"
          }
        },
        {
          "$match": {
            "matching_chunks.0": {
              "$exists": true
            }
          }
        },
        {
          "$project": {
            "_id": 1,
            "title": 1,
            "document_type": 1,
            "source_filename": 1,
            "metadata": 1,
            "matching_chunks": 1
          }
        }
      ]
    },
    "purpose": "Explore retrieval constrained by structured metadata plus chunk text matching, supporting structured-plus-unstructured demonstrations."
  },
  "QP5": {
    "id": "QP5",
    "name": "Hybrid structured plus unstructured retrieval",
    "serves": [
      "UC3",
      "BO1",
      "FR1"
    ],
    "collections": [
      "document_chunks",
      "documents"
    ],
    "query": {
      "collection": "document_chunks",
      "operation": "aggregate",
      "pipeline": [
        {
          "$vectorSearch": {
            "index": "document_chunks_vector_index",
            "path": "embedding",
            "queryVector": "<queryEmbedding>",
            "numCandidates": "<numCandidates>",
            "limit": "<topK>",
            "filter": {
              "tenant_id": "<tenantId>",
              "chunking_strategy": "<chunkingStrategy>"
            }
          }
        },
        {
          "$lookup": {
            "from": "documents",
            "localField": "document_id",
            "foreignField": "_id",
            "as": "document"
          }
        },
        {
          "$unwind": "$document"
        },
        {
          "$match": {
            "document.metadata.structured_attributes.<attributeName>": "<attributeValue>",
            "document.document_type": {
              "$in": "<documentTypesArray>"
            }
          }
        },
        {
          "$project": {
            "_id": 1,
            "document_id": 1,
            "chunk_index": 1,
            "text": 1,
            "score": {
              "$meta": "vectorSearchScore"
            },
            "document_title": "$document.title",
            "document_type": "$document.document_type",
            "structured_attributes": "$document.metadata.structured_attributes"
          }
        }
      ]
    },
    "purpose": "Demonstrate semantic retrieval over chunks while enforcing structured business filters from the parent document metadata."
  },
  "QP6": {
    "id": "QP6",
    "name": "Compare chunking strategy coverage for uploaded documents",
    "serves": [
      "UC1",
      "FR8"
    ],
    "collections": [
      "documents"
    ],
    "query": {
      "collection": "documents",
      "operation": "aggregate",
      "pipeline": [
        {
          "$match": {
            "tenant_id": "<tenantId>",
            "upload_session_label": "<sessionLabel>"
          }
        },
        {
          "$project": {
            "title": 1,
            "source_filename": 1,
            "ingest_status": 1,
            "chunking_runs": 1
          }
        },
        {
          "$unwind": {
            "path": "$chunking_runs",
            "preserveNullAndEmptyArrays": true
          }
        },
        {
          "$group": {
            "_id": {
              "chunking_strategy": "$chunking_runs.chunking_strategy"
            },
            "documentsCovered": {
              "$sum": 1
            },
            "totalChunks": {
              "$sum": {
                "$ifNull": [
                  "$chunking_runs.chunk_count",
                  0
                ]
              }
            },
            "lastRunAt": {
              "$max": "$chunking_runs.run_timestamp"
            }
          }
        },
        {
          "$sort": {
            "_id.chunking_strategy": 1
          }
        }
      ]
    },
    "purpose": "Summarize which chunking strategies were run and how many chunks/documents each produced for the workshop dataset."
  },
  "QP7": {
    "id": "QP7",
    "name": "Retrieve agent memory context by semantic similarity",
    "serves": [
      "UC2",
      "FR9"
    ],
    "collections": [
      "agent_memory_entries"
    ],
    "query": {
      "collection": "agent_memory_entries",
      "operation": "aggregate",
      "pipeline": [
        {
          "$vectorSearch": {
            "index": "agent_memory_vector_index",
            "path": "embedding",
            "queryVector": "<queryEmbedding>",
            "numCandidates": "<numCandidates>",
            "limit": "<topK>",
            "filter": {
              "tenant_id": "<tenantId>",
              "session_id": "<sessionId>",
              "memory_type": {
                "$in": "<memoryTypesArray>"
              }
            }
          }
        },
        {
          "$project": {
            "_id": 1,
            "session_id": 1,
            "turn_id": 1,
            "role": 1,
            "text": 1,
            "memory_type": 1,
            "created_at": 1,
            "metadata": 1,
            "score": {
              "$meta": "vectorSearchScore"
            }
          }
        },
        {
          "$sort": {
            "score": -1,
            "created_at": -1
          }
        }
      ]
    },
    "purpose": "Fetch the most relevant prior conversation or derived memory entries for an agent workflow."
  },
  "QP8": {
    "id": "QP8",
    "name": "List benchmark runs for a tenant",
    "serves": [
      "UJ1",
      "FR4",
      "FR5",
      "SC2"
    ],
    "collections": [
      "benchmark_runs"
    ],
    "query": {
      "collection": "benchmark_runs",
      "operation": "find",
      "filter": {
        "tenant_id": "<tenantId>"
      },
      "projection": {
        "_id": 1,
        "name": 1,
        "run_type": 1,
        "baseline_system": 1,
        "chunking_strategy": 1,
        "embedding_model": 1,
        "top_k_values": 1,
        "started_at": 1,
        "completed_at": 1
      },
      "sort": {
        "started_at": -1
      }
    },
    "purpose": "Show available evaluation runs and side-by-side comparison contexts for the tenant."
  },
  "QP9": {
    "id": "QP9",
    "name": "Fetch benchmark questions for a run",
    "serves": [
      "UJ1",
      "FR6",
      "SC3",
      "SC5"
    ],
    "collections": [
      "benchmark_questions"
    ],
    "query": {
      "collection": "benchmark_questions",
      "operation": "find",
      "filter": {
        "benchmark_run_id": "<benchmarkRunId>"
      },
      "projection": {
        "_id": 1,
        "sequence_number": 1,
        "question_text": 1,
        "ground_truth_notes": 1,
        "expected_document_ids": 1,
        "expected_chunk_ids": 1
      },
      "sort": {
        "sequence_number": 1
      }
    },
    "purpose": "Load the customer-provided benchmark prompts and optional expected answers for a specific evaluation run."
  },
  "QP10": {
    "id": "QP10",
    "name": "Get ranked retrieval results for one benchmark question",
    "serves": [
      "FR5",
      "FR6",
      "SC2",
      "SC3",
      "SC4",
      "SC5"
    ],
    "collections": [
      "benchmark_results",
      "documents",
      "document_chunks"
    ],
    "query": {
      "collection": "benchmark_results",
      "operation": "aggregate",
      "pipeline": [
        {
          "$match": {
            "benchmark_run_id": "<benchmarkRunId>",
            "benchmark_question_id": "<benchmarkQuestionId>",
            "system_name": "<systemName>",
            "rank": {
              "$lte": "<topK>"
            }
          }
        },
        {
          "$lookup": {
            "from": "documents",
            "localField": "retrieved_document_id",
            "foreignField": "_id",
            "as": "document"
          }
        },
        {
          "$lookup": {
            "from": "document_chunks",
            "localField": "retrieved_chunk_id",
            "foreignField": "_id",
            "as": "chunk"
          }
        },
        {
          "$project": {
            "_id": 1,
            "system_name": 1,
            "retrieval_mode": 1,
            "rank": 1,
            "score": 1,
            "latency_ms": 1,
            "is_relevant": 1,
            "evaluation_notes": 1,
            "document": {
              "$first": "$document"
            },
            "chunk": {
              "$first": "$chunk"
            }
          }
        },
        {
          "$sort": {
            "rank": 1
          }
        }
      ]
    },
    "purpose": "Inspect the ranked outputs, scores, and latency for a single benchmark question and system under test."
  },
  "QP11": {
    "id": "QP11",
    "name": "Side-by-side benchmark comparison across systems",
    "serves": [
      "UJ1",
      "FR5",
      "SC2",
      "SC4",
      "SC6"
    ],
    "collections": [
      "benchmark_results",
      "benchmark_questions"
    ],
    "query": {
      "collection": "benchmark_results",
      "operation": "aggregate",
      "pipeline": [
        {
          "$match": {
            "benchmark_run_id": "<benchmarkRunId>",
            "rank": {
              "$in": "<topKValuesArray>"
            }
          }
        },
        {
          "$group": {
            "_id": {
              "benchmark_question_id": "$benchmark_question_id",
              "system_name": "$system_name",
              "rank": "$rank"
            },
            "avg_latency_ms": {
              "$avg": "$latency_ms"
            },
            "relevant_hits": {
              "$sum": {
                "$cond": [
                  {
                    "$eq": [
                      "$is_relevant",
                      true
                    ]
                  },
                  1,
                  0
                ]
              }
            },
            "total_hits": {
              "$sum": 1
            }
          }
        },
        {
          "$addFields": {
            "precision_at_k": {
              "$cond": [
                {
                  "$gt": [
                    "$total_hits",
                    0
                  ]
                },
                {
                  "$divide": [
                    "$relevant_hits",
                    "$total_hits"
                  ]
                },
                0
              ]
            }
          }
        },
        {
          "$lookup": {
            "from": "benchmark_questions",
            "localField": "_id.benchmark_question_id",
            "foreignField": "_id",
            "as": "question"
          }
        },
        {
          "$project": {
            "benchmark_question_id": "$_id.benchmark_question_id",
            "system_name": "$_id.system_name",
            "rank": "$_id.rank",
            "avg_latency_ms": 1,
            "relevant_hits": 1,
            "total_hits": 1,
            "precision_at_k": 1,
            "question_text": {
              "$first": "$question.question_text"
            }
          }
        },
        {
          "$sort": {
            "benchmark_question_id": 1,
            "system_name": 1,
            "rank": 1
          }
        }
      ]
    },
    "purpose": "Compare MongoDB and baseline systems on relevance and latency for each benchmark question and top-K cutoff."
  },
  "QP12": {
    "id": "QP12",
    "name": "Run-level benchmark summary metrics",
    "serves": [
      "FR5",
      "AI5",
      "SC4",
      "SC5",
      "SC6",
      "SC7"
    ],
    "collections": [
      "benchmark_results",
      "benchmark_questions"
    ],
    "query": {
      "collection": "benchmark_results",
      "operation": "aggregate",
      "pipeline": [
        {
          "$match": {
            "benchmark_run_id": "<benchmarkRunId>",
            "system_name": {
              "$in": "<systemsArray>"
            }
          }
        },
        {
          "$group": {
            "_id": {
              "system_name": "$system_name",
              "question_id": "$benchmark_question_id"
            },
            "best_rank": {
              "$min": "$rank"
            },
            "avg_latency_ms_per_question": {
              "$avg": "$latency_ms"
            },
            "relevant_retrievals": {
              "$sum": {
                "$cond": [
                  {
                    "$eq": [
                      "$is_relevant",
                      true
                    ]
                  },
                  1,
                  0
                ]
              }
            }
          }
        },
        {
          "$group": {
            "_id": "$_id.system_name",
            "question_count": {
              "$sum": 1
            },
            "avg_latency_ms": {
              "$avg": "$avg_latency_ms_per_question"
            },
            "questions_with_relevant_hit": {
              "$sum": {
                "$cond": [
                  {
                    "$gt": [
                      "$relevant_retrievals",
                      0
                    ]
                  },
                  1,
                  0
                ]
              }
            }
          }
        },
        {
          "$lookup": {
            "from": "benchmark_questions",
            "pipeline": [
              {
                "$match": {
                  "benchmark_run_id": "<benchmarkRunId>"
                }
              },
              {
                "$count": "total_questions"
              }
            ],
            "as": "question_counts"
          }
        },
        {
          "$project": {
            "system_name": "$_id",
            "question_count": 1,
            "avg_latency_ms": 1,
            "questions_with_relevant_hit": 1,
            "total_questions": {
              "$ifNull": [
                {
                  "$first": "$question_counts.total_questions"
                },
                0
              ]
            },
            "recall_proxy": {
              "$cond": [
                {
                  "$gt": [
                    {
                      "$ifNull": [
                        {
                          "$first": "$question_counts.total_questions"
                        },
                        0
                      ]
                    },
                    0
                  ]
                },
                {
                  "$divide": [
                    "$questions_with_relevant_hit",
                    {
                      "$first": "$question_counts.total_questions"
                    }
                  ]
                },
                0
              ]
            }
          }
        },
        {
          "$sort": {
            "avg_latency_ms": 1
          }
        }
      ]
    },
    "purpose": "Summarize overall run performance by system, including latency and a question-level recall proxy for workshop reporting."
  }
}
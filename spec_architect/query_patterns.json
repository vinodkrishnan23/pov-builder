{
  "QP1": {
    "id": "QP1",
    "name": "List tenant documents for live demo and filtering",
    "serves": [
      "UC1",
      "UC3"
    ],
    "collections": [
      "documents"
    ],
    "query": {
      "collection": "documents",
      "operation": "find",
      "filter": {
        "tenant_id": "<tenantId>",
        "document_type": {
          "$in": [
            "uploaded_file",
            "benchmark_supporting_doc"
          ]
        },
        "source_type": {
          "$in": [
            "pdf",
            "csv",
            "google_sheet",
            "text",
            "research_paper",
            "business_document",
            "jira_export",
            "slack_export",
            "other"
          ]
        },
        "processing_status": {
          "$in": [
            "uploaded",
            "parsed",
            "chunked",
            "embedded",
            "failed"
          ]
        }
      },
      "projection": {
        "title": 1,
        "original_filename": 1,
        "document_type": 1,
        "source_type": 1,
        "processing_status": 1,
        "storage_location_type": 1,
        "ingested_at": 1,
        "metadata.tags": 1
      },
      "sort": {
        "ingested_at": -1
      },
      "limit": 100
    },
    "purpose": "Show recently ingested customer documents in the tenant and allow filtering by type/status during the live evaluation."
  },
  "QP2": {
    "id": "QP2",
    "name": "List agent memory documents by conversation or session",
    "serves": [
      "UC2"
    ],
    "collections": [
      "documents"
    ],
    "query": {
      "collection": "documents",
      "operation": "find",
      "filter": {
        "tenant_id": "<tenantId>",
        "document_type": "agent_memory",
        "$or": [
          {
            "metadata.conversation_id": "<conversationId>"
          },
          {
            "metadata.session_id": "<sessionId>"
          }
        ],
        "processing_status": {
          "$in": [
            "parsed",
            "chunked",
            "embedded"
          ]
        }
      },
      "projection": {
        "title": 1,
        "source_type": 1,
        "metadata.conversation_id": 1,
        "metadata.session_id": 1,
        "processing_status": 1,
        "ingested_at": 1,
        "updated_at": 1
      },
      "sort": {
        "updated_at": -1
      },
      "limit": 50
    },
    "purpose": "Retrieve conversation-derived memory documents for a given conversation/session before running memory retrieval."
  },
  "QP3": {
    "id": "QP3",
    "name": "Inspect chunk outputs for a document across chunking strategies",
    "serves": [
      "UC1",
      "UC3"
    ],
    "collections": [
      "document_chunks"
    ],
    "query": {
      "collection": "document_chunks",
      "operation": "find",
      "filter": {
        "tenant_id": "<tenantId>",
        "document_id": "<documentId>",
        "chunking_strategy": {
          "$in": [
            "fixed_length",
            "recursive",
            "semantic",
            "contextual"
          ]
        }
      },
      "projection": {
        "document_id": 1,
        "chunking_strategy": 1,
        "strategy_params": 1,
        "chunk_index": 1,
        "text": 1,
        "token_count": 1,
        "page_span": 1,
        "embedding_model": 1
      },
      "sort": {
        "chunking_strategy": 1,
        "chunk_index": 1
      },
      "limit": 500
    },
    "purpose": "Review how the same document was chunked under each strategy for comparison and troubleshooting."
  },
  "QP4": {
    "id": "QP4",
    "name": "Keyword chunk retrieval for document search baseline",
    "serves": [
      "UC1",
      "UC3"
    ],
    "collections": [
      "document_chunks",
      "documents"
    ],
    "query": {
      "collection": "document_chunks",
      "operation": "aggregate",
      "pipeline": [
        {
          "$search": {
            "index": "search_chunks_text",
            "text": {
              "query": "<queryText>",
              "path": "text"
            }
          }
        },
        {
          "$match": {
            "tenant_id": "<tenantId>",
            "chunking_strategy": "<chunkingStrategy>",
            "document_id": {
              "$in": "<optionalDocumentIds>"
            }
          }
        },
        {
          "$limit": 20
        },
        {
          "$project": {
            "document_id": 1,
            "chunk_id": "$_id",
            "chunking_strategy": 1,
            "score": {
              "$meta": "searchScore"
            },
            "snippet": {
              "$substrCP": [
                "$text",
                0,
                300
              ]
            }
          }
        },
        {
          "$lookup": {
            "from": "documents",
            "localField": "document_id",
            "foreignField": "_id",
            "as": "document"
          }
        },
        {
          "$unwind": "$document"
        },
        {
          "$project": {
            "rank_placeholder": 1,
            "document_id": 1,
            "chunk_id": 1,
            "score": 1,
            "snippet": 1,
            "document_title": "$document.title",
            "source_type": "$document.source_type"
          }
        }
      ]
    },
    "purpose": "Run lexical retrieval over chunk text as a keyword baseline or hybrid component for document search comparisons."
  },
  "QP5": {
    "id": "QP5",
    "name": "Vector chunk retrieval for document search",
    "serves": [
      "UC1",
      "UC3"
    ],
    "collections": [
      "document_chunks",
      "documents"
    ],
    "query": {
      "collection": "document_chunks",
      "operation": "aggregate",
      "pipeline": [
        {
          "$vectorSearch": {
            "index": "vector_chunks_embedding",
            "path": "embedding",
            "queryVector": "<queryEmbedding>",
            "numCandidates": 200,
            "limit": 20,
            "filter": {
              "tenant_id": "<tenantId>",
              "chunking_strategy": "<chunkingStrategy>"
            }
          }
        },
        {
          "$match": {
            "document_id": {
              "$in": "<optionalDocumentIds>"
            }
          }
        },
        {
          "$project": {
            "document_id": 1,
            "chunk_id": "$_id",
            "chunking_strategy": 1,
            "score": {
              "$meta": "vectorSearchScore"
            },
            "text": 1,
            "page_span": 1
          }
        },
        {
          "$lookup": {
            "from": "documents",
            "localField": "document_id",
            "foreignField": "_id",
            "as": "document"
          }
        },
        {
          "$unwind": "$document"
        },
        {
          "$project": {
            "document_id": 1,
            "chunk_id": 1,
            "score": 1,
            "snippet": {
              "$substrCP": [
                "$text",
                0,
                300
              ]
            },
            "page_span": 1,
            "document_title": "$document.title",
            "source_type": "$document.source_type",
            "document_type": "$document.document_type"
          }
        }
      ]
    },
    "purpose": "Retrieve the most semantically relevant chunks for a user query within a tenant and chosen chunking strategy."
  },
  "QP6": {
    "id": "QP6",
    "name": "Hybrid retrieval combining vector and keyword scores",
    "serves": [
      "UC1",
      "UC2",
      "UC3"
    ],
    "collections": [
      "document_chunks",
      "documents"
    ],
    "query": {
      "collection": "document_chunks",
      "operation": "aggregate",
      "pipeline": [
        {
          "$vectorSearch": {
            "index": "vector_chunks_embedding",
            "path": "embedding",
            "queryVector": "<queryEmbedding>",
            "numCandidates": 200,
            "limit": 50,
            "filter": {
              "tenant_id": "<tenantId>",
              "chunking_strategy": "<chunkingStrategy>"
            }
          }
        },
        {
          "$project": {
            "chunk_id": "$_id",
            "document_id": 1,
            "vector_score": {
              "$meta": "vectorSearchScore"
            },
            "text": 1
          }
        },
        {
          "$unionWith": {
            "coll": "document_chunks",
            "pipeline": [
              {
                "$search": {
                  "index": "search_chunks_text",
                  "text": {
                    "query": "<queryText>",
                    "path": "text"
                  }
                }
              },
              {
                "$match": {
                  "tenant_id": "<tenantId>",
                  "chunking_strategy": "<chunkingStrategy>"
                }
              },
              {
                "$project": {
                  "chunk_id": "$_id",
                  "document_id": 1,
                  "keyword_score": {
                    "$meta": "searchScore"
                  },
                  "text": 1
                }
              },
              {
                "$limit": 50
              }
            ]
          }
        },
        {
          "$group": {
            "_id": "$chunk_id",
            "document_id": {
              "$first": "$document_id"
            },
            "text": {
              "$first": "$text"
            },
            "vector_score": {
              "$max": "$vector_score"
            },
            "keyword_score": {
              "$max": "$keyword_score"
            }
          }
        },
        {
          "$addFields": {
            "combined_score": {
              "$add": [
                {
                  "$ifNull": [
                    "$vector_score",
                    0
                  ]
                },
                {
                  "$ifNull": [
                    "$keyword_score",
                    0
                  ]
                }
              ]
            }
          }
        },
        {
          "$sort": {
            "combined_score": -1
          }
        },
        {
          "$limit": 20
        },
        {
          "$lookup": {
            "from": "documents",
            "localField": "document_id",
            "foreignField": "_id",
            "as": "document"
          }
        },
        {
          "$unwind": "$document"
        },
        {
          "$project": {
            "chunk_id": "$_id",
            "document_id": 1,
            "combined_score": 1,
            "vector_score": 1,
            "keyword_score": 1,
            "snippet": {
              "$substrCP": [
                "$text",
                0,
                300
              ]
            },
            "document_title": "$document.title",
            "document_type": "$document.document_type"
          }
        }
      ]
    },
    "purpose": "Support a hybrid retrieval mode for head-to-head comparison with pure vector or keyword retrieval."
  },
  "QP7": {
    "id": "QP7",
    "name": "Vector retrieval for agent memory context",
    "serves": [
      "UC2"
    ],
    "collections": [
      "document_chunks",
      "documents"
    ],
    "query": {
      "collection": "document_chunks",
      "operation": "aggregate",
      "pipeline": [
        {
          "$vectorSearch": {
            "index": "vector_chunks_embedding",
            "path": "embedding",
            "queryVector": "<queryEmbedding>",
            "numCandidates": 100,
            "limit": 10,
            "filter": {
              "tenant_id": "<tenantId>",
              "chunking_strategy": "<chunkingStrategy>"
            }
          }
        },
        {
          "$lookup": {
            "from": "documents",
            "localField": "document_id",
            "foreignField": "_id",
            "as": "document"
          }
        },
        {
          "$unwind": "$document"
        },
        {
          "$match": {
            "document.document_type": "agent_memory",
            "$or": [
              {
                "document.metadata.conversation_id": "<conversationId>"
              },
              {
                "document.metadata.session_id": "<sessionId>"
              }
            ]
          }
        },
        {
          "$project": {
            "document_id": 1,
            "chunk_id": "$_id",
            "score": {
              "$meta": "vectorSearchScore"
            },
            "snippet": {
              "$substrCP": [
                "$text",
                0,
                300
              ]
            },
            "conversation_id": "$document.metadata.conversation_id",
            "session_id": "$document.metadata.session_id",
            "updated_at": "$document.updated_at"
          }
        },
        {
          "$sort": {
            "score": -1
          }
        },
        {
          "$limit": 10
        }
      ]
    },
    "purpose": "Fetch the most relevant memory snippets for an agent from conversation-derived documents in the current conversation/session scope."
  },
  "QP8": {
    "id": "QP8",
    "name": "List customer-provided benchmark prompts and targets",
    "serves": [
      "UC3"
    ],
    "collections": [
      "benchmark_ground_truths"
    ],
    "query": {
      "collection": "benchmark_ground_truths",
      "operation": "find",
      "filter": {
        "tenant_id": "<tenantId>",
        "task_type": "<taskType>",
        "provided_during_session": true
      },
      "projection": {
        "prompt_text": 1,
        "task_type": 1,
        "ground_truth_text": 1,
        "relevant_document_ids": 1,
        "relevant_chunk_ids": 1,
        "top_k_targets": 1,
        "notes": 1,
        "created_at": 1
      },
      "sort": {
        "created_at": -1
      },
      "limit": 100
    },
    "purpose": "Show the benchmark questions/ground truths supplied during the live session and their expected targets."
  },
  "QP9": {
    "id": "QP9",
    "name": "Fetch a benchmark prompt with linked relevant documents/chunks",
    "serves": [
      "UC3"
    ],
    "collections": [
      "benchmark_ground_truths",
      "documents",
      "document_chunks"
    ],
    "query": {
      "collection": "benchmark_ground_truths",
      "operation": "aggregate",
      "pipeline": [
        {
          "$match": {
            "_id": "<groundTruthId>",
            "tenant_id": "<tenantId>"
          }
        },
        {
          "$lookup": {
            "from": "documents",
            "localField": "relevant_document_ids",
            "foreignField": "_id",
            "as": "relevant_documents"
          }
        },
        {
          "$lookup": {
            "from": "document_chunks",
            "localField": "relevant_chunk_ids",
            "foreignField": "_id",
            "as": "relevant_chunks"
          }
        },
        {
          "$project": {
            "prompt_text": 1,
            "task_type": 1,
            "ground_truth_text": 1,
            "top_k_targets": 1,
            "relevant_documents": {
              "_id": 1,
              "title": 1,
              "source_type": 1
            },
            "relevant_chunks": {
              "_id": 1,
              "document_id": 1,
              "chunking_strategy": 1,
              "chunk_index": 1,
              "text": 1
            }
          }
        }
      ]
    },
    "purpose": "Load a benchmark prompt together with its expected relevant documents/chunks to drive scoring and explanation."
  },
  "QP10": {
    "id": "QP10",
    "name": "Record benchmark run result",
    "serves": [
      "UC3"
    ],
    "collections": [
      "benchmark_runs"
    ],
    "query": {
      "collection": "benchmark_runs",
      "operation": "insertOne",
      "document": {
        "tenant_id": "<tenantId>",
        "ground_truth_id": "<groundTruthId>",
        "run_label": "<runLabel>",
        "system_under_test": "<systemUnderTest>",
        "retrieval_mode": "<retrievalMode>",
        "chunking_strategy": "<chunkingStrategy>",
        "embedding_model": "<embeddingModel>",
        "candidate_pool_filter": {
          "document_ids": "<optionalDocumentIds>",
          "source_types": "<optionalSourceTypes>"
        },
        "top_k_results": "<topKResultsArray>",
        "metrics": {
          "latency_ms": "<latencyMs>",
          "precision_at_k": "<precisionAtKDocument>",
          "recall_at_k": "<recallAtKDocument>",
          "result_count": "<resultCount>"
        },
        "run_timestamp": "<runTimestamp>",
        "notes": "<notes>"
      }
    },
    "purpose": "Persist the measured output of a benchmark execution so results can be compared and reviewed."
  },
  "QP11": {
    "id": "QP11",
    "name": "Compare benchmark runs by system, retrieval mode, and chunking strategy",
    "serves": [
      "UC3"
    ],
    "collections": [
      "benchmark_runs",
      "benchmark_ground_truths"
    ],
    "query": {
      "collection": "benchmark_runs",
      "operation": "aggregate",
      "pipeline": [
        {
          "$match": {
            "tenant_id": "<tenantId>",
            "ground_truth_id": {
              "$in": "<groundTruthIds>"
            }
          }
        },
        {
          "$lookup": {
            "from": "benchmark_ground_truths",
            "localField": "ground_truth_id",
            "foreignField": "_id",
            "as": "ground_truth"
          }
        },
        {
          "$unwind": "$ground_truth"
        },
        {
          "$project": {
            "ground_truth_id": 1,
            "prompt_text": "$ground_truth.prompt_text",
            "system_under_test": 1,
            "retrieval_mode": 1,
            "chunking_strategy": 1,
            "embedding_model": 1,
            "latency_ms": "$metrics.latency_ms",
            "precision_at_k": "$metrics.precision_at_k",
            "recall_at_k": "$metrics.recall_at_k",
            "result_count": "$metrics.result_count",
            "top_k_results": 1,
            "run_timestamp": 1
          }
        },
        {
          "$sort": {
            "prompt_text": 1,
            "system_under_test": 1,
            "chunking_strategy": 1,
            "run_timestamp": -1
          }
        }
      ]
    },
    "purpose": "Provide the side-by-side evidence view across systems and strategies for one or more benchmark prompts."
  },
  "QP12": {
    "id": "QP12",
    "name": "Summarize benchmark performance across prompts",
    "serves": [
      "UC3"
    ],
    "collections": [
      "benchmark_runs"
    ],
    "query": {
      "collection": "benchmark_runs",
      "operation": "aggregate",
      "pipeline": [
        {
          "$match": {
            "tenant_id": "<tenantId>",
            "run_timestamp": {
              "$gte": "<startTime>",
              "$lte": "<endTime>"
            }
          }
        },
        {
          "$group": {
            "_id": {
              "system_under_test": "$system_under_test",
              "retrieval_mode": "$retrieval_mode",
              "chunking_strategy": "$chunking_strategy"
            },
            "avg_latency_ms": {
              "$avg": "$metrics.latency_ms"
            },
            "avg_precision_at_1": {
              "$avg": "$metrics.precision_at_k.1"
            },
            "avg_precision_at_5": {
              "$avg": "$metrics.precision_at_k.5"
            },
            "avg_precision_at_10": {
              "$avg": "$metrics.precision_at_k.10"
            },
            "avg_precision_at_20": {
              "$avg": "$metrics.precision_at_k.20"
            },
            "avg_recall_at_1": {
              "$avg": "$metrics.recall_at_k.1"
            },
            "avg_recall_at_5": {
              "$avg": "$metrics.recall_at_k.5"
            },
            "avg_recall_at_10": {
              "$avg": "$metrics.recall_at_k.10"
            },
            "avg_recall_at_20": {
              "$avg": "$metrics.recall_at_k.20"
            },
            "run_count": {
              "$sum": 1
            }
          }
        },
        {
          "$sort": {
            "avg_precision_at_5": -1,
            "avg_latency_ms": 1
          }
        }
      ]
    },
    "purpose": "Produce rolled-up benchmark numbers to identify the best-performing strategy/system combination across the evaluated prompt set."
  },
  "QP13": {
    "id": "QP13",
    "name": "Retrieve recent benchmark history for a prompt",
    "serves": [
      "UC3"
    ],
    "collections": [
      "benchmark_runs"
    ],
    "query": {
      "collection": "benchmark_runs",
      "operation": "find",
      "filter": {
        "tenant_id": "<tenantId>",
        "ground_truth_id": "<groundTruthId>"
      },
      "projection": {
        "system_under_test": 1,
        "retrieval_mode": 1,
        "chunking_strategy": 1,
        "embedding_model": 1,
        "metrics": 1,
        "top_k_results": 1,
        "run_label": 1,
        "run_timestamp": 1,
        "notes": 1
      },
      "sort": {
        "run_timestamp": -1
      },
      "limit": 20
    },
    "purpose": "Review repeated executions of the same benchmark prompt over time during the demo."
  }
}
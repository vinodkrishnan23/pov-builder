          "why": "Metrics are computed per result set and always read together with it."
        }
      ],
      "references": [
        {
          "field": "benchmark_run_id",
          "collection": "benchmark_runs",
          "why": "Results may belong to a formal benchmark run."
        },
        {
          "field": "query_id",
          "collection": "queries",
          "why": "Each result set answers one query."
        },
        {
          "field": "tenant_id",
          "collection": "tenants",
          "why": "Tenant scoping for filtering and analysis."
        },
        {
          "field": "chunk_profile_id",
          "collection": "chunk_profiles",
          "why": "Enables comparison across chunking strategies in the benchmark harness."
        }
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to": "queries",
          "via": "query_id"
        },
        {
          "type": "many-to-one",
          "to": "benchmark_runs",
          "via": "benchmark_run_id"
        },
        {
          "type": "many-to-one",
          "to": "chunk_profiles",
          "via": "chunk_profile_id"
        }
      ],
      "indexing": [
        {
          "name": "idx_results_run_query_approach_profile",
          "kind": "regular",
          "fields": [
            "benchmark_run_id",
            "query_id",
            "approach",
            "chunk_profile_id"
          ],
          "reason": "Supports side-by-side comparison of a query across systems and chunking strategies."
        },
        {
          "name": "idx_results_tenant_approach_created",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "approach",
            "created_at"
          ],
          "reason": "Supports tenant-scoped analysis of recent benchmark executions by compared approach."
        }
      ]
    }
  ],
  "design_notes": {
    "embedding_vs_reference_rationale": [
      {
        "collection": "documents",
        "decision": "Keep documents separate from chunks.",
        "why": "Chunk volume is high and retrieval operates at chunk granularity; embedding chunks inside documents would create very large document growth and inefficient vector index maintenance."
      },
      {
        "collection": "chunks",
        "decision": "Store embedding vector directly on chunk.",
        "why": "Embedding is only meaningful in context of the chunk retrieval unit and is queried together with chunk text/metadata for vector search."
      },
      {
        "collection": "query_results",
        "decision": "Embed top-k results and metrics.",
        "why": "Top-k result sets are small and always consumed together for benchmark inspection and scoring."
      },
      {
        "collection": "benchmark_runs",
        "decision": "Embed comparison_targets.",
        "why": "Short per-run configuration list; no independent lifecycle requiring a separate collection."
      }
    ],
    "scope_notes": [
      "Raw file binaries are not modeled in MongoDB because current-state integration explicitly mentions S3/raw object storage; model stores source_uri and extracted text instead.",
      "No separate application-session or conversation database collection is introduced because AI-8 was explicitly removed as a requirement.",
      "Access metadata is kept optional and lightweight on documents to reflect current-state tagging context without inventing a full authorization subsystem.",
      "Chunk profile support is included because the POV explicitly needs side-by-side demonstration of chunking options, but it is treated as benchmark/demo configuration rather than a generalized product platform requirement."
    ]
  }
}
{
  "collections": [
    {
      "name": "tenants",
      "description": "Customer-isolated SaaS deployments or evaluation tenants used to scope uploaded documents, retrieval data, and benchmark runs.",
      "traceability": [
        "business_entities: Tenants/customer deployments",
        "UC1",
        "UC2",
        "FR3"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_key",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "deployment_mode",
          "type": "string",
          "required": false,
          "enum": [
            "shared_saas",
            "isolated_customer_deployment",
            "pov_workshop"
          ]
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        }
      ],
      "relationships": [
        {
          "to": "documents",
          "type": "one-to-many",
          "via": "tenant_id"
        },
        {
          "to": "agent_memory_entries",
          "type": "one-to-many",
          "via": "tenant_id"
        },
        {
          "to": "benchmark_runs",
          "type": "one-to-many",
          "via": "tenant_id"
        }
      ],
      "embedding_strategy": "Standalone collection referenced by high-volume collections to enforce tenant isolation and support tenant-scoped filtering across document search and agent memory use cases."
    },
    {
      "name": "documents",
      "description": "Uploaded source documents and associated metadata for the primary POV use case of document search over customer-provided unstructured content.",
      "traceability": [
        "business_entities: Uploaded documents",
        "UC1",
        "FR1",
        "FR2",
        "FR3",
        "AI2",
        "SC1"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "document_type",
          "type": "string",
          "required": true,
          "enum": [
            "pdf",
            "csv",
            "google_sheet_export",
            "text",
            "business_document",
            "research_paper",
            "chat_thread_export",
            "other"
          ]
        },
        {
          "name": "title",
          "type": "string",
          "required": false
        },
        {
          "name": "source_filename",
          "type": "string",
          "required": false
        },
        {
          "name": "mime_type",
          "type": "string",
          "required": false
        },
        {
          "name": "source_uri",
          "type": "string",
          "required": false
        },
        {
          "name": "source_system",
          "type": "string",
          "required": false,
          "enum": [
            "uploaded_in_session",
            "s3",
            "other"
          ]
        },
        {
          "name": "upload_session_label",
          "type": "string",
          "required": false
        },
        {
          "name": "metadata",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "author",
              "type": "string",
              "required": false
            },
            {
              "name": "created_date",
              "type": "date",
              "required": false
            },
            {
              "name": "language",
              "type": "string",
              "required": false
            },
            {
              "name": "tags",
              "type": "array<string>",
              "required": false
            },
            {
              "name": "structured_attributes",
              "type": "document",
              "required": false
            }
          ],
          "description": "Flexible source metadata and optional structured attributes to support later structured-plus-unstructured exploration without making it equal-weight to the main POV."
        },
        {
          "name": "ingest_status",
          "type": "string",
          "required": true,
          "enum": [
            "uploaded",
            "parsed",
            "chunked",
            "embedded",
            "failed"
          ]
        },
        {
          "name": "ingest_errors",
          "type": "array<document>",
          "required": false,
          "fields": [
            {
              "name": "stage",
              "type": "string",
              "required": true
            },
            {
              "name": "message",
              "type": "string",
              "required": true
            },
            {
              "name": "timestamp",
              "type": "date",
              "required": true
            }
          ]
        },
        {
          "name": "chunking_runs",
          "type": "array<document>",
          "required": false,
          "fields": [
            {
              "name": "chunking_strategy",
              "type": "string",
              "required": true,
              "enum": [
                "fixed_length",
                "recursive",
                "semantic",
                "contextual"
              ]
            },
            {
              "name": "chunk_count",
              "type": "int",
              "required": true
            },
            {
              "name": "parser_name",
              "type": "string",
              "required": false
            },
            {
              "name": "embedding_model",
              "type": "string",
              "required": false
            },
            {
              "name": "run_timestamp",
              "type": "date",
              "required": true
            }
          ],
          "description": "Embedded summary of chunking attempts for traceability and workshop discussion. Full chunk content remains in a separate collection because of volume."
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        },
        {
          "name": "updated_at",
          "type": "date",
          "required": true
        }
      ],
      "relationships": [
        {
          "to": "tenants",
          "type": "many-to-one",
          "via": "tenant_id"
        },
        {
          "to": "document_chunks",
          "type": "one-to-many",
          "via": "document_id"
        },
        {
          "to": "benchmark_results",
          "type": "one-to-many",
          "via": "retrieved_document_id",
          "optional": true
        }
      ],
      "embedding_strategy": "Store document-level metadata in its own collection; chunk content and vectors are referenced in a separate collection because documents can produce many chunks and need independent vector indexing/search."
    },
    {
      "name": "document_chunks",

        {
          "name": "page_end",
          "type": "int",
          "required": false
        },
        {
          "name": "section_title",
          "type": "string",
          "required": false
        },
        {
          "name": "embedding_model",
          "type": "string",
          "required": true
        },
        {
          "name": "embedding",
          "type": "array<float>",
          "required": true
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        }
      ],
      "relationships": [
        {
          "to": "documents",
          "type": "many-to-one",
          "via": "document_id"
        },
        {
          "to": "tenants",
          "type": "many-to-one",
          "via": "tenant_id"
        },
        {
          "to": "benchmark_results",
          "type": "one-to-many",
          "via": "retrieved_chunk_id",
          "optional": true
        }
      ],
      "embedding_strategy": "Separate collection is required because chunk records are the retrieval unit, have high cardinality, and need Atlas Vector Search indexing. Keeping them separate avoids document growth and supports multiple chunking strategies per source document."
    },
    {
      "name": "agent_memory_entries",

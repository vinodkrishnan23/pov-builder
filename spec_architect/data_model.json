          "required": false
        },
        {
          "name": "embedding_dimensions",
          "type": "int",
          "required": false
        },
        {
          "name": "metadata",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "contains_table_text",
              "type": "bool",
              "required": false
            },
            {
              "name": "source_offsets",
              "type": "document",
              "required": false
            }
          ]
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        }
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to": "documents",
          "via": "document_id"
        },
        {
          "type": "many-to-one",
          "to": "tenants",
          "via": "tenant_id"
        }
      ],
      "embedding_vs_reference": {
        "strategy": "embedding stored in the chunk document",
        "why": "Primary retrieval unit is the chunk. Co-locating text, metadata, and vector minimizes fetches for top-K retrieval and reranking candidates in the POV."
      },
      "indexes": [
        {
          "name": "idx_chunks_doc_strategy_index",
          "kind": "regular",
          "fields": [
            "document_id",
            "chunking_strategy",
            "chunk_index"
          ],
          "reason": "Supports reconstruction/debugging of a document under a selected chunking strategy and deterministic playback during benchmark review."
        },
        {
          "name": "idx_chunks_tenant_strategy",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "chunking_strategy"
          ],
          "reason": "Supports benchmarking and filtering retrieval to a specific chunking method for side-by-side comparisons."
        },
        {
          "name": "search_chunks_text",
          "kind": "search",
          "fields": [
            "text",
            "contextual_text",
            "section_path"
          ],
          "reason": "Supports lexical retrieval baseline, hybrid retrieval, and keyword querying directly over chunk text."
        },
        {
          "name": "vector_chunks_embedding",
          "kind": "vector",
          "fields": [
            "embedding"
          ],
          "reason": "Supports semantic top-K retrieval over chunk embeddings for document search and agent memory queries."
        }
      ]
    },
    {
      "name": "ground_truth_sets",
      "description": "Benchmark question sets and expected relevant documents/chunks used to evaluate retrieval accuracy, latency, and top-K performance.",
      "traceability": [
        "business_entities:Ground truth set",
        "use_cases:UC3",
        "success_criteria:SC5",
        "success_criteria:SC6",
        "success_criteria:SC7",
        "success_criteria:SC8"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",

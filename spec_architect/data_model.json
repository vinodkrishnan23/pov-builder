{
  "collections": [
    {
      "name": "tenants",
      "description": "Represents customer tenant/account scope for uploaded documents, agent memory, and benchmark runs. Included because tenant scoping is explicitly discussed for SaaS/customer isolation context and inferred access tagging is important for agent memory retrieval.",
      "traceability": [
        "business_entities:Tenant",
        "FR8",
        "FR9",
        "UC1",
        "UC2",
        "UC3"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_key",
          "type": "string",
          "required": true
        },
        {
          "name": "display_name",
          "type": "string",
          "required": true
        },
        {
          "name": "deployment_model",
          "type": "string",
          "required": false,
          "enum": [
            "multi_tenant",
            "isolated_per_tenant"
          ]
        },
        {
          "name": "cloud",
          "type": "string",
          "required": false,
          "enum": [
            "aws",
            "gcp",
            "azure",
            "other"
          ]
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        }
      ],
      "relationships": [
        {
          "to_collection": "documents",
          "type": "one-to-many",
          "via": "documents.tenant_id"
        },
        {
          "to_collection": "benchmark_runs",
          "type": "one-to-many",
          "via": "benchmark_runs.tenant_id"
        }
      ],
      "embedding_vs_reference": {
        "strategy": "reference_from_other_collections",
        "reason": "Tenant is shared by many documents, sessions, and benchmark runs; referencing avoids duplication and supports tenant-scoped filtering."
      },
      "indexes": [
        {
          "name": "uk_tenant_key",
          "kind": "regular",
          "fields": [
            "tenant_key"
          ],
          "reason": "Fast tenant lookup and uniqueness for tenant-scoped ingestion/retrieval flows."
        }
      ]
    },
    {
      "name": "documents",
      "description": "Canonical document record for both uploaded unstructured documents and conversation-derived agent memory documents. Holds metadata, source information, extracted text summary, and optional structured attributes used for hybrid retrieval/filtering.",
      "traceability": [
        "business_entities:Unstructured Document",
        "business_entities:Agent Memory Document",
        "UC1",
        "UC2",
        "FR1",
        "FR2",
        "FR6",
        "FR10",
        "AI1",
        "AI4",
        "AI5"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "document_type",
          "type": "string",
          "required": true,
          "enum": [
            "unstructured_document",
            "agent_memory_document"
          ]
        },
        {
          "name": "source_type",
          "type": "string",
          "required": true,
          "enum": [
            "pdf",
            "csv",
            "google_sheet",
            "json",
            "text",
            "research_paper",
            "business_document",
            "jira_export",
            "slack_export",
            "conversation",
            "other"
          ]
        },
        {
          "name": "title",
          "type": "string",
          "required": false
        },
        {
          "name": "source_uri",
          "type": "string",
          "required": false
        },
        {
          "name": "mime_type",
          "type": "string",
          "required": false
        },
        {
          "name": "uploaded_by_user_id",
          "type": "string",
          "required": false
        },
        {
          "name": "access_tags",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "tenant_key",
              "type": "string",
              "required": false
            },
            {
              "name": "user_ids",
              "type": "array<string>",
              "required": false
            },
            {
              "name": "groups",
              "type": "array<string>",
              "required": false
            }
          ],
          "reason": "Access tags are embedded because they are tightly bound to the document and used as retrieval filters, especially for agent memory scenarios."
        },
        {
          "name": "structured_metadata",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "author",
              "type": "string",
              "required": false
            },
            {
              "name": "created_source_at",
              "type": "date",
              "required": false
            },
            {
              "name": "labels",
              "type": "array<string>",
              "required": false
            },
            {
              "name": "business_attributes",
              "type": "object",
              "required": false
            }
          ],
          "reason": "Flexible structured metadata supports the explicit need to combine structured and unstructured data in retrieval."
        },
        {
          "name": "conversation_metadata",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "session_id",
              "type": "string",
              "required": false
            },
            {
              "name": "message_count",
              "type": "int",
              "required": false
            },
            {
              "name": "participants",
              "type": "array<string>",
              "required": false
            }
          ],
          "reason": "Only relevant for agent memory documents; embedded because it is document-local."
        },
        {
          "name": "raw_text",
          "type": "string",
          "required": false
        },
        {
          "name": "ingestion_status",
          "type": "string",
          "required": true,
          "enum": [
            "uploaded",
            "text_extracted",
            "chunked",
            "embedded",
            "ready",
            "failed"
          ]
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        },
        {
          "name": "updated_at",
          "type": "date",
          "required": true
        }
      ],
      "relationships": [
        {
          "to_collection": "tenants",
          "type": "many-to-one",
          "via": "documents.tenant_id"
        },
        {
          "to_collection": "document_chunks",
          "type": "one-to-many",
          "via": "document_chunks.document_id"
        },
        {
          "to_collection": "benchmark_queries",
          "type": "many-to-many_logical",
          "via": "benchmark_relevance_judgments.document_id"
        }
      ],
      "embedding_vs_reference": {
        "strategy": "embed_small_metadata_reference_large_children",
        "reason": "Document metadata and access tags are embedded because they are fetched together with the document. Chunks are referenced because each document can have many chunks and multiple chunking strategies, which would make embedding them inside the document too large and hard to index independently."
      },
      "indexes": [
        {
          "name": "idx_documents_tenant_type_status",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "document_type",
            "ingestion_status"
          ],
          "reason": "Supports listing ready documents per tenant and filtering by document vs agent memory during evaluation/demo workflows."
        },
        {
          "name": "idx_documents_tenant_user",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "uploaded_by_user_id"
          ],
          "reason": "Supports retrieval and filtering of user-scoped uploaded content or memory artifacts in demos."
        },
        {
          "name": "idx_documents_access_tags_users",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "access_tags.user_ids"
          ],
          "reason": "Supports tenant+user filtered access patterns for agent memory retrieval."
        },
        {
          "name": "idx_documents_created_at",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "created_at"
          ],
          "reason": "Supports recency-sorted document and memory views for playground/demo usage."
        }
      ]
    },
    {
      "name": "document_chunks",
      "description": "Stores chunked text derived from documents, including multiple chunking strategies and the vector embedding used for semantic retrieval. This is the core retrieval collection for vector search and reranking pipelines.",
      "traceability": [
        "business_entities:Chunk",
        "business_entities:Embedding",
        "UC1",
        "UC2",
        "UC3",
        "FR4",
        "FR5",
        "FR10",
        "FR11",
        "AI2",
        "AI3",
        "AI7",
        "SC4",
        "SC5",
        "SC10"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "document_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "document_type",
          "type": "string",
          "required": true,
          "enum": [
            "unstructured_document",
            "agent_memory_document"
          ]
        },
        {
          "name": "chunking_strategy",
          "type": "string",
          "required": true,
          "enum": [
            "fixed_length",
            "recursive",
            "semantic",
            "contextual"
          ]
        },
        {
          "name": "chunk_index",
          "type": "int",
          "required": true
        },
        {
          "name": "text",
          "type": "string",
          "required": true
        },
        {
          "name": "token_count",
          "type": "int",
          "required": false
        },
        {
          "name": "embedding",
          "type": "array<float>",
          "required": true
        },
        {
          "name": "embedding_model",
          "type": "string",
          "required": true
        },
        {
          "name": "start_offset",
          "type": "int",
          "required": false
        },
        {
          "name": "end_offset",
          "type": "int",
          "required": false
        },
        {
          "name": "metadata",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "title",
              "type": "string",
              "required": false
            },
            {
              "name": "source_type",
              "type": "string",
              "required": false
            },
            {
              "name": "access_tags",
              "type": "object",
              "required": false
            },
            {
              "name": "structured_metadata",
              "type": "object",
              "required": false
            }
          ],
          "reason": "Selective denormalized metadata is embedded to avoid a join during vector retrieval filtering and result presentation."
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        }
      ],
      "relationships": [
        {
          "to_collection": "documents",
          "type": "many-to-one",
          "via": "document_chunks.document_id"
        },
        {
          "to_collection": "tenants",
          "type": "many-to-one",
          "via": "document_chunks.tenant_id"
        },
        {
          "to_collection": "benchmark_relevance_judgments",
          "type": "many-to-many_logical",
          "via": "benchmark_relevance_judgments.chunk_id"
        }
      ],
      "embedding_vs_reference": {
        "strategy": "reference_parent_embed_retrieval_metadata",
        "reason": "Chunks reference the parent document because documents have many chunks and multiple chunking variants. Retrieval-critical metadata is duplicated in the chunk so vector search can filter by tenant, user access, source type, or structured fields without requiring post-lookup for every candidate."
      },
      "indexes": [
        {
          "name": "idx_chunks_doc_strategy_index",
          "kind": "regular",
          "fields": [
            "document_id",
            "chunking_strategy",
            "chunk_index"
          ],
          "reason": "Supports reconstructing document context and browsing chunk variants per document/chunking strategy."
        },
        {
          "name": "idx_chunks_tenant_docType_strategy",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "document_type",
            "chunking_strategy"
          ],
          "reason": "Supports tenant-scoped retrieval experiments and side-by-side chunking strategy comparisons."
        },
        {
          "name": "search_chunks_text",
          "kind": "search",
          "fields": [
            "text",
            "metadata.title"
          ],
          "reason": "Supports lexical/full-text retrieval and hybrid search evaluation for unstructured document search use cases."
        },
        {
          "name": "vector_chunks_embedding",
          "kind": "vector",
          "fields": [
            "embedding"
          ],
          "reason": "Supports embedding-based retrieval over chunk vectors, the main AI retrieval pattern for document search and agent memory."
        }
      ]
    },
    {
      "name": "benchmark_queries",
      "description": "Benchmark/evaluation prompts or questions used to test retrieval quality and speed against uploaded corpora and agent memory. Added because benchmark-driven evaluation, ground-truth style queries, and side-by-side comparisons are central to the POV.",
      "traceability": [
        "UC3",
        "BO5",
        "SC1",
        "SC5",
        "SC6",
        "SC7",
        "ISSUE-7"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",
          "type": "objectId",
          "required": false
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "query_text",
          "type": "string",
          "required": true
        },
        {
          "name": "query_type",
          "type": "string",
          "required": true,
          "enum": [
            "document_search",
            "agent_memory",
            "hybrid_structured_unstructured"
          ]
        },
        {
          "name": "target_document_type",
          "type": "string",
          "required": false,
          "enum": [
            "unstructured_document",
            "agent_memory_document"
          ]
        },
        {
          "name": "filters",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "source_types",
              "type": "array<string>",
              "required": false
            },
            {
              "name": "user_id",
              "type": "string",
              "required": false
            },
            {
              "name": "chunking_strategy",
              "type": "string",
              "required": false
            }
          ],
          "reason": "Optional benchmark filters model realistic evaluation scenarios such as user-scoped memory or source-specific search."
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        }
      ],
      "relationships": [
        {
          "to_collection": "benchmark_relevance_judgments",
          "type": "one-to-many",
          "via": "benchmark_relevance_judgments.query_id"
        },
        {
          "to_collection": "benchmark_runs",
          "type": "one-to-many",
          "via": "benchmark_runs.query_set.query_ids"
        }
      ],
      "embedding_vs_reference": {
        "strategy": "standalone",
        "reason": "Queries are reusable across runs, systems, chunking strategies, and corpora; storing independently supports repeated evaluations."
      },
      "indexes": [
        {
          "name": "idx_benchmark_queries_tenant_type",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "query_type"
          ],
          "reason": "Supports organizing and selecting benchmark query sets by tenant and scenario."
        }
      ]
    },
    {
      "name": "benchmark_relevance_judgments",
      "description": "Ground-truth mappings from benchmark queries to relevant documents or chunks, enabling precision/recall calculations at top-K.",
      "traceability": [
        "UC3",
        "SC5",
        "SC6",
        "SC7",
        "ISSUE-7"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "query_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "document_id",
          "type": "objectId",
          "required": false
        },
        {
          "name": "chunk_id",
          "type": "objectId",
          "required": false
        },
        {
          "name": "relevance_grade",
          "type": "int",
          "required": true
        },
        {
          "name": "notes",
          "type": "string",
          "required": false
        }
      ],
      "relationships": [
        {
          "to_collection": "benchmark_queries",
          "type": "many-to-one",
          "via": "benchmark_relevance_judgments.query_id"
        },
        {
          "to_collection": "documents",
          "type": "many-to-one",
          "via": "benchmark_relevance_judgments.document_id"
        },
        {
          "to_collection": "document_chunks",
          "type": "many-to-one",
          "via": "benchmark_relevance_judgments.chunk_id"
        }
      ],
      "embedding_vs_reference": {
        "strategy": "reference",
        "reason": "Judgments connect reusable benchmark queries to target documents/chunks and should not be embedded inside either side because they are evaluation artifacts that can evolve independently."
      },
      "indexes": [
        {
          "name": "idx_relevance_query",
          "kind": "regular",
          "fields": [
            "query_id"
          ],
          "reason": "Supports loading all ground-truth judgments for a benchmark query during metric computation."
        },
        {
          "name": "idx_relevance_query_chunk",
          "kind": "regular",
          "fields": [
            "query_id",
            "chunk_id"
          ],
          "reason": "Supports chunk-level relevance lookups when evaluating retrieval results."
        }
      ]
    },
    {

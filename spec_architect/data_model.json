              "required": false
            }
          ]
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        }
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to": "tenants",
          "via": "tenant_id"
        },
        {
          "type": "one-to-many",
          "to": "benchmark_runs",
          "via": "benchmark_runs.ground_truth_set_id"
        }
      ],
      "embedding_vs_reference": {
        "strategy": "embed benchmark questions inside the set document",
        "why": "Questions are always consumed together as a named benchmark pack during a run; embedding avoids an extra collection for small-to-moderate benchmark sets in the POV."
      },
      "indexes": [
        {
          "name": "idx_ground_truth_tenant_name",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "name"
          ],
          "reason": "Supports selecting a benchmark pack for a tenant/workshop."
        }
      ]
    },

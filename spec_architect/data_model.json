      ],
      "embedding_strategy": "Result rows are standalone because they are append/read by run and query, while top-K hits are embedded as bounded arrays.",
      "relationships": [
        {
          "to_collection": "benchmark_runs",
          "type": "many-to-one",
          "via": "run_id"
        },
        {
          "to_collection": "benchmark_queries",
          "type": "many-to-one",
          "via": "benchmark_query_id"
        },
        {
          "to_collection": "tenants",
          "type": "many-to-one",
          "via": "tenant_id"
        }
      ]
    }
  ]
}
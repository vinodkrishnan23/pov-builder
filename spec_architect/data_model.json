      ],
      "embedding_vs_references": {
        "approach": "Standalone optional collection referencing requests/policies when applicable.",
        "why": "Exploratory AI requirement is not core to near-term scope, so derived insights should not pollute primary execution-log write paths. Separate storage preserves extensibility without forcing a vector or AI-first schema now."
      },
      "relationships": [
        {
          "to_collection": "execution_requests",
          "type": "many-to-one",
          "via": "execution_insights.request_id -> execution_requests.request_id (optional)"
        },
        {
          "to_collection": "policies",
          "type": "many-to-one",
          "via": "execution_insights.policy_id -> policies.policy_id (optional)"
        },
        {
          "to_collection": "policy_versions",
          "type": "many-to-one",

          "description": "Arbitrary nested JSON for the rule/step output/result context."
        },
        {
          "name": "intermediate_values",
          "type": "object",
          "required": false,
          "description": "JSON object capturing value after stage N, variable states, and similar internal details."
        },
        {
          "name": "searched_attributes_flat",
          "type": "array<object>",
          "required": false,
          "description": "Optional normalized projection of variable/value pairs for targeted filtering independent of raw nested JSON shape.",
          "fields": [
            {
              "name": "path",
              "type": "string",
              "required": true
            },
            {
              "name": "value_string",
              "type": "string",
              "required": false
            },
            {
              "name": "value_number",
              "type": "double",
              "required": false
            },
            {
              "name": "value_bool",

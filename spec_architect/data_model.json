        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        }
      ],
      "embedding_vs_references": {
        "approach": "Referenced to execution_requests by request_id; individual step documents not embedded.",
        "why": "This collection is the write-heavy append stream for asynchronous Kafka-style ingestion. Separate documents optimize concurrent inserts, request drill-down, and rule/value search across many steps without rewriting parent request documents."
      },
      "relationships": [
        {
          "to_collection": "execution_requests",
          "type": "many-to-one",
          "via": "execution_rule_steps.request_id -> execution_requests.request_id"
        }
      ]
    },
    {

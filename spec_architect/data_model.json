{
  "collections": [
    {
      "name": "tenants",
      "description": "Tenant/deployment scope for isolating benchmark data and future secondary use cases. Included because the spec references customer-specific SaaS deployments and tenant deployment as a business entity, and benchmark/demo data should be scoped accordingly.",
      "traceability": [
        "business_entities:Tenant deployment",
        "UC1",
        "UC2",
        "FR7"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "deployment_model",
          "type": "string",
          "required": true,
          "enum": [
            "shared_pov",
            "isolated_saas_deployment"
          ]
        },
        {
          "name": "cloud_provider",
          "type": "string",
          "required": false,
          "enum": [
            "aws",
            "gcp",
            "azure",
            "other"
          ]
        },
        {
          "name": "environment_label",
          "type": "string",
          "required": false
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        }
      ],
      "embedding_strategy": "N/A",
      "relationships": [
        {
          "type": "one-to-many",
          "to": "documents",
          "via": "tenant_id"
        },
        {
          "type": "one-to-many",
          "to": "benchmark_runs",
          "via": "tenant_id"
        },
        {
          "type": "one-to-many",
          "to": "agent_memory_entries",
          "via": "tenant_id"
        }
      ],
      "embedded_vs_references": {
        "decision": "top-level collection",
        "why": "Tenants are a stable scoping entity reused across many documents, benchmark runs, and optional agent-memory records; referencing avoids duplication and supports isolation filters."
      },
      "indexes": [
        {
          "name": "tenant_name_unique",
          "kind": "regular",
          "fields": [
            "name"
          ],
          "reason": "Supports lookup/admin selection of a tenant or demo environment by name."
        }
      ]
    },

        },
        {
          "name": "metrics",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "precision_at_k",
              "type": "document",
              "required": false
            },
            {
              "name": "recall_at_k",
              "type": "document",
              "required": false
            },
            {
              "name": "mrr",

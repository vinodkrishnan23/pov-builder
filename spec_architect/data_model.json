{
  "collections": [
    {
      "name": "tenants",
      "description": "Tenant boundary for isolated customer/demo contexts in the POV.",
      "traceability": {
        "business_entities": [
          "Tenant"
        ],
        "functional_requirements": [],
        "use_cases": [
          "UC1",
          "UC2",
          "UC3"
        ]
      },
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_key",
          "type": "string",
          "required": true
        },
        {
          "name": "display_name",
          "type": "string",
          "required": true
        },
        {
          "name": "deployment_model",
          "type": "string",
          "required": false,
          "enum": [
            "saas_shared",
            "saas_isolated",
            "customer_isolated"
          ]
        },
        {
          "name": "cloud",
          "type": "string",
          "required": false,
          "enum": [
            "aws",
            "gcp",
            "azure",
            "other"
          ]
        },
        {
          "name": "notes",
          "type": "string",
          "required": false
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        }
      ],
      "relationships": [
        {
          "type": "one_to_many",
          "to_collection": "documents",
          "via": "tenant_id"
        },
        {
          "type": "one_to_many",
          "to_collection": "benchmark_runs",
          "via": "tenant_id"
        }
      ],
      "embedding_vs_reference": "Top-level reference target. Tenant is shared by many documents and benchmark runs, so referencing avoids duplication and supports tenant-scoped queries.",
      "indexes": [
        {
          "name": "uk_tenants_tenant_key",
          "kind": "regular",
          "fields": [
            "tenant_key"
          ],
          "reason": "Lookup and enforce uniqueness for tenant/demo environment selection."
        }
      ]
    },
    {
      "name": "documents",
      "description": "Canonical metadata for uploaded or ingested content used in document search and agent memory retrieval.",
      "traceability": {
        "business_entities": [
          "Document",
          "Agent Memory"
        ],
        "functional_requirements": [
          "FR1",
          "FR2",
          "FR3",
          "FR4"
        ],
        "use_cases": [
          "UC1",
          "UC2",
          "UC3"
        ]
      },
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "document_type",
          "type": "string",
          "required": true,
          "enum": [
            "uploaded_file",
            "agent_memory",
            "benchmark_supporting_doc"
          ]
        },
        {
          "name": "source_type",
          "type": "string",
          "required": true,
          "enum": [
            "pdf",
            "csv",
            "google_sheet",
            "text",
            "research_paper",
            "business_document",
            "jira_export",
            "slack_export",
            "conversation_context",
            "other"
          ]
        },
        {
          "name": "title",
          "type": "string",
          "required": false
        },
        {
          "name": "original_filename",
          "type": "string",
          "required": false
        },
        {
          "name": "mime_type",
          "type": "string",
          "required": false
        },
        {
          "name": "source_uri",
          "type": "string",
          "required": false
        },
        {
          "name": "storage_location_type",
          "type": "string",
          "required": false,
          "enum": [
            "atlas",
            "s3",
            "external_url",
            "inline"
          ]
        },
        {
          "name": "raw_text",
          "type": "string",
          "required": false
        },
        {
          "name": "metadata",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "author",
              "type": "string",
              "required": false
            },
            {
              "name": "language",
              "type": "string",
              "required": false
            },
            {
              "name": "tags",
              "type": "array<string>",
              "required": false
            },
            {
              "name": "created_by",
              "type": "string",
              "required": false
            },
            {
              "name": "conversation_id",
              "type": "string",
              "required": false
            },
            {
              "name": "session_id",
              "type": "string",
              "required": false
            }
          ],
          "reason": "Flexible metadata is needed because customer documents vary widely and agent memory may carry conversation/session identifiers."
        },
        {
          "name": "processing_status",
          "type": "string",
          "required": true,
          "enum": [
            "uploaded",
            "parsed",
            "chunked",
            "embedded",
            "failed"
          ]
        },
        {
          "name": "ingested_at",
          "type": "date",
          "required": true
        },
        {
          "name": "updated_at",
          "type": "date",
          "required": true
        }
      ],
      "relationships": [
        {
          "type": "many_to_one",
          "to_collection": "tenants",
          "via": "tenant_id"
        },
        {
          "type": "one_to_many",
          "to_collection": "document_chunks",
          "via": "document_id"
        },
        {
          "type": "one_to_many",
          "to_collection": "benchmark_ground_truths",
          "via": "relevant_document_ids"
        }
      ],
      "embedding_vs_reference": "Documents reference tenant_id because tenant metadata is shared. Chunk text and embeddings are not embedded in documents because multiple chunking strategies per document are required and chunk counts can be large.",
      "indexes": [
        {
          "name": "idx_documents_tenant_type_ingested",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "document_type",
            "ingested_at"
          ],
          "reason": "Supports listing recently uploaded documents and filtering document-search vs agent-memory documents during the live demo."
        },
        {
          "name": "idx_documents_tenant_source_type",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "source_type"
          ],
          "reason": "Supports evaluation by file/source type such as PDF, CSV, Slack/Jira text exports."
        }
      ]
    },
    {
      "name": "document_chunks",
      "description": "Chunked text derived from documents, stored per chunking strategy and used for lexical and vector retrieval.",
      "traceability": {
        "business_entities": [
          "Chunk",
          "Embedding"
        ],
        "functional_requirements": [
          "FR1",
          "FR2",
          "FR3",
          "FR6",
          "FR7"
        ],
        "ai_requirements": [
          "AI2",
          "AI3",
          "AI4",
          "AI5"
        ],
        "use_cases": [
          "UC1",
          "UC2",
          "UC3"
        ]
      },
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "document_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "chunking_strategy",
          "type": "string",
          "required": true,
          "enum": [
            "fixed_length",
            "recursive",
            "semantic",
            "contextual"
          ]
        },
        {
          "name": "strategy_params",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "chunk_size",
              "type": "int",
              "required": false
            },
            {
              "name": "chunk_overlap",
              "type": "int",
              "required": false
            },
            {
              "name": "separator_policy",
              "type": "string",
              "required": false
            },
            {
              "name": "notes",
              "type": "string",
              "required": false
            }
          ],
          "reason": "Needed to compare chunking configurations, not just strategy names."
        },
        {
          "name": "chunk_index",
          "type": "int",
          "required": true
        },
        {
          "name": "text",
          "type": "string",
          "required": true
        },
        {
          "name": "token_count",
          "type": "int",
          "required": false
        },
        {
          "name": "embedding_model",
          "type": "string",
          "required": false
        },
        {
          "name": "embedding",
          "type": "array<float>",
          "required": false
        },
        {
          "name": "page_span",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "start_page",
              "type": "int",
              "required": false
            },
            {
              "name": "end_page",
              "type": "int",
              "required": false
            }
          ]
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        }
      ],
      "relationships": [
        {
          "type": "many_to_one",
          "to_collection": "documents",
          "via": "document_id"
        },
        {
          "type": "many_to_one",
          "to_collection": "tenants",
          "via": "tenant_id"
        }
      ],
      "embedding_vs_reference": "Chunks reference the parent document because each document can produce many chunks under multiple strategies. Embedding is stored on the chunk because retrieval is chunk-level and embedding travels with the chunk for vector search.",
      "indexes": [
        {
          "name": "idx_chunks_doc_strategy_order",
          "kind": "regular",
          "fields": [
            "document_id",
            "chunking_strategy",
            "chunk_index"
          ],
          "reason": "Supports reconstructing chunk sequences for a document and comparing chunk outputs by strategy."
        },
        {
          "name": "idx_chunks_tenant_strategy",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "chunking_strategy"
          ],
          "reason": "Supports running strategy-specific benchmark queries scoped to a tenant/demo dataset."
        },
        {
          "name": "search_chunks_text",
          "kind": "search",
          "fields": [
            "text"
          ],
          "reason": "Supports keyword/hybrid retrieval over chunk text for document search and side-by-side comparison against non-vector baselines."
        },
        {
          "name": "vector_chunks_embedding",
          "kind": "vector",
          "fields": [
            "embedding"
          ],
          "reason": "Supports semantic retrieval over chunks for document search and agent memory evaluation using embeddings."
        }
      ]
    },
    {
      "name": "benchmark_ground_truths",
      "description": "Customer-provided prompts/questions and expected relevant answers or documents used to score retrieval quality.",
      "traceability": {
        "business_entities": [
          "Document"
        ],
        "functional_requirements": [
          "FR4",
          "FR7"
        ],
        "ai_requirements": [
          "AI6"
        ],
        "use_cases": [
          "UC3"
        ]
      },
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "prompt_text",
          "type": "string",
          "required": true
        },
        {
          "name": "task_type",
          "type": "string",
          "required": true,
          "enum": [
            "document_search",
            "agent_memory"
          ]
        },
        {
          "name": "ground_truth_text",
          "type": "string",
          "required": false
        },
        {
          "name": "relevant_document_ids",
          "type": "array<objectId>",
          "required": false
        },
        {
          "name": "relevant_chunk_ids",
          "type": "array<objectId>",
          "required": false
        },
        {
          "name": "top_k_targets",
          "type": "array<int>",
          "required": false
        },
        {
          "name": "provided_during_session",
          "type": "bool",
          "required": true
        },
        {
          "name": "notes",
          "type": "string",
          "required": false
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        }
      ],
      "relationships": [
        {
          "type": "many_to_one",
          "to_collection": "tenants",
          "via": "tenant_id"
        },
        {
          "type": "many_to_many",
          "to_collection": "documents",
          "via": "relevant_document_ids"
        },
        {
          "type": "many_to_many",
          "to_collection": "document_chunks",
          "via": "relevant_chunk_ids"
        },
        {
          "type": "one_to_many",
          "to_collection": "benchmark_runs",
          "via": "ground_truth_id"
        }
      ],
      "embedding_vs_reference": "Ground truths reference documents/chunks because the same benchmark prompt may be evaluated across multiple runs and strategies; embedding them would duplicate benchmark targets.",
      "indexes": [
        {
          "name": "idx_ground_truths_tenant_task",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "task_type"
          ],
          "reason": "Supports selecting benchmark prompt sets by tenant and use case during the session."
        }
      ]
    },
    {
      "name": "benchmark_runs",
      "description": "Recorded execution of a retrieval benchmark against a selected strategy and baseline, including measured latency and quality metrics.",
      "traceability": {
        "business_entities": [
          "Chunk",
          "Embedding"
        ],
        "functional_requirements": [
          "FR4",
          "FR6",
          "FR7"
        ],
        "use_cases": [
          "UC3"
        ],
        "success_criteria": [
          "SC1",
          "SC2",
          "SC3",
          "SC4",
          "SC5",
          "SC6"
        ]
      },
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "ground_truth_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "run_label",
          "type": "string",
          "required": false
        },
        {
          "name": "system_under_test",
          "type": "string",
          "required": true,
          "enum": [
            "mongodb_atlas",
            "elastic",
            "opensearch",
            "qdrant",
            "pinecone",
            "internal_baseline",
            "other"
          ]
        },
        {
          "name": "retrieval_mode",
          "type": "string",
          "required": true,
          "enum": [
            "vector",
            "keyword",
            "hybrid"
          ]
        },
        {
          "name": "chunking_strategy",
          "type": "string",
          "required": false,
          "enum": [
            "fixed_length",
            "recursive",
            "semantic",
            "contextual"
          ]
        },
        {
          "name": "embedding_model",
          "type": "string",
          "required": false
        },
        {
          "name": "candidate_pool_filter",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "document_ids",
              "type": "array<objectId>",
              "required": false
            },
            {
              "name": "source_types",
              "type": "array<string>",
              "required": false
            }
          ],
          "reason": "Allows controlled comparison subsets during the live demo."
        },
        {
          "name": "top_k_results",
          "type": "array<document>",
          "required": false,
          "fields": [
            {
              "name": "rank",
              "type": "int",
              "required": true
            },
            {
              "name": "document_id",
              "type": "objectId",
              "required": true
            },
            {
              "name": "chunk_id",
              "type": "objectId",
              "required": false
            },
            {
              "name": "score",
              "type": "number",
              "required": false
            },
            {
              "name": "snippet",
              "type": "string",
              "required": false
            },
            {
              "name": "is_relevant",
              "type": "bool",
              "required": false
            }
          ],
          "reason": "Top-K result capture is needed for observable comparison and precision/recall analysis."
        },
        {
          "name": "metrics",
          "type": "document",
          "required": true,
          "fields": [
            {
              "name": "latency_ms",
              "type": "number",
              "required": true
            },
            {
              "name": "precision_at_k",
              "type": "document",
              "required": false
            },
            {
              "name": "recall_at_k",
              "type": "document",
              "required": false
            },
            {
              "name": "result_count",
              "type": "int",
              "required": false
            }
          ],
          "reason": "Directly supports requested benchmark evidence for precision, recall, and latency."
        },
        {
          "name": "run_timestamp",
          "type": "date",
          "required": true
        },
        {
          "name": "notes",
          "type": "string",
          "required": false
        }
      ],
      "relationships": [
        {
          "type": "many_to_one",
          "to_collection": "tenants",
          "via": "tenant_id"
        },
        {
          "type": "many_to_one",
          "to_collection": "benchmark_ground_truths",
          "via": "ground_truth_id"
        }
      ],
      "embedding_vs_reference": "Benchmark runs reference prompts and result targets because many runs are executed against the same prompt across systems and chunking strategies. Top-K results are embedded because they are bounded, run-specific output that should be read with the run document.",
      "indexes": [
        {
          "name": "idx_runs_tenant_groundtruth_time",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "ground_truth_id",
            "run_timestamp"
          ],
          "reason": "Supports reviewing repeated benchmark executions for a prompt over time in the demo."
        },
        {
          "name": "idx_runs_system_strategy",
          "kind": "regular",
          "fields": [
            "system_under_test",
            "chunking_strategy"
          ],
          "reason": "Supports side-by-side comparison by baseline system and chunking strategy."
        },
        {
          "name": "idx_runs_metrics_latency",
          "kind": "regular",
          "fields": [
            "metrics.latency_ms"
          ],
          "reason": "Supports sorting/filtering benchmark runs by measured latency when presenting results."
        }
      ]
    }
  ]
}
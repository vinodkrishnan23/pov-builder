                  "required": true
                },
                {
                  "name": "rerank_score",
                  "type": "float",
                  "required": false
                },
                {
                  "name": "snippet",
                  "type": "string",
                  "required": false
                }
              ],
              "reason": "Embedded because ranked hits are bounded per query/system (top 1/5/10/20) and are consumed together for result inspection."

{
  "collections": [
    {
      "name": "tenants",
      "description": "Represents end-customer tenants/deployments whose documents and agent memory are evaluated separately in the POV. Traces to business entity 'Tenants/customers' and INT6.",
      "traceability": [
        "business_entities:Tenants/customers",
        "INT6",
        "UC1",
        "UC2",
        "UC3"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_key",
          "type": "string",
          "required": true
        },
        {
          "name": "display_name",
          "type": "string",
          "required": true
        },
        {
          "name": "deployment_mode",
          "type": "string",
          "required": true,
          "allowed_values": [
            "saas_isolated",
            "customer_cloud",
            "on_prem_legacy",
            "demo"
          ]
        },
        {
          "name": "cloud",
          "type": "string",
          "required": false,
          "allowed_values": [
            "aws",
            "gcp",
            "azure",
            "other"
          ]
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "allowed_values": [
            "active",
            "inactive"
          ]
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        }
      ],
      "embedding_strategy": "No embedded large child arrays; referenced by higher-volume collections to preserve tenant isolation and support filtering across documents, chunks, memories, and benchmarks.",
      "relationships": [
        {
          "to_collection": "documents",
          "type": "one-to-many",
          "via": "documents.tenant_id"
        },
        {
          "to_collection": "agent_memory",
          "type": "one-to-many",
          "via": "agent_memory.tenant_id"
        },
        {
          "to_collection": "benchmark_runs",
          "type": "one-to-many",
          "via": "benchmark_runs.tenant_id"
        }
      ]
    },
    {
      "name": "documents",
      "description": "Stores uploaded unstructured files and their extraction/indexing metadata for live and pre-seeded document-search evaluation. Raw file may remain external (e.g. S3/object storage), while Atlas stores metadata and extracted text pointers. Traces to Unstructured documents, FR1, FR2, FR4, FR7, SC1.",
      "traceability": [
        "business_entities:Unstructured documents",
        "FR1",
        "FR2",
        "FR4",
        "FR7",
        "UC1",
        "SC1",
        "INT4",
        "INT3"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "source_type",
          "type": "string",
          "required": true,
          "allowed_values": [
            "live_upload",
            "seeded",
            "baseline_import"
          ]
        },
        {
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "name": "file_name",
          "type": "string",
          "required": false
        },
        {
          "name": "mime_type",
          "type": "string",
          "required": false
        },
        {
          "name": "file_size_bytes",
          "type": "int64",
          "required": false
        },
        {
          "name": "storage",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "provider",
              "type": "string",
              "required": true,
              "allowed_values": [
                "s3",
                "gcs",
                "azure_blob",
                "local",
                "none"
              ]
            },
            {
              "name": "uri",
              "type": "string",
              "required": true
            }
          ],
          "reason": "Embedded because storage location is tightly coupled 1:1 with the document metadata and always fetched together."
        },
        {
          "name": "metadata",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "source_system",
              "type": "string",
              "required": false
            },
            {
              "name": "uploaded_by",
              "type": "string",
              "required": false
            },
            {
              "name": "tags",
              "type": "array<string>",
              "required": false
            },
            {
              "name": "language",
              "type": "string",
              "required": false
            },
            {
              "name": "page_count",
              "type": "int32",
              "required": false
            }
          ],
          "reason": "Embedded because document metadata is small and read with the parent document."
        },
        {
          "name": "extraction",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "status",
              "type": "string",
              "required": true,
              "allowed_values": [
                "pending",
                "processing",
                "completed",
                "failed"
              ]
            },
            {
              "name": "extracted_text",
              "type": "string",
              "required": false
            },
            {
              "name": "content_preview",
              "type": "string",
              "required": false
            },
            {
              "name": "error_message",
              "type": "string",
              "required": false
            },
            {
              "name": "processed_at",
              "type": "date",
              "required": false
            }
          ],
          "reason": "Embedded because extraction state is operational metadata for the document itself."
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        }
      ],
      "embedding_strategy": "Chunks are referenced, not embedded, because each document can produce many chunks and multiple chunking strategies per document (FR6), which would create unbounded arrays and complicate vector indexing.",
      "relationships": [
        {
          "to_collection": "tenants",
          "type": "many-to-one",
          "via": "tenant_id"
        },
        {
          "to_collection": "document_chunks",
          "type": "one-to-many",
          "via": "document_chunks.document_id"
        }
      ]
    },
    {
      "name": "document_chunks",
      "description": "Stores chunked text derived from documents, including multiple chunking strategies and embeddings for retrieval. Core collection for vector retrieval benchmark. Traces to Chunks, Embeddings, FR4, FR5, FR6, AI1, AI4.",
      "traceability": [
        "business_entities:Chunks",
        "business_entities:Embeddings",
        "FR4",
        "FR5",
        "FR6",
        "AI1",
        "AI4",
        "UC1",
        "UC3",
        "SC6",
        "SC7"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "document_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "chunking_strategy",
          "type": "string",
          "required": true,
          "allowed_values": [
            "fixed_length",
            "recursive",
            "semantic",
            "contextual"
          ]
        },
        {
          "name": "chunk_index",
          "type": "int32",
          "required": true
        },
        {
          "name": "text",
          "type": "string",
          "required": true
        },
        {
          "name": "token_count",
          "type": "int32",
          "required": false
        },
        {
          "name": "page_span",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "start_page",
              "type": "int32",
              "required": false
            },
            {
              "name": "end_page",
              "type": "int32",
              "required": false
            }
          ],
          "reason": "Embedded because page-span belongs only to this chunk."
        },
        {
          "name": "embedding_model",
          "type": "string",
          "required": true
        },
        {
          "name": "embedding",
          "type": "array<float>",
          "required": true
        },
        {
          "name": "embedding_dimensions",
          "type": "int32",
          "required": true
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        }
      ],
      "embedding_strategy": "Embedding vector is stored in the chunk because retrieval is executed at chunk granularity; separate embeddings collection would add joins to the hot path and is unnecessary for POV scale.",
      "relationships": [
        {
          "to_collection": "documents",
          "type": "many-to-one",
          "via": "document_id"
        },
        {
          "to_collection": "tenants",
          "type": "many-to-one",
          "via": "tenant_id"
        }
      ]
    },
    {
      "name": "agent_memory",
      "description": "Stores conversational or interaction-derived memory records used for agent context retrieval. Kept separate from document chunks because lifecycle, source, and retrieval semantics differ even though both support vector retrieval. Traces to Agent memory/context, FR3, AI2, UC2.",
      "traceability": [
        "business_entities:Agent memory/context",
        "FR3",
        "AI2",
        "UC2",
        "MA3"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "session_id",
          "type": "string",
          "required": true
        },
        {
          "name": "memory_type",
          "type": "string",
          "required": true,
          "allowed_values": [
            "conversation_turn",
            "summary",
            "fact",
            "tool_output",
            "context_doc"
          ]
        },
        {
          "name": "speaker_role",
          "type": "string",
          "required": false,
          "allowed_values": [
            "user",
            "assistant",
            "system",
            "tool"
          ]
        },
        {
          "name": "content",
          "type": "string",
          "required": true
        },
        {
          "name": "embedding_model",
          "type": "string",
          "required": true
        },
        {
          "name": "embedding",
          "type": "array<float>",
          "required": true
        },
        {
          "name": "embedding_dimensions",
          "type": "int32",
          "required": true
        },
        {
          "name": "source_event_time",
          "type": "date",
          "required": false
        },
        {
          "name": "metadata",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "agent_id",
              "type": "string",
              "required": false
            },
            {
              "name": "conversation_id",
              "type": "string",
              "required": false
            },
            {
              "name": "turn_index",
              "type": "int32",
              "required": false
            },
            {
              "name": "tags",
              "type": "array<string>",
              "required": false
            }
          ],
          "reason": "Embedded because memory metadata is small, tightly coupled, and queried with the memory item."
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        }
      ],
      "embedding_strategy": "Stored as standalone documents because memory entries are append-heavy and retrieved independently by tenant/session/vector similarity.",
      "relationships": [
        {
          "to_collection": "tenants",
          "type": "many-to-one",
          "via": "tenant_id"
        }
      ]
    },
    {
      "name": "benchmark_queries",
      "description": "Stores evaluation questions/prompts and expected relevant targets for measuring precision, recall, and top-K behavior, including customer-provided prompts during the live session. Added due to review warning about missing benchmark/ground-truth entities. Traces to UC3, AI5, SC3, SC4 and review ISSUE-5/ISSUE-4.",
      "traceability": [
        "UC3",
        "AI5",
        "SC3",
        "SC4",
        "FR7",
        "SC1",
        "POVReviewResult:ISSUE-4",
        "POVReviewResult:ISSUE-5"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "query_text",
          "type": "string",
          "required": true
        },
        {
          "name": "query_type",
          "type": "string",
          "required": true,
          "allowed_values": [
            "document_search",
            "agent_memory"
          ]
        },
        {
          "name": "provided_during_session",
          "type": "bool",
          "required": true
        },
        {
          "name": "ground_truth",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "relevant_document_ids",
              "type": "array<objectId>",
              "required": false
            },
            {
              "name": "relevant_chunk_ids",
              "type": "array<objectId>",
              "required": false
            },
            {
              "name": "relevant_memory_ids",
              "type": "array<objectId>",
              "required": false
            },
            {
              "name": "notes",
              "type": "string",
              "required": false
            }
          ],
          "reason": "Embedded because ground truth is specific to one benchmark query and small enough for in-document storage."
        },
        {
          "name": "evaluation_cutoffs",
          "type": "array<int32>",
          "required": true
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        }
      ],
      "embedding_strategy": "No separate ground-truth collection needed for POV; benchmark query and expected targets are read together during evaluation.",
      "relationships": [
        {
          "to_collection": "tenants",
          "type": "many-to-one",
          "via": "tenant_id"
        }
      ]
    },
    {
      "name": "benchmark_runs",
      "description": "Stores side-by-side evaluation runs for MongoDB and baseline systems over a set of benchmark queries, capturing latency and retrieval quality metrics. Traces to UC3, FR8, BO5, SC2, SC3, SC4.",
      "traceability": [
        "UC3",
        "FR8",
        "BO5",
        "SC2",
        "SC3",
        "SC4",
        "SC5",
        "MA4",
        "POVReviewResult:ISSUE-2"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "run_name",
          "type": "string",
          "required": true
        },
        {
          "name": "workload_type",
          "type": "string",
          "required": true,
          "allowed_values": [
            "document_search",
            "agent_memory",
            "mixed"
          ]
        },
        {
          "name": "system_under_test",
          "type": "string",
          "required": true,
          "allowed_values": [
            "mongodb_voyage",
            "elastic",
            "opensearch",
            "qdrant",
            "pinecone",
            "other"
          ]
        },
        {
          "name": "baseline_group",
          "type": "string",
          "required": false
        },
        {
          "name": "configuration",
          "type": "document",
          "required": true,
          "fields": [
            {
              "name": "embedding_model",
              "type": "string",
              "required": true
            },
            {
              "name": "chunking_strategy",
              "type": "string",
              "required": false,
              "allowed_values": [
                "fixed_length",
                "recursive",
                "semantic",
                "contextual"
              ]
            },
            {
              "name": "top_k_values",
              "type": "array<int32>",
              "required": true
            },
            {
              "name": "reranking_enabled",
              "type": "bool",
              "required": false
            }
          ],
          "reason": "Embedded because this run configuration is immutable metadata always read with the run."
        },
        {
          "name": "query_set_id",
          "type": "objectId",
          "required": false
        },
        {
          "name": "started_at",
          "type": "date",
          "required": true
        },
        {
          "name": "completed_at",
          "type": "date",
          "required": false
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "allowed_values": [
            "pending",
            "running",
            "completed",
            "failed"
          ]
        },
        {
          "name": "summary_metrics",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "precision_at_k",
              "type": "document",
              "required": false
            },
            {
              "name": "recall_at_k",
              "type": "document",
              "required": false
            },
            {
              "name": "avg_latency_ms",
              "type": "double",
              "required": false
            },
            {
              "name": "p95_latency_ms",
              "type": "double",
              "required": false
            },
            {
              "name": "result_count",
              "type": "int32",
              "required": false
            }
          ],
          "reason": "Embedded because aggregate metrics are compact and belong to the run."
        },
        {
          "name": "notes",
          "type": "string",
          "required": false
        }
      ],
      "embedding_strategy": "Per-query results are referenced, not embedded, because a run can contain many queries and result sets; keeping them separate avoids oversized run documents.",
      "relationships": [
        {
          "to_collection": "tenants",
          "type": "many-to-one",
          "via": "tenant_id"
        },
        {
          "to_collection": "benchmark_queries",
          "type": "many-to-one",
          "via": "query_set_id"
        },
        {
          "to_collection": "benchmark_results",
          "type": "one-to-many",
          "via": "benchmark_results.run_id"
        }
      ]
    },
    {
      "name": "benchmark_results",

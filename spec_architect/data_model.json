        "business_entities:Execution Log",
        "business_entities:Rule",
        "use_cases:UC-1",
        "use_cases:UC-2",
        "functional_requirements:FR-3",
        "functional_requirements:FR-4",
        "functional_requirements:FR-6",
        "functional_requirements:FR-7",
        "functional_requirements:FR-8",

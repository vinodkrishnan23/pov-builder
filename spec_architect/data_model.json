      "traceability": [
        "SC3",
        "SC4",
        "FR8",
        "AI4",
        "AI5",
        "UC3",
        "POVReviewResult:ISSUE-5"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "run_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "benchmark_query_id",
          "type": "objectId",
          "required": true

          "required": false
        },
        {
          "name": "char_count",
          "type": "int",
          "required": false
        },
        {
          "name": "page_range",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "start",
              "type": "int",
              "required": false
            },
            {
              "name": "end",

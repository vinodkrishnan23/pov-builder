{
  "collections": [
    {
      "name": "tenants",
      "description": "Logical customer/workshop boundary for uploaded corpora, agent memory, and benchmark artifacts. Included because Tenant is a business entity and documents/benchmarks need customer-level isolation for POV datasets.",
      "traceability": [
        "business_entities:Tenant",
        "use_cases:UC1",
        "use_cases:UC2",
        "use_cases:UC3"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_key",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "deployment_mode",
          "type": "string",
          "required": false,
          "enum": [
            "shared_pov",
            "isolated_pov"
          ]
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "enum": [
            "active",
            "inactive"
          ]
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        },
        {
          "name": "metadata",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "notes",
              "type": "string",
              "required": false
            }
          ]
        }
      ],
      "relationships": [
        {
          "type": "one-to-many",
          "to": "documents",
          "via": "documents.tenant_id"
        },
        {
          "type": "one-to-many",
          "to": "benchmark_runs",
          "via": "benchmark_runs.tenant_id"
        },
        {
          "type": "one-to-many",
          "to": "ground_truth_sets",
          "via": "ground_truth_sets.tenant_id"
        }
      ],
      "embedding_vs_reference": {
        "strategy": "top-level collection referenced by ObjectId from workload collections",
        "why": "Tenant is reused across many documents, chunks, memory items, and benchmark runs; referencing avoids duplication and supports tenant-scoped queries."
      },
      "indexes": [
        {
          "name": "uk_tenant_key",
          "kind": "regular",
          "fields": [
            "tenant_key"
          ],
          "reason": "Fast lookup of a tenant/workshop namespace by stable external key during upload, search, and benchmarking flows."
        }
      ]
    },
    {
      "name": "documents",
      "description": "Uploaded source documents and agent-memory source records used for search, retrieval, and evaluation. Covers PDFs, CSVs, sheets exports, text files, and conversation-derived memory documents.",
      "traceability": [
        "business_entities:Document",
        "business_entities:Agent memory document",
        "functional_requirements:FR1",
        "functional_requirements:FR2",
        "functional_requirements:FR3",
        "functional_requirements:FR7",
        "use_cases:UC1",
        "use_cases:UC2"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "document_type",
          "type": "string",
          "required": true,
          "enum": [
            "pdf",
            "csv",
            "google_sheet_export",
            "txt",
            "md",
            "html",
            "doc_export",
            "slack_export",
            "jira_export",
            "conversation_memory",
            "other"
          ]
        },
        {
          "name": "source_category",
          "type": "string",
          "required": true,
          "enum": [
            "uploaded_file",
            "connector_export",
            "agent_memory"
          ]
        },
        {
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "name": "source_uri",
          "type": "string",
          "required": false
        },
        {
          "name": "storage_provider",
          "type": "string",
          "required": false,
          "enum": [
            "s3",
            "atlas",
            "other"
          ]
        },
        {
          "name": "mime_type",
          "type": "string",
          "required": false
        },
        {
          "name": "file_size_bytes",
          "type": "long",
          "required": false
        },
        {
          "name": "checksum",
          "type": "string",
          "required": false
        },
        {
          "name": "language",
          "type": "string",
          "required": false
        },
        {
          "name": "tags",
          "type": "array<string>",
          "required": false
        },
        {
          "name": "structured_metadata",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "author",
              "type": "string",
              "required": false
            },
            {
              "name": "created_source_at",
              "type": "date",
              "required": false
            },
            {
              "name": "connector_name",
              "type": "string",
              "required": false
            },
            {
              "name": "external_ids",
              "type": "document",
              "required": false
            }
          ]
        },
        {
          "name": "text_extraction",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "status",
              "type": "string",
              "required": true,
              "enum": [
                "pending",
                "completed",
                "failed"
              ]
            },
            {
              "name": "raw_text",
              "type": "string",
              "required": false
            },
            {
              "name": "page_count",
              "type": "int",
              "required": false
            },
            {
              "name": "extracted_at",
              "type": "date",
              "required": false
            },
            {
              "name": "error_message",
              "type": "string",
              "required": false
            }
          ]
        },
        {
          "name": "agent_memory_metadata",
          "type": "document",
          "required": false,
          "fields": [
            {
              "name": "session_id",
              "type": "string",
              "required": false
            },
            {
              "name": "conversation_id",
              "type": "string",
              "required": false
            },
            {
              "name": "speaker_ids",
              "type": "array<string>",
              "required": false
            },
            {
              "name": "captured_at",
              "type": "date",
              "required": false
            }
          ]
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "enum": [
            "uploaded",
            "processed",
            "failed",
            "archived"
          ]
        },
        {
          "name": "created_at",
          "type": "date",
          "required": true
        },
        {
          "name": "updated_at",
          "type": "date",
          "required": true
        }
      ],
      "relationships": [
        {
          "type": "many-to-one",
          "to": "tenants",
          "via": "tenant_id"
        },
        {
          "type": "one-to-many",
          "to": "chunks",
          "via": "chunks.document_id"
        }
      ],
      "embedding_vs_reference": {
        "strategy": "top-level collection; chunks reference documents",
        "why": "Documents can be large and produce many chunks under multiple chunking strategies. Keeping documents separate avoids rewriting large source records when chunking/embedding variants are regenerated."
      },
      "indexes": [
        {
          "name": "idx_documents_tenant_status_type",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "status",
            "document_type"
          ],
          "reason": "Supports tenant-scoped upload/review screens and filtering by processed state and document type during the POV."
        },
        {
          "name": "idx_documents_tenant_source_category",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "source_category"
          ],
          "reason": "Supports separating unstructured document search corpora from agent memory source documents within a tenant."
        },
        {
          "name": "idx_documents_checksum",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "checksum"
          ],
          "reason": "Supports deduplication checks when users upload representative files during the session."
        },
        {
          "name": "search_documents_text",
          "kind": "search",
          "fields": [
            "title",
            "text_extraction.raw_text",
            "tags"
          ],
          "reason": "Supports lexical/full-text retrieval and mixed search over uploaded documents, especially for benchmark comparisons against non-vector approaches."
        }
      ]
    },
    {
      "name": "chunks",
      "description": "Chunked document segments produced by one or more chunking strategies, each optionally contextualized and embedded for retrieval.",
      "traceability": [
        "business_entities:Chunk",
        "business_entities:Embedding",
        "functional_requirements:FR4",
        "functional_requirements:FR5",
        "functional_requirements:FR6",
        "ai_genai_requirements:AI2",
        "ai_genai_requirements:AI5",
        "use_cases:UC1",
        "use_cases:UC2"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "document_id",
          "type": "objectId",
          "required": true
        },
        {

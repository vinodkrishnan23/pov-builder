        "decision": "top-level collection",
        "why": "This is the primary retrieval unit for vector search and can scale to very large volumes; separate storage is required for efficient vector and text indexing."
      },
      "indexes": [
        {
          "name": "chunks_doc_profile_index_unique",
          "kind": "regular",
          "fields": [
            "document_id",
            "chunking_profile_id",
            "chunk_index"
          ],
          "reason": "Supports deterministic reconstruction of chunk order for a given document and chunking strategy, and avoids duplicate chunk generation."
        },
        {
          "name": "chunks_tenant_doc",
          "kind": "regular",
          "fields": [
            "tenant_id",
            "document_id"
          ],
          "reason": "Supports fetching all chunks for a selected document within a tenant, such as drill-down from search results."
        },
        {
          "name": "chunks_text_search",
          "kind": "search",
          "fields": [
            "text"
          ],
          "reason": "Supports lexical/full-text retrieval and fallback comparison during benchmarking, since the customer wants comparison of retrieval quality and may compare approaches beyond pure vector retrieval."
        },
        {
          "name": "chunks_embedding_vector",
          "kind": "vector",
          "fields": [
            "embedding"
          ],
          "reason": "Supports embedding-based nearest-neighbor retrieval over document chunks, the core POV access pattern for question-to-document search benchmarking."
        }
      ]

      "traceability": [
        "UC1",
        "FR2",
        "FR7",
        "FR8",
        "AI1",
        "AI2",
        "AI3",
        "SC4",
        "SC5"
      ],
      "fields": [
        {
          "name": "_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "tenant_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "document_id",
          "type": "objectId",
          "required": true
        },
        {
          "name": "chunking_strategy",
          "type": "string",
          "required": true,
          "enum": [
            "fixed_length",
            "recursive",
            "semantic",
            "contextual"
          ]

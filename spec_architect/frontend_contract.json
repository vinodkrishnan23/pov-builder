        },
        {
          "condition": "400 INVALID_REQUEST on search",
          "ui": "validation for session_id, memory_types, query_embedding, top_k, num_candidates"
        },
        {
          "condition": "404 TENANT_NOT_FOUND",
          "ui": "tenant not found state"
        },
        {
          "condition": "request failure",
          "ui": "inline error in corresponding panel"
        }
      ]
    },

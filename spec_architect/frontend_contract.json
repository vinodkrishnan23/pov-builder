  "constraints": [
    {
      "type": "api_gap",
      "description": "No endpoint exists to upload raw files/binary blobs; frontend can only collect external storage URIs and metadata."
    },
    {
      "type": "api_gap",
      "description": "No endpoint exists to list tenants; frontend must rely on creation response, direct tenant ID entry, or externally supplied deep links."
    },
    {
      "type": "api_gap",
      "description": "No endpoint exists to list documents for a tenant; frontend cannot provide a browse-all document library and should rely on readiness summary, search results, and direct post-create navigation."
    },
    {
      "type": "api_gap",
      "description": "No endpoint exists to delete/update/replace chunks by strategy; frontend must not imply overwrite/delete management for chunk sets."
    },
    {
      "type": "api_gap",
      "description": "No single endpoint exists to execute an entire benchmark automatically; frontend must model run creation, per-query result submission, and run completion as separate steps."
    },
    {
      "type": "api_gap",
      "description": "No endpoint exists to list benchmark runs generically; frontend can only navigate to runs it just created, runs linked from app state/history, or compare summaries without guaranteed drill-down IDs."
    },
    {
      "type": "integration_dependency",
      "description": "Vector and hybrid searches require query embeddings, and document/agent memory ingestion require embeddings/chunk generation supplied by application-layer orchestration outside this API contract."
    }
  ]

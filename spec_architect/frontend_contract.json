{
  "app_shell": {
    "global_state": [
      "selectedTenantId",
      "chunkingProfilesCache",
      "activeBenchmarkDatasetId",
      "activeBenchmarkRunId"
    ],
    "navigation": [
      {
        "label": "Tenants",
        "route": "/tenants"
      },
      {
        "label": "Workspace",
        "route": "/tenants/:tenantId"
      },
      {
        "label": "Documents",
        "route": "/tenants/:tenantId/documents"
      },
      {
        "label": "Chunking Profiles",
        "route": "/chunking-profiles"
      },
      {
        "label": "Retrieval Playground",
        "route": "/tenants/:tenantId/retrieval"
      },
      {
        "label": "Benchmark Datasets",
        "route": "/tenants/:tenantId/benchmark-datasets"
      },
      {
        "label": "Agent Memory",
        "route": "/tenants/:tenantId/agent-memory"
      }
    ],
    "notes": [
      "Tenant scoping is required for all tenant-scoped resources.",
      "Frontend must not imply automatic file upload, embedding generation, or benchmark execution because the API does not expose those capabilities."
    ]
  },
  "routes": [
    {
      "route": "/tenants",
      "page_id": "tenant_home"
    },
    {
      "route": "/tenants/:tenantId",
      "page_id": "tenant_workspace"
    },
    {
      "route": "/tenants/:tenantId/documents",
      "page_id": "documents_list"
    },
    {
      "route": "/tenants/:tenantId/documents/:documentId",
      "page_id": "document_detail"
    },
    {
      "route": "/chunking-profiles",
      "page_id": "chunking_profiles"
    },
    {
      "route": "/tenants/:tenantId/documents/:documentId/chunks",
      "page_id": "document_chunks_drilldown"
    },
    {
      "route": "/tenants/:tenantId/retrieval",
      "page_id": "retrieval_playground"
    },
    {
      "route": "/tenants/:tenantId/benchmark-datasets",
      "page_id": "benchmark_datasets"
    },
    {
      "route": "/tenants/:tenantId/benchmark-datasets/:benchmarkDatasetId",
      "page_id": "benchmark_dataset_detail"
    },
    {
      "route": "/tenants/:tenantId/benchmark-datasets/:benchmarkDatasetId/runs",
      "page_id": "benchmark_runs"
    },
    {
      "route": "/tenants/:tenantId/benchmark-runs/:benchmarkRunId",

  "constraints_and_gaps": [
    {
      "gap": "No endpoint exists to upload binary files directly.",
      "frontend_implication": "Register Document should describe itself as metadata/source registration. If actual file bytes are handled elsewhere, the UI can only capture source_filename/source_uri/source_system metadata via createDocument."
    },
    {
      "gap": "No endpoints exist to trigger parsing, chunking, embedding, or retry failed ingestion jobs.",
      "frontend_implication": "The UI may show ingestion status and troubleshooting but must not promise start/retry automation beyond storing records such as documents and chunks."
    },
    {
      "gap": "No standalone document detail/read endpoint exists.",
      "frontend_implication": "Pages that need a document selector must source options from listSessionDocuments or user-provided ids."
    },
    {
      "gap": "No API exists to execute external baseline systems or orchestrate side-by-side runs automatically.",
      "frontend_implication": "Benchmark pages can capture externally generated results and compare stored metrics, but cannot run Elastic/OpenSearch/Qdrant from this contract."
    },
    {
      "gap": "No API exists to calculate embeddings from raw text or questions.",
      "frontend_implication": "Retrieval forms requiring query_embedding must either accept vectors directly or rely on a separate non-authoritative client-side/service integration that is explicitly outside this API contract."
    }
  ]
}
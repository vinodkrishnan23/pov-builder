    {
      "page_id": "benchmark_results_capture",
      "title": "Capture Benchmark Results",
      "purpose": "Store ranked outputs and latency metrics for one or more benchmark questions and systems under test.",
      "data_requirements": [
        {
          "name": "questions",
          "source": "API",
          "shape": "benchmark questions for mapping results to question ids"
        },
        {
          "name": "batch_results_form",
          "source": "user input",
          "shape": "array of result records"

  "shared_components": [
    {
      "name": "TenantSwitcher",
      "purpose": "Switch active tenant across tenant-scoped routes",
      "used_on": [
        "tenant_workspace",
        "documents_list",
        "document_detail",
        "document_chunks_drilldown",
        "retrieval_playground",
        "benchmark_datasets",
        "benchmark_dataset_detail",
        "benchmark_runs",
        "benchmark_run_detail",
        "benchmark_run_comparison",
        "agent_memory_sessions"
      ]
    },
    {
      "name": "ApiErrorBanner",
      "purpose": "Render API error codes/messages consistently",
      "used_on": "all"
    },
    {
      "name": "LoadingSkeleton",
      "purpose": "Standard loading placeholders",
      "used_on": "all"
    },
    {
      "name": "EmptyStatePanel",
      "purpose": "Consistent empty-state handling",
      "used_on": "all list/detail analysis screens"
    },
    {
      "name": "TopKSelector",
      "purpose": "Select benchmark/retrieval top-k values 1/5/10/20 or allowed custom limit",
      "used_on": [
        "retrieval_playground",
        "benchmark_runs"
      ]
    },
    {
      "name": "CapabilityNotice",
      "purpose": "Explain backend limitations where API lacks automation/upload/generation endpoints",
      "used_on": [
        "documents_list",
        "retrieval_playground",
        "benchmark_run_detail",
        "agent_memory_sessions"
      ]
    }
  ],
  "constraints": [
    {
      "type": "api_gap",
      "description": "No binary file upload endpoint exists. Frontend can only register document metadata/storage references and display them."
    },
    {
      "type": "api_gap",
      "description": "No embedding generation endpoint exists for documents, benchmark queries, retrieval queries, or agent-memory searches. Frontend must accept externally generated embeddings when vector operations are used."
    },
    {
      "type": "api_gap",
      "description": "No bulk chunk upload endpoint exists; chunks are created one at a time with createDocumentChunk."
    },
    {
      "type": "api_gap",
      "description": "No endpoint executes benchmark runs automatically or computes metrics from raw retrieved hits on demand. Frontend can create run records, update status, and submit results/metrics."
    },
    {
      "type": "api_gap",
      "description": "No cost/storage estimation endpoint exists, so the UI cannot provide backend-derived cost comparison views."
    },
    {
      "type": "api_gap",
      "description": "No dedicated structured+unstructured workflow endpoint exists, so this should not be represented as an implemented POV screen."
    },
    {
      "type": "api_gap",
      "description": "No multimodal extraction endpoint exists, so PDF image/table extraction workflows should not be promised."
    }
  ]
}
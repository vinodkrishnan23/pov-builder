    },
    {
      "route": "/tenants/:tenantId/benchmark-datasets/:benchmarkDatasetId/comparisons",
      "page_id": "benchmark_run_comparison"
    },
    {
      "route": "/tenants/:tenantId/agent-memory",
      "page_id": "agent_memory_sessions"
    }
  ],

      "page_id": "tenant_home",
      "title": "Tenant Home",
      "purpose": "Select or create an isolated tenant/deployment scope for the benchmark session.",
      "data_requirements": [
        "Tenant list with basic metadata",
        "Optional exact-name filtered tenant lookup"
      ],
      "api_endpoints": [
        {
          "operation_id": "listTenants",
          "usage": "initial list and exact-name filter"
        },
        {
          "operation_id": "createTenant",
          "usage": "create new tenant"
        }
      ],
      "user_actions": [
        "View tenant list",
        "Filter by exact tenant name",
        "Create tenant",
        "Open tenant workspace"
      ],
      "loading_states": [
        "Initial tenant list skeleton",
        "Inline submitting state on create form"
      ],
      "error_states": [
        "List load failure/invalid query",
        "Create validation error",
        "Tenant name conflict"
      ],
      "components": [
        "TenantList",
        "TenantFilterBar",
        "CreateTenantForm",
        "EmptyState",
        "ErrorBanner"
      ]
    },

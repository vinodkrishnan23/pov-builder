{
  "routes": [
    {
      "path": "/tenants",
      "page_id": "tenant_list",
      "auth_scope": "global"
    },
    {
      "path": "/tenants/new",
      "page_id": "tenant_create",
      "auth_scope": "global"
    },
    {
      "path": "/tenants/:tenantId",
      "page_id": "tenant_home",
      "auth_scope": "tenant"
    },
    {
      "path": "/tenants/:tenantId/documents",
      "page_id": "session_documents",
      "auth_scope": "tenant",
      "query_params": [
        {
          "name": "upload_session_label",
          "required": true
        }
      ]
    },
    {
      "path": "/tenants/:tenantId/documents/new",
      "page_id": "document_create",
      "auth_scope": "tenant",
      "prefill_from_query": [
        "upload_session_label"
      ]
    },
    {
      "path": "/tenants/:tenantId/documents/failed",
      "page_id": "failed_documents",
      "auth_scope": "tenant"
    },
    {
      "path": "/tenants/:tenantId/documents/chunking-coverage",
      "page_id": "chunking_coverage",
      "auth_scope": "tenant",
      "query_params": [
        {
          "name": "upload_session_label",
          "required": true
        }
      ]
    },
    {
      "path": "/tenants/:tenantId/document-chunks/new",
      "page_id": "document_chunk_create",
      "auth_scope": "tenant",
      "query_params": [
        {
          "name": "document_id",
          "required": false
        },
        {
          "name": "upload_session_label",
          "required": false
        }
      ]
    },
    {
      "path": "/tenants/:tenantId/retrieval/document-search",
      "page_id": "document_search_vector",
      "auth_scope": "tenant"
    },
    {
      "path": "/tenants/:tenantId/retrieval/document-keyword-filtered",
      "page_id": "document_search_keyword_filtered",
      "auth_scope": "tenant"
    },
    {
      "path": "/tenants/:tenantId/retrieval/document-hybrid",
      "page_id": "document_search_hybrid",
      "auth_scope": "tenant"
    },
    {
      "path": "/tenants/:tenantId/agent-memory",
      "page_id": "agent_memory",
      "auth_scope": "tenant"
    },
    {
      "path": "/tenants/:tenantId/benchmarks",
      "page_id": "benchmark_runs",
      "auth_scope": "tenant"
    },
    {
      "path": "/benchmark-runs/:benchmarkRunId/questions",
      "page_id": "benchmark_questions",
      "auth_scope": "tenant_via_run_context"
    },
    {
      "path": "/benchmark-runs/:benchmarkRunId/results/new",
      "page_id": "benchmark_results_capture",
      "auth_scope": "tenant_via_run_context"
    },
    {
      "path": "/benchmark-runs/:benchmarkRunId/questions/:benchmarkQuestionId/results",
      "page_id": "benchmark_question_results",
      "auth_scope": "tenant_via_run_context",
      "query_params": [
        {
          "name": "system_name",
          "required": true
        },
        {
          "name": "top_k",
          "required": true
        }
      ]
    },
    {
      "path": "/benchmark-runs/:benchmarkRunId/comparison",
      "page_id": "benchmark_comparison",
      "auth_scope": "tenant_via_run_context",
      "query_params": [
        {
          "name": "top_k_values",
          "required": true
        }
      ]
    },
    {
      "path": "/benchmark-runs/:benchmarkRunId/summary",
      "page_id": "benchmark_summary",
      "auth_scope": "tenant_via_run_context",
      "query_params": [
        {
          "name": "systems",
          "required": true
        }
      ]
    }
  ],
  "pages": [
    {
      "page_id": "tenant_list",
      "title": "Tenants",
      "purpose": "Entry point to view existing evaluation tenants and select one for the workshop.",
      "data_requirements": [
        {
          "name": "tenants",
          "source": "API",
          "shape": "array of tenant summaries"
        }
      ],
      "api_consumption": [
        {
          "operation_id": "listTenants",
          "usage": "initial load and manual refresh"
        }
      ],
      "user_actions": [
        {
          "action": "select_tenant",
          "effect": "navigate to /tenants/:tenantId"
        },
        {
          "action": "create_tenant",
          "effect": "navigate to /tenants/new"
        },
        {
          "action": "refresh",
          "effect": "refetch tenants"
        }
      ],
      "loading_states": [
        "Initial skeleton list while tenants load.",
        "Inline spinner on refresh."
      ],
      "error_states": [
        {
          "condition": "GET /tenants fails",
          "ui": "full-page error with retry"
        }
      ]
    },
    {
      "page_id": "tenant_create",
      "title": "Create Tenant",
      "purpose": "Create an evaluation tenant for a POV workshop.",
      "data_requirements": [],
      "api_consumption": [
        {
          "operation_id": "createTenant",
          "usage": "form submit"
        }
      ],
      "user_actions": [
        {
          "action": "submit_tenant_form",
          "effect": "POST tenant then navigate to tenant home on success"
        },
        {
          "action": "cancel",
          "effect": "return to tenant list"
        }
      ],
      "loading_states": [
        "Disable form and show submitting state during POST."
      ],
      "error_states": [
        {
          "condition": "400 INVALID_REQUEST",
          "ui": "field and form validation messages"
        },
        {
          "condition": "409 TENANT_KEY_CONFLICT",
          "ui": "tenant_key conflict message"
        },
        {
          "condition": "network/server error",
          "ui": "toast/banner with retry"
        }
      ]
    },
    {
      "page_id": "tenant_home",
      "title": "Tenant Workspace Home",
      "purpose": "Landing page for a selected tenant, summarizing available workshop workflows and navigation.",
      "data_requirements": [],
      "api_consumption": [],
      "user_actions": [
        {
          "action": "go_to_session_documents",
          "effect": "navigate to documents page with chosen upload_session_label"
        },
        {
          "action": "go_to_retrieval_demo",
          "effect": "navigate to retrieval pages"
        },
        {
          "action": "go_to_agent_memory",
          "effect": "navigate to agent memory"
        },
        {
          "action": "go_to_benchmarks",
          "effect": "navigate to benchmark runs"
        }
      ],
      "loading_states": [],
      "error_states": [
        {
          "condition": "tenantId invalid or stale route context",
          "ui": "not found / back to tenants"
        }
      ]
    },
    {
      "page_id": "session_documents",
      "title": "Session Documents",
      "purpose": "Show registered documents for a specific upload session and their ingestion state during the workshop.",
      "data_requirements": [
        {
          "name": "upload_session_label",
          "source": "route query",
          "shape": "string"
        },
        {
          "name": "documents",
          "source": "API",
          "shape": "array of session documents"
        }
      ],
      "api_consumption": [
        {
          "operation_id": "listSessionDocuments",
          "usage": "load documents for active session"
        }
      ],
      "user_actions": [
        {
          "action": "change_upload_session_label",
          "effect": "reload list for different session"
        },
        {
          "action": "register_document",
          "effect": "navigate to document create with upload_session_label prefilled"
        },
        {
          "action": "view_failed_documents",
          "effect": "navigate to failed documents"
        },
        {
          "action": "view_chunking_coverage",
          "effect": "navigate to chunking coverage with current upload_session_label"
        },
        {
          "action": "add_chunk_for_document",
          "effect": "navigate to add document chunk page using selected document id"
        },
        {
          "action": "refresh",
          "effect": "refetch current session list"
        }
      ],
      "loading_states": [
        "Initial table skeleton.",
        "Empty state when no documents found for session.",
        "Inline refresh spinner."
      ],
      "error_states": [
        {
          "condition": "400 MISSING_UPLOAD_SESSION_LABEL",
          "ui": "blocking prompt to provide upload_session_label"
        },
        {
          "condition": "404 TENANT_NOT_FOUND",
          "ui": "tenant not found state"
        },
        {
          "condition": "other fetch failure",
          "ui": "error banner with retry"
        }
      ]
    },
    {
      "page_id": "document_create",
      "title": "Register Document",
      "purpose": "Register a customer-provided source document and its current ingest metadata for the workshop flow.",
      "data_requirements": [
        {
          "name": "tenantId",
          "source": "route",
          "shape": "string"
        },
        {
          "name": "upload_session_label",
          "source": "route query or form",
          "shape": "string optional"
        }
      ],
      "api_consumption": [
        {
          "operation_id": "createDocument",
          "usage": "form submit"
        }
      ],
      "user_actions": [
        {
          "action": "submit_document_form",
          "effect": "create document then return to session documents for same upload_session_label when available"
        },
        {
          "action": "cancel",
          "effect": "return to session documents or tenant home"
        }
      ],
      "loading_states": [
        "Disable submit and show saving state during POST."
      ],
      "error_states": [
        {
          "condition": "400 INVALID_REQUEST",
          "ui": "field validation messages for required enums/dates/status"
        },
        {
          "condition": "404 TENANT_NOT_FOUND",
          "ui": "tenant not found message and link back"
        },
        {
          "condition": "server error",
          "ui": "toast/banner with retry"
        }
      ]
    },
    {
      "page_id": "failed_documents",
      "title": "Failed Documents",
      "purpose": "Troubleshoot documents whose ingest pipeline failed.",
      "data_requirements": [
        {
          "name": "documents",
          "source": "API",
          "shape": "array of failed documents with ingest_errors"
        }
      ],
      "api_consumption": [
        {
          "operation_id": "listFailedDocuments",
          "usage": "initial load and refresh"
        }
      ],
      "user_actions": [
        {
          "action": "refresh",
          "effect": "refetch failed documents"
        },
        {
          "action": "back_to_session_documents",
          "effect": "return to documents page"
        }
      ],
      "loading_states": [
        "Skeleton list on load."
      ],
      "error_states": [
        {
          "condition": "404 TENANT_NOT_FOUND",
          "ui": "tenant not found state"
        },
        {
          "condition": "other fetch failure",
          "ui": "error banner with retry"
        }
      ]
    },
    {
      "page_id": "chunking_coverage",
      "title": "Chunking Coverage",
      "purpose": "Summarize which chunking strategies have been applied to documents in the current upload session.",
      "data_requirements": [
        {
          "name": "upload_session_label",
          "source": "route query",
          "shape": "string"
        },
        {
          "name": "strategies",
          "source": "API",
          "shape": "array of coverage summaries"
        }
      ],
      "api_consumption": [
        {
          "operation_id": "getChunkingCoverageSummary",
          "usage": "load strategy coverage for session"
        }
      ],
      "user_actions": [
        {
          "action": "change_upload_session_label",
          "effect": "reload summary"
        },
        {
          "action": "back_to_documents",
          "effect": "navigate back to session documents"
        }
      ],
      "loading_states": [
        "Cards/table skeleton while coverage loads."
      ],
      "error_states": [
        {
          "condition": "400 MISSING_UPLOAD_SESSION_LABEL",
          "ui": "blocking prompt for upload_session_label"
        },
        {
          "condition": "404 TENANT_NOT_FOUND",
          "ui": "tenant not found state"
        },
        {
          "condition": "other fetch failure",
          "ui": "error banner with retry"
        }
      ]
    },
    {
      "page_id": "document_chunk_create",
      "title": "Add Document Chunk",
      "purpose": "Store a parsed and embedded chunk for a known document as part of a manual or semi-manual ingest demo.",
      "data_requirements": [
        {
          "name": "candidate_documents",
          "source": "API (optional preload from listSessionDocuments when upload_session_label supplied)",
          "shape": "array of session documents for picker"
        },
        {
          "name": "document_id",
          "source": "route query or user selection",
          "shape": "string"
        }
      ],
      "api_consumption": [
        {
          "operation_id": "listSessionDocuments",
          "usage": "optional preload document picker when upload_session_label present"
        },
        {
          "operation_id": "createDocumentChunk",
          "usage": "form submit"
        }
      ],
      "user_actions": [
        {
          "action": "select_document",
          "effect": "bind chosen document_id for chunk creation"
        },
        {
          "action": "submit_chunk_form",
          "effect": "create chunk and remain on page or return to previous context"
        },
        {
          "action": "cancel",
          "effect": "return to previous page"
        }
      ],
      "loading_states": [
        "Optional document picker loading when preloading session docs.",
        "Submit loading state during POST."
      ],
      "error_states": [
        {
          "condition": "400 INVALID_REQUEST",
          "ui": "field validation for required document_id, text, embedding_model, embedding, strategy, chunk_index"
        },
        {
          "condition": "404 TENANT_OR_DOCUMENT_NOT_FOUND",
          "ui": "document/tenant not found message"
        },
        {
          "condition": "unable to preload document list",
          "ui": "picker fallback to manual document_id entry"
        }
      ],
      "notes": [
        "Because there is no GET /documents/{id}, this page must rely on a passed document_id or a previously/freshly loaded session document list for selection."
      ]
    },
    {
      "page_id": "document_search_vector",
      "title": "Vector Document Search",
      "purpose": "Primary document-search demo using semantic vector retrieval over stored chunks.",
      "data_requirements": [
        {
          "name": "search_form",
          "source": "user input",
          "shape": "query_embedding, top_k, num_candidates, chunking_strategy, embedding_model"
        },
        {
          "name": "results",
          "source": "API",
          "shape": "ranked chunks with document context"
        }
      ],
      "api_consumption": [
        {
          "operation_id": "searchDocumentChunksVector",
          "usage": "search submit"
        }
      ],
      "user_actions": [
        {
          "action": "run_search",
          "effect": "POST retrieval request and display ranked results"
        },
        {
          "action": "adjust_top_k_or_strategy",
          "effect": "rerun search"
        },
        {
          "action": "copy_result_text",
          "effect": "copy chunk text from result card"
        }
      ],
      "loading_states": [
        "Disable search button and show result skeleton during search."
      ],
      "error_states": [
        {
          "condition": "400 INVALID_REQUEST",
          "ui": "validation errors for missing embedding/top_k/num_candidates/strategy/model"
        },
        {
          "condition": "404 TENANT_NOT_FOUND",
          "ui": "tenant not found state"
        },
        {
          "condition": "search failure",
          "ui": "inline error with retry"
        }
      ]
    },
    {
      "page_id": "document_search_keyword_filtered",
      "title": "Keyword + Metadata Retrieval",
      "purpose": "Demonstrate structured-plus-unstructured retrieval using metadata constraints and keyword/phrase matching.",
      "data_requirements": [
        {
          "name": "search_form",
          "source": "user input",
          "shape": "document_types optional, language required, tags optional, chunking_strategy, keyword_or_phrase"
        },
        {
          "name": "documents",
          "source": "API",
          "shape": "grouped documents with matching chunks"
        }
      ],
      "api_consumption": [
        {
          "operation_id": "searchDocumentChunksByKeywordAndMetadata",
          "usage": "search submit"
        }
      ],
      "user_actions": [
        {
          "action": "run_search",
          "effect": "POST filtered retrieval and render grouped results"
        },
        {
          "action": "edit_filters",
          "effect": "rerun search with new metadata constraints"
        }
      ],
      "loading_states": [
        "Result skeleton during search."
      ],
      "error_states": [
        {
          "condition": "400 INVALID_REQUEST",
          "ui": "validation for required language, keyword_or_phrase, chunking_strategy"
        },
        {
          "condition": "404 TENANT_NOT_FOUND",
          "ui": "tenant not found state"
        },
        {
          "condition": "search failure",
          "ui": "inline error with retry"
        }
      ]
    },
    {
      "page_id": "document_search_hybrid",
      "title": "Hybrid Structured + Unstructured Retrieval",
      "purpose": "Demonstrate semantic retrieval constrained by structured document metadata.",
      "data_requirements": [
        {
          "name": "search_form",
          "source": "user input",
          "shape": "query_embedding, top_k, num_candidates, chunking_strategy, document_types optional, structured_filter attribute/value"
        },
        {
          "name": "results",
          "source": "API",
          "shape": "ranked chunks with parent document structured_attributes"
        }
      ],
      "api_consumption": [
        {
          "operation_id": "searchHybridStructuredUnstructured",
          "usage": "search submit"
        }
      ],
      "user_actions": [
        {
          "action": "run_search",
          "effect": "POST hybrid retrieval and display results"
        },
        {
          "action": "change_structured_filter",
          "effect": "rerun search"
        }
      ],
      "loading_states": [
        "Result skeleton during search."
      ],
      "error_states": [
        {
          "condition": "400 INVALID_REQUEST",
          "ui": "validation for vector inputs, chunking_strategy, attribute/value"
        },
        {
          "condition": "404 TENANT_NOT_FOUND",
          "ui": "tenant not found state"
        },
        {
          "condition": "search failure",
          "ui": "inline error with retry"
        }
      ]
    },
    {
      "page_id": "agent_memory",
      "title": "Agent Memory",
      "purpose": "Support the secondary use case of storing and retrieving conversation-derived memories for an agent session.",
      "data_requirements": [

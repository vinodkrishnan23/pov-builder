{
  "app": {
    "name": "ThoughtSpot AI Retrieval POV Builder",
    "type": "tenant_scoped_spa",
    "base_route": "/",
    "global_constraints": [
      "All pages require an active tenantId created during the session; the API contract does not expose tenant list/get endpoints, so returning to prior tenants must rely on client-kept context or manually re-entered deep links.",
      "Binary file upload/download is not supported by the API contract. Document registration UI must only collect metadata, source_uri, and/or raw_text.",
      "Chunk creation and embedding generation are not exposed by the API. UI must present chunk inspection as read-only and vector/hybrid retrieval as dependent on an external embedding-generation service/application layer.",
      "No update/delete endpoints exist for tenants, documents, benchmark prompts, or benchmark runs. UI should not expose edit/delete actions.",
      "Agent-memory retrieval supports vector mode only; do not present keyword/hybrid options for agent-memory use cases."
    ]
  },
  "routes": [
    {
      "path": "/",
      "page_id": "tenant_setup",
      "default": true
    },
    {
      "path": "/tenants/:tenantId/documents",
      "page_id": "documents_library"
    },
    {
      "path": "/tenants/:tenantId/documents/:documentId/chunks",
      "page_id": "document_chunk_inspector"
    },
    {
      "path": "/tenants/:tenantId/search",
      "page_id": "document_search_playground"
    },
    {
      "path": "/tenants/:tenantId/agent-memory",
      "page_id": "agent_memory_playground"
    },
    {
      "path": "/tenants/:tenantId/benchmarks/prompts",
      "page_id": "benchmark_prompts"
    },
    {
      "path": "/tenants/:tenantId/benchmarks/prompts/:groundTruthId",
      "page_id": "benchmark_prompt_detail"
    },
    {
      "path": "/tenants/:tenantId/benchmarks/comparison",
      "page_id": "benchmark_comparison_dashboard"
    }
  ],
  "pages": [
    {
      "id": "tenant_setup",
      "route": "/",
      "purpose": "Create a tenant/demo context for the POV session before any document, retrieval, or benchmark actions can occur.",
      "data_requirements": [
        {
          "name": "tenant_creation_form",
          "source": "local form state",
          "fields": [
            "tenant_key",
            "display_name",
            "deployment_model",
            "cloud",
            "notes"
          ]
        }
      ],
      "api_endpoints_consumed": [
        {
          "endpoint": "createTenant",
          "method": "POST",
          "path": "/tenants",
          "usage": "Create the active tenant context and route into tenant-scoped screens."
        }
      ],
      "user_actions": [
        {
          "action": "create_tenant",
          "description": "Submit tenant/demo context form.",
          "api_call": "POST /tenants"
        },
        {
          "action": "proceed_to_documents",
          "description": "After success, navigate to documents library for the created tenant.",
          "api_call": null
        }
      ],
      "loading_states": [
        "Submitting tenant creation request disables form and shows inline progress."
      ],
      "error_states": [
        {
          "case": "validation_error",
          "api_error_code": "VALIDATION_ERROR",
          "ui_response": "Show field-level validation and form banner."
        },
        {
          "case": "tenant_key_conflict",
          "api_error_code": "TENANT_KEY_CONFLICT",
          "ui_response": "Show inline error on tenant_key and suggest a different key."
        },
        {
          "case": "network_or_unknown",
          "api_error_code": "UNKNOWN",
          "ui_response": "Show retryable global error banner."
        }
      ]
    },
    {
      "id": "documents_library",
      "route": "/tenants/:tenantId/documents",
      "purpose": "Browse recently ingested tenant documents and register new uploaded-file, benchmark-supporting, or agent-memory documents for the live session.",
      "data_requirements": [
        {
          "name": "document_list",
          "source": "GET /tenants/{tenantId}/documents",
          "fields": [
            "_id",
            "title",
            "original_filename",
            "document_type",
            "source_type",
            "processing_status",
            "storage_location_type",
            "ingested_at",
            "metadata.tags"
          ]
        },
        {
          "name": "document_filters",
          "source": "local UI state",
          "fields": [
            "document_types",
            "source_types",
            "processing_statuses",
            "limit"
          ]
        },
        {
          "name": "new_document_form",
          "source": "local form state",
          "fields": [
            "document_type",
            "source_type",
            "title",
            "original_filename",
            "mime_type",
            "source_uri",
            "storage_location_type",
            "raw_text",
            "metadata.author",
            "metadata.language",
            "metadata.tags",
            "metadata.created_by",
            "metadata.conversation_id",
            "metadata.session_id",
            "processing_status"
          ]
        }
      ],
      "api_endpoints_consumed": [
        {
          "endpoint": "listTenantDocuments",
          "method": "GET",
          "path": "/tenants/{tenantId}/documents",
          "usage": "Populate the document table with current filters."
        },
        {
          "endpoint": "createDocument",
          "method": "POST",
          "path": "/tenants/{tenantId}/documents",
          "usage": "Register a new document or memory record."
        }
      ],
      "user_actions": [
        {
          "action": "filter_documents",
          "description": "Apply document type, source type, status, and limit filters.",
          "api_call": "GET /tenants/{tenantId}/documents"
        },
        {
          "action": "create_document",
          "description": "Register a document using metadata, source_uri, and/or raw_text.",
          "api_call": "POST /tenants/{tenantId}/documents"
        },
        {
          "action": "inspect_chunks",
          "description": "Open chunk inspector for a selected document.",
          "api_call": null
        },
        {
          "action": "open_search_playground",
          "description": "Navigate to document search with selected documents pre-scoped client-side.",
          "api_call": null
        },
        {
          "action": "open_agent_memory_playground",
          "description": "Navigate to agent-memory screen when working with agent_memory docs.",
          "api_call": null
        }
      ],
      "loading_states": [
        "Initial document list loading with table skeleton.",
        "Filter refresh loading with retained previous results.",
        "New document submission loading on form/modal."
      ],
      "error_states": [
        {
          "case": "tenant_not_found",
          "api_error_code": "TENANT_NOT_FOUND",
          "ui_response": "Show tenant-scoped not-found state and link back to setup."
        },
        {
          "case": "validation_error_on_list",
          "api_error_code": "VALIDATION_ERROR",
          "ui_response": "Show filter validation message."
        },
        {
          "case": "validation_error_on_create",
          "api_error_code": "VALIDATION_ERROR",
          "ui_response": "Show field-level form errors including enum mismatches."
        },
        {
          "case": "network_or_unknown",
          "api_error_code": "UNKNOWN",
          "ui_response": "Show retry banner and preserve entered form data."
        }
      ]
    },
    {
      "id": "document_chunk_inspector",
      "route": "/tenants/:tenantId/documents/:documentId/chunks",
      "purpose": "Inspect read-only chunk outputs across chunking strategies for a selected document to support strategy comparison and troubleshooting.",
      "data_requirements": [
        {
          "name": "chunk_list",
          "source": "GET /tenants/{tenantId}/documents/{documentId}/chunks",
          "fields": [
            "_id",
            "document_id",
            "chunking_strategy",
            "strategy_params.chunk_size",
            "strategy_params.chunk_overlap",
            "strategy_params.separator_policy",
            "strategy_params.notes",
            "chunk_index",
            "text",
            "token_count",
            "page_span.start_page",
            "page_span.end_page",
            "embedding_model"
          ]
        },
        {
          "name": "chunk_filters",
          "source": "local UI state",
          "fields": [
            "chunking_strategies",
            "limit"
          ]
        }
      ],
      "api_endpoints_consumed": [
        {
          "endpoint": "inspectDocumentChunks",
          "method": "GET",
          "path": "/tenants/{tenantId}/documents/{documentId}/chunks",
          "usage": "Load chunks for selected strategies."
        }
      ],
      "user_actions": [
        {
          "action": "filter_chunk_strategies",
          "description": "Toggle one or more chunking strategies and reload chunks.",
          "api_call": "GET /tenants/{tenantId}/documents/{documentId}/chunks"
        },
        {
          "action": "change_limit",
          "description": "Increase/decrease returned chunk count within API max.",
          "api_call": "GET /tenants/{tenantId}/documents/{documentId}/chunks"
        },
        {
          "action": "open_search_playground",
          "description": "Navigate to search playground with current document context.",
          "api_call": null
        }
      ],
      "loading_states": [
        "Chunk table/list skeleton while loading.",
        "Strategy switch loading with optimistic filter chips."
      ],
      "error_states": [
        {
          "case": "document_not_found",
          "api_error_code": "DOCUMENT_NOT_FOUND",
          "ui_response": "Show not-found state and option to return to documents list."
        },
        {
          "case": "validation_error",
          "api_error_code": "VALIDATION_ERROR",
          "ui_response": "Show invalid strategy/filter message."
        },
        {
          "case": "no_chunks_available",
          "api_error_code": null,
          "ui_response": "Empty state indicating chunk generation is not exposed in the API and may not have completed yet."
        }
      ]
    },
    {
      "id": "document_search_playground",
      "route": "/tenants/:tenantId/search",
      "purpose": "Run and compare keyword, vector, and hybrid retrieval for document-search prompts over selected documents and chunking strategies.",
      "data_requirements": [
        {
          "name": "document_candidates",
          "source": "GET /tenants/{tenantId}/documents",
          "fields": [
            "_id",
            "title",
            "document_type",
            "source_type",
            "processing_status"
          ]
        },
        {
          "name": "search_form",
          "source": "local UI state",
          "fields": [
            "query_text",
            "retrieval_mode",
            "chunking_strategy",
            "document_ids",
            "limit"
          ]
        },
        {
          "name": "vector_query_embedding",
          "source": "external application service/local injected state",
          "fields": [
            "query_embedding"
          ],
          "notes": "Required for vector and hybrid modes; no embedding-generation API exists in the contract."
        },
        {
          "name": "search_results",
          "source": "search API response",
          "fields": [
            "rank",
            "document_id",
            "chunk_id",
            "score",
            "combined_score",
            "vector_score",
            "keyword_score",
            "snippet",
            "page_span",
            "document_title",
            "source_type",
            "document_type"
          ]
        }
      ],
      "api_endpoints_consumed": [
        {
          "endpoint": "listTenantDocuments",
          "method": "GET",
          "path": "/tenants/{tenantId}/documents",
          "usage": "Populate document selection controls."
        },
        {
          "endpoint": "runDocumentKeywordSearch",
          "method": "POST",
          "path": "/tenants/{tenantId}/retrieval/document-search/keyword",
          "usage": "Run keyword baseline retrieval."
        },
        {
          "endpoint": "runDocumentVectorSearch",
          "method": "POST",
          "path": "/tenants/{tenantId}/retrieval/document-search/vector",
          "usage": "Run semantic vector retrieval."
        },
        {
          "endpoint": "runHybridSearch",
          "method": "POST",
          "path": "/tenants/{tenantId}/retrieval/hybrid",
          "usage": "Run hybrid retrieval comparison."
        },
        {
          "endpoint": "recordBenchmarkRun",
          "method": "POST",
          "path": "/tenants/{tenantId}/benchmark-runs",
          "usage": "Persist a selected retrieval execution as benchmark evidence."
        }
      ],
      "user_actions": [
        {
          "action": "load_documents_for_scope",
          "description": "Load available docs that can be searched.",
          "api_call": "GET /tenants/{tenantId}/documents"
        },
        {
          "action": "run_keyword_search",
          "description": "Submit keyword retrieval.",
          "api_call": "POST /tenants/{tenantId}/retrieval/document-search/keyword"
        },
        {
          "action": "run_vector_search",
          "description": "Submit vector retrieval with externally supplied query embedding.",
          "api_call": "POST /tenants/{tenantId}/retrieval/document-search/vector"
        },
        {
          "action": "run_hybrid_search",
          "description": "Submit hybrid retrieval with externally supplied query embedding.",
          "api_call": "POST /tenants/{tenantId}/retrieval/hybrid"
        },
        {
          "action": "save_as_benchmark_run",
          "description": "Map current results and metrics into a persisted benchmark run tied to a selected ground truth.",
          "api_call": "POST /tenants/{tenantId}/benchmark-runs"
        },
        {
          "action": "open_benchmark_prompts",
          "description": "Navigate to prompt selection/creation if no ground truth exists yet.",
          "api_call": null
        }
      ],
      "loading_states": [
        "Document selector initial load.",
        "Search request in progress with disabled submit and spinner in results region.",
        "Benchmark run save in progress on modal/form."
      ],
      "error_states": [
        {
          "case": "tenant_not_found",
          "api_error_code": "TENANT_NOT_FOUND",
          "ui_response": "Show tenant not found state."
        },
        {
          "case": "validation_error_search",
          "api_error_code": "VALIDATION_ERROR",
          "ui_response": "Show missing query text, invalid chunking strategy, invalid document IDs, or missing query_embedding for vector/hybrid."
        },
        {
          "case": "missing_embedding_capability",
          "api_error_code": null,
          "ui_response": "Show frontend warning that vector/hybrid search requires an embedding from an external service not provided by this API."
        },
        {
          "case": "ground_truth_not_found_on_save",
          "api_error_code": "GROUND_TRUTH_NOT_FOUND",
          "ui_response": "Prompt user to select/create a valid benchmark prompt."
        },
        {
          "case": "no_results",
          "api_error_code": null,
          "ui_response": "Show empty results state with option to change strategy or retrieval mode."
        }
      ]
    },
    {
      "id": "agent_memory_playground",
      "route": "/tenants/:tenantId/agent-memory",
      "purpose": "Evaluate vector-only retrieval over conversation-derived memory documents scoped by conversation or session.",
      "data_requirements": [
        {
          "name": "memory_scope_form",
          "source": "local UI state",
          "fields": [
            "conversation_id",
            "session_id",
            "chunking_strategy",
            "query_text"
          ]
        },
        {
          "name": "memory_documents",
          "source": "GET /tenants/{tenantId}/agent-memory",
          "fields": [
            "_id",
            "title",
            "source_type",
            "metadata.conversation_id",
            "metadata.session_id",
            "processing_status",
            "ingested_at",
            "updated_at"
          ]
        },
        {
          "name": "vector_query_embedding",
          "source": "external application service/local injected state",
          "fields": [
            "query_embedding"
          ],
          "notes": "Required because the contract has no embedding-generation endpoint."
        },
        {
          "name": "memory_results",
          "source": "POST /tenants/{tenantId}/retrieval/agent-memory/vector",
          "fields": [
            "rank",
            "document_id",
            "chunk_id",
            "score",
            "snippet",
            "conversation_id",
            "session_id",
            "updated_at"
          ]
        }
      ],
      "api_endpoints_consumed": [
        {
          "endpoint": "listAgentMemoryDocuments",
          "method": "GET",
          "path": "/tenants/{tenantId}/agent-memory",
          "usage": "Load memory docs for a conversation or session scope."
        },
        {
          "endpoint": "createDocument",
          "method": "POST",
          "path": "/tenants/{tenantId}/documents",
          "usage": "Register new agent-memory documents."
        },
        {
          "endpoint": "runAgentMemoryVectorRetrieval",
          "method": "POST",
          "path": "/tenants/{tenantId}/retrieval/agent-memory/vector",
          "usage": "Run vector-only memory retrieval."
        },
        {
          "endpoint": "recordBenchmarkRun",
          "method": "POST",
          "path": "/tenants/{tenantId}/benchmark-runs",
          "usage": "Persist agent-memory benchmark evidence."
        }
      ],
      "user_actions": [
        {
          "action": "create_agent_memory_document",
          "description": "Register conversation-derived document with conversation_id and/or session_id metadata.",
          "api_call": "POST /tenants/{tenantId}/documents"
        },
        {
          "action": "load_memory_documents",
          "description": "List existing memory docs for a conversation or session.",
          "api_call": "GET /tenants/{tenantId}/agent-memory"
        },
        {
          "action": "run_memory_vector_retrieval",
          "description": "Submit vector retrieval for agent memory.",
          "api_call": "POST /tenants/{tenantId}/retrieval/agent-memory/vector"
        },
        {
          "action": "save_as_benchmark_run",
          "description": "Persist current retrieval output against an agent_memory ground truth.",
          "api_call": "POST /tenants/{tenantId}/benchmark-runs"
        }
      ],
      "loading_states": [
        "Scoped memory document list loading.",
        "Memory retrieval request in progress.",
        "Benchmark save loading."
      ],
      "error_states": [
        {
          "case": "validation_error_scope",
          "api_error_code": "VALIDATION_ERROR",
          "ui_response": "Require either conversation_id or session_id before listing or retrieval."
        },
        {
          "case": "missing_embedding_capability",
          "api_error_code": null,
          "ui_response": "Explain that vector retrieval requires external embedding generation."
        },
        {
          "case": "unsupported_mode",
          "api_error_code": null,
          "ui_response": "Hide or disable keyword/hybrid choices because the API only supports vector retrieval for agent memory."
        },
        {
          "case": "tenant_not_found",
          "api_error_code": "TENANT_NOT_FOUND",
          "ui_response": "Show tenant not found state."
        }
      ]
    },
    {
      "id": "benchmark_prompts",
      "route": "/tenants/:tenantId/benchmarks/prompts",
      "purpose": "Create and browse customer-provided benchmark prompts/ground truths for document-search and agent-memory evaluations.",
      "data_requirements": [
        {
          "name": "task_type_filter",
          "source": "local UI state",
          "fields": [
            "task_type",
            "provided_during_session"
          ]
        },
        {
          "name": "prompt_list",
          "source": "GET /tenants/{tenantId}/benchmark-ground-truths",
          "fields": [
            "_id",
            "prompt_text",
            "task_type",
            "ground_truth_text",
            "relevant_document_ids",
            "relevant_chunk_ids",
            "top_k_targets",
            "notes",
            "created_at"
          ]
        },
        {
          "name": "new_prompt_form",
          "source": "local form state",
          "fields": [
            "prompt_text",
            "task_type",
            "ground_truth_text",
            "relevant_document_ids",
            "relevant_chunk_ids",
            "top_k_targets",
            "provided_during_session",
            "notes"
          ]
        }
      ],
      "api_endpoints_consumed": [
        {
          "endpoint": "listBenchmarkGroundTruths",
          "method": "GET",
          "path": "/tenants/{tenantId}/benchmark-ground-truths",
          "usage": "List prompts for a chosen task type. Use default provided_during_session=true behavior."
        },
        {
          "endpoint": "createBenchmarkGroundTruth",
          "method": "POST",
          "path": "/tenants/{tenantId}/benchmark-ground-truths",
          "usage": "Create a new benchmark prompt entered during the live session."
        },
        {
          "endpoint": "listTenantDocuments",
          "method": "GET",
          "path": "/tenants/{tenantId}/documents",
          "usage": "Populate relevant document selection in the creation form when needed."
        }
      ],
      "user_actions": [
        {
          "action": "switch_task_type",
          "description": "Toggle between document_search and agent_memory prompt sets.",
          "api_call": "GET /tenants/{tenantId}/benchmark-ground-truths"
        },
        {
          "action": "create_prompt",
          "description": "Create a new benchmark ground truth.",
          "api_call": "POST /tenants/{tenantId}/benchmark-ground-truths"
        },
        {
          "action": "open_prompt_detail",
          "description": "Navigate to detail/history for a selected prompt.",
          "api_call": null
        },
        {
          "action": "open_comparison_dashboard",
          "description": "Navigate with selected prompt IDs for side-by-side comparison.",
          "api_call": null
        }
      ],
      "loading_states": [
        "Prompt list initial load and task-type switch loading.",
        "Prompt creation submit loading.",
        "Optional document selector loading for relevant_document_ids."
      ],
      "error_states": [
        {
          "case": "validation_error_list",
          "api_error_code": "VALIDATION_ERROR",
          "ui_response": "Require valid task_type."
        },
        {
          "case": "validation_error_create",
          "api_error_code": "VALIDATION_ERROR",
          "ui_response": "Show field errors for prompt form."
        },
        {
          "case": "tenant_not_found",
          "api_error_code": "TENANT_NOT_FOUND",
          "ui_response": "Show tenant not found state."
        },
        {
          "case": "empty_prompt_list",
          "api_error_code": null,
          "ui_response": "Show empty state encouraging live prompt creation."
        }
      ]
    },
    {
      "id": "benchmark_prompt_detail",
      "route": "/tenants/:tenantId/benchmarks/prompts/:groundTruthId",
      "purpose": "Inspect a specific benchmark prompt's expected relevant documents/chunks and recent benchmark run history.",
      "data_requirements": [
        {
          "name": "prompt_detail",
          "source": "GET /tenants/{tenantId}/benchmark-ground-truths/{groundTruthId}",
          "fields": [
            "benchmark_ground_truth._id",
            "benchmark_ground_truth.prompt_text",
            "benchmark_ground_truth.task_type",
            "benchmark_ground_truth.ground_truth_text",
            "benchmark_ground_truth.top_k_targets",
            "benchmark_ground_truth.relevant_documents",
            "benchmark_ground_truth.relevant_chunks"
          ]
        },
        {
          "name": "run_history",
          "source": "GET /tenants/{tenantId}/benchmark-ground-truths/{groundTruthId}/runs",
          "fields": [
            "_id",
            "system_under_test",
            "retrieval_mode",
            "chunking_strategy",
            "embedding_model",
            "metrics",
            "top_k_results",
            "run_label",
            "run_timestamp",
            "notes"
          ]
        }
      ],
      "api_endpoints_consumed": [
        {
          "endpoint": "getBenchmarkGroundTruthDetail",
          "method": "GET",
          "path": "/tenants/{tenantId}/benchmark-ground-truths/{groundTruthId}",
          "usage": "Load expected targets and explanation context for the prompt."
        },
        {
          "endpoint": "getBenchmarkPromptHistory",
          "method": "GET",
          "path": "/tenants/{tenantId}/benchmark-ground-truths/{groundTruthId}/runs",
          "usage": "Load benchmark execution history."
        }
      ],
      "user_actions": [
        {
          "action": "refresh_prompt_detail",
          "description": "Reload the prompt detail and recent runs.",
          "api_call": "GET detail + GET runs"
        },
        {
          "action": "navigate_to_comparison",
          "description": "Open comparison dashboard seeded with this prompt ID.",
          "api_call": null
        },
        {
          "action": "navigate_to_search_or_memory_playground",
          "description": "Return to the appropriate playground based on task_type to run another test.",
          "api_call": null
        }
      ],
      "loading_states": [
        "Detail skeleton load.",
        "Run history table skeleton load.",
        "Manual refresh loading state."
      ],
      "error_states": [
        {
          "case": "ground_truth_not_found_detail",
          "api_error_code": "GROUND_TRUTH_NOT_FOUND",
          "ui_response": "Show not-found state and link back to prompt list."
        },
        {
          "case": "ground_truth_not_found_runs",
          "api_error_code": "GROUND_TRUTH_NOT_FOUND",
          "ui_response": "Show run-history unavailable state."
        },
        {
          "case": "network_or_unknown",
          "api_error_code": "UNKNOWN",
          "ui_response": "Show retry banner."
        }
      ]
    },
    {
      "id": "benchmark_comparison_dashboard",
      "route": "/tenants/:tenantId/benchmarks/comparison",
      "purpose": "Present side-by-side benchmark evidence across selected prompts and rolled-up performance summaries over a time window.",
      "data_requirements": [
        {
          "name": "selected_ground_truth_ids",
          "source": "route state/local UI state",
          "fields": [
            "ground_truth_ids"
          ]
        },
        {
          "name": "comparison_rows",
          "source": "POST /tenants/{tenantId}/benchmark-runs/compare",
          "fields": [
            "ground_truth_id",
            "prompt_text",
            "system_under_test",
            "retrieval_mode",
            "chunking_strategy",
            "embedding_model",
            "latency_ms",
            "precision_at_k",
            "recall_at_k",
            "result_count",
            "top_k_results",
            "run_timestamp"
          ]
        },
        {
          "name": "summary_window",
          "source": "local UI state",
          "fields": [
            "start_time",
            "end_time"
          ]
        },
        {
          "name": "summary_rows",
          "source": "GET /tenants/{tenantId}/benchmark-runs/summary",
          "fields": [
            "system_under_test",
            "retrieval_mode",
            "chunking_strategy",
            "avg_latency_ms",
            "avg_precision_at_1",
            "avg_precision_at_5",
            "avg_precision_at_10",
            "avg_precision_at_20",
            "avg_recall_at_1",
            "avg_recall_at_5",
            "avg_recall_at_10",
            "avg_recall_at_20",
            "run_count"
          ]
        }
      ],
      "api_endpoints_consumed": [
        {
          "endpoint": "compareBenchmarkRuns",
          "method": "POST",
          "path": "/tenants/{tenantId}/benchmark-runs/compare",
          "usage": "Load side-by-side run evidence for selected prompts."
        },
        {
          "endpoint": "summarizeBenchmarkPerformance",
          "method": "GET",
          "path": "/tenants/{tenantId}/benchmark-runs/summary",
          "usage": "Load rolled-up averages across a time window."
        }
      ],
      "user_actions": [
        {
          "action": "compare_selected_prompts",
          "description": "Submit one or more prompt IDs for side-by-side evidence.",
          "api_call": "POST /tenants/{tenantId}/benchmark-runs/compare"
        },
        {
          "action": "load_summary",
          "description": "Request aggregate benchmark summary for a chosen time window.",
          "api_call": "GET /tenants/{tenantId}/benchmark-runs/summary"
        },
        {
          "action": "view_prompt_detail",
          "description": "Navigate from a comparison row to prompt detail/history.",
          "api_call": null
        }
      ],
      "loading_states": [
        "Comparison load spinner/table skeleton.",
        "Summary cards/table loading after time window submission."
      ],
      "error_states": [
        {
          "case": "validation_error_compare",
          "api_error_code": "VALIDATION_ERROR",
          "ui_response": "Require at least one prompt selection."
        },
        {
          "case": "ground_truths_not_found",
          "api_error_code": "GROUND_TRUTHS_NOT_FOUND",
          "ui_response": "Show no matching prompts/runs found state."
        },
        {
          "case": "validation_error_summary",
          "api_error_code": "VALIDATION_ERROR",
          "ui_response": "Show invalid time window message."
        },
        {
          "case": "no_runs_found",
          "api_error_code": "NO_RUNS_FOUND",
          "ui_response": "Show empty summary state for the selected window."
        }
      ]
    }
  ],

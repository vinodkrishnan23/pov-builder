        },
        {
          "action": "search_memories",
          "effect": "POST retrieval query and display ranked memories"
        }
      ],
      "loading_states": [
        "Separate loading states for create and search panels."
      ],
      "error_states": [
        {
          "condition": "400 INVALID_REQUEST on create",

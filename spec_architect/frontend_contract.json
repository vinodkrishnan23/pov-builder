{
  "routes": [
    {
      "path": "/",
      "screen_id": "tenant_setup",
      "page_title": "Tenant Setup",
      "auth_scope": "global"
    },
    {
      "path": "/tenants/:tenantId",
      "screen_id": "tenant_workspace",
      "page_title": "Tenant Workspace",
      "auth_scope": "tenant"
    },
    {
      "path": "/tenants/:tenantId/documents/new",
      "screen_id": "register_document",
      "page_title": "Register Document",
      "auth_scope": "tenant"
    },
    {
      "path": "/tenants/:tenantId/documents/:documentId/extraction",
      "screen_id": "document_extraction_update",
      "page_title": "Update Document Extraction",
      "auth_scope": "tenant"
    },
    {
      "path": "/tenants/:tenantId/documents/:documentId/chunks",
      "screen_id": "document_chunking_upload",
      "page_title": "Upload Document Chunks",
      "auth_scope": "tenant"
    },
    {
      "path": "/tenants/:tenantId/search/documents",
      "screen_id": "document_search_playground",
      "page_title": "Document Search Playground",
      "auth_scope": "tenant"
    },
    {
      "path": "/tenants/:tenantId/documents/:documentId/inspect",
      "screen_id": "document_inspection",
      "page_title": "Document Inspection",
      "auth_scope": "tenant",
      "query_params": [
        "chunking_strategy"
      ]
    },
    {
      "path": "/tenants/:tenantId/agent-memory/new",
      "screen_id": "agent_memory_ingestion",
      "page_title": "Agent Memory Ingestion",
      "auth_scope": "tenant"
    },
    {
      "path": "/tenants/:tenantId/agent-memory/search",
      "screen_id": "agent_memory_search",
      "page_title": "Agent Memory Search",
      "auth_scope": "tenant"
    },
    {
      "path": "/tenants/:tenantId/benchmarks/queries",
      "screen_id": "benchmark_query_manager",
      "page_title": "Benchmark Queries",
      "auth_scope": "tenant"
    },
    {
      "path": "/tenants/:tenantId/benchmarks/runs/new",
      "screen_id": "benchmark_run_builder",
      "page_title": "Benchmark Run Builder",
      "auth_scope": "tenant"
    },
    {
      "path": "/tenants/:tenantId/benchmarks/runs/:runId/entry",
      "screen_id": "benchmark_result_entry",
      "page_title": "Benchmark Result Entry",
      "auth_scope": "tenant"
    },
    {
      "path": "/tenants/:tenantId/benchmarks/compare",
      "screen_id": "benchmark_comparison",
      "page_title": "Benchmark Comparison",
      "auth_scope": "tenant"
    },
    {
      "path": "/tenants/:tenantId/benchmarks/runs/:runId",
      "screen_id": "benchmark_run_detail",
      "page_title": "Benchmark Run Detail",
      "auth_scope": "tenant"
    }
  ],
  "pages": [
    {
      "screen_id": "tenant_setup",
      "purpose": "Create a new tenant/deployment record or load an existing tenant by known ID so all subsequent workflows are tenant-scoped.",
      "data_requirements": {
        "reads": [],
        "writes": [
          "tenant_key",
          "display_name",
          "deployment_mode",
          "cloud",
          "status",
          "existing_tenant_id input only for navigation"
        ]
      },
      "api_consumes": [
        {
          "operation_id": "createTenant",
          "usage": "Create tenant from form input."
        },
        {
          "operation_id": "getTenant",
          "usage": "Validate and load an existing tenant when user enters/pastes a tenant ID."
        }
      ],
      "user_actions": [
        {
          "action": "create_tenant",
          "api": "createTenant"
        },
        {
          "action": "open_existing_tenant",
          "api": "getTenant"
        },
        {
          "action": "copy_tenant_id",
          "api": null
        }
      ],
      "loading_states": [
        "Submitting tenant creation.",
        "Loading tenant by ID."
      ],
      "error_states": [
        "Validation errors for missing/invalid tenant fields.",
        "409 tenant key conflict on create.",
        "Invalid tenant ID format.",
        "Tenant not found for entered ID."
      ],
      "notes": [
        "No API exists to list tenants; UI must require create or direct ID entry."
      ]
    },
    {
      "screen_id": "tenant_workspace",
      "purpose": "Serve as the tenant-scoped landing page showing deployment details and ingestion readiness for workshop/demo preparation.",
      "data_requirements": {
        "reads": [
          "tenant.id",
          "tenant.display_name",
          "tenant.tenant_key",
          "tenant.deployment_mode",
          "tenant.cloud",
          "tenant.status",
          "tenant.created_at",
          "readiness summary by source_type and extraction_status"
        ],
        "writes": []
      },
      "api_consumes": [
        {
          "operation_id": "getTenant",
          "usage": "Load tenant header/details."
        },
        {
          "operation_id": "getIngestionReadinessSummary",
          "usage": "Show counts of pending/processing/completed/failed documents by source type."
        }
      ],
      "user_actions": [
        {
          "action": "refresh_readiness",
          "api": "getIngestionReadinessSummary"
        },
        {
          "action": "navigate_to_register_document",
          "api": null
        },
        {
          "action": "navigate_to_document_search",
          "api": null
        },
        {
          "action": "navigate_to_agent_memory",
          "api": null
        },
        {
          "action": "navigate_to_benchmarks",
          "api": null
        }
      ],
      "loading_states": [
        "Loading tenant details.",
        "Loading readiness summary."
      ],
      "error_states": [
        "Tenant not found.",
        "Invalid tenant ID.",
        "Failed readiness summary retrieval."
      ],
      "notes": [
        "Because there is no document list endpoint, readiness summary is the only dashboard-style document overview available from the API."
      ]
    },
    {
      "screen_id": "register_document",
      "purpose": "Register document metadata and external storage URI for live uploads, seeded content, or baseline imports.",
      "data_requirements": {
        "reads": [
          "tenantId from route"
        ],
        "writes": [
          "source_type",
          "title",
          "file_name",
          "mime_type",
          "file_size_bytes",
          "storage.provider",
          "storage.uri",
          "metadata.source_system",
          "metadata.uploaded_by",
          "metadata.tags",
          "metadata.language",
          "metadata.page_count"
        ]
      },
      "api_consumes": [
        {
          "operation_id": "createDocumentMetadata",
          "usage": "Create document record before extraction/chunking."
        }
      ],
      "user_actions": [
        {
          "action": "submit_document_metadata",
          "api": "createDocumentMetadata"
        },
        {
          "action": "save_and_go_to_extraction",
          "api": "createDocumentMetadata"
        }
      ],
      "loading_states": [
        "Submitting document metadata."
      ],
      "error_states": [
        "Validation errors for required title/source type or malformed storage object.",
        "Tenant not found."
      ],
      "notes": [
        "No binary upload endpoint exists; UI must explicitly ask for external storage URI or allow provider=none only if supported by backend validation."
      ]
    },
    {
      "screen_id": "document_extraction_update",
      "purpose": "Update extraction progress and extracted content for a specific document after external parsing/application-layer orchestration.",
      "data_requirements": {
        "reads": [
          "tenantId and documentId from route"
        ],
        "writes": [
          "status",
          "extracted_text",
          "content_preview",
          "error_message"
        ]
      },
      "api_consumes": [
        {
          "operation_id": "updateDocumentExtraction",
          "usage": "Persist extraction status and extracted text/preview/error."
        }
      ],
      "user_actions": [
        {
          "action": "mark_processing",
          "api": "updateDocumentExtraction"
        },
        {
          "action": "mark_completed",
          "api": "updateDocumentExtraction"
        },
        {
          "action": "mark_failed",
          "api": "updateDocumentExtraction"
        },
        {
          "action": "proceed_to_chunk_upload",
          "api": null
        }
      ],
      "loading_states": [
        "Saving extraction update."
      ],
      "error_states": [
        "Validation error for invalid extraction payload.",
        "Document not found for tenant."
      ],
      "notes": [
        "There is no GET endpoint for document metadata without chunking strategy except inspection; this screen should rely on route context/local state from document creation where possible."
      ]
    },
    {
      "screen_id": "document_chunking_upload",
      "purpose": "Persist generated chunks and embeddings for one document under one selected chunking strategy.",
      "data_requirements": {
        "reads": [
          "tenantId",
          "documentId"
        ],
        "writes": [
          "chunks[].chunking_strategy",
          "chunks[].chunk_index",
          "chunks[].text",
          "chunks[].token_count",
          "chunks[].page_span",
          "chunks[].embedding_model",
          "chunks[].embedding",
          "chunks[].embedding_dimensions"
        ]
      },
      "api_consumes": [
        {
          "operation_id": "createDocumentChunks",
          "usage": "Batch create chunks for a document and strategy."
        }
      ],
      "user_actions": [
        {
          "action": "upload_chunk_batch",
          "api": "createDocumentChunks"
        },
        {
          "action": "upload_another_strategy",
          "api": "createDocumentChunks"
        },
        {
          "action": "inspect_document_strategy",
          "api": "getDocumentInspection"
        }
      ],
      "loading_states": [
        "Submitting chunk batch."
      ],
      "error_states": [
        "Validation error for malformed chunk payload.",
        "Document not found for tenant."
      ],
      "notes": [
        "No endpoint exists to delete/replace chunks, so UI should warn before re-submitting a strategy and avoid implying overwrite support."
      ]
    },
    {
      "screen_id": "document_search_playground",
      "purpose": "Run text, vector, and hybrid search over tenant documents to evaluate retrieval quality and behavior.",
      "data_requirements": {
        "reads": [
          "search mode",
          "text query",
          "query embedding from app-layer embedder",
          "chunking strategy",
          "top_k",
          "num_candidates",
          "vector_limit for hybrid",
          "filters.language",
          "filters.tag",
          "filters.source_type",
          "search results"
        ],
        "writes": []
      },
      "api_consumes": [
        {
          "operation_id": "textSearchDocuments",
          "usage": "Keyword/text search mode."
        },
        {
          "operation_id": "vectorSearchDocumentChunks",
          "usage": "Semantic search mode over one chunking strategy."
        },
        {
          "operation_id": "hybridDocumentSearch",
          "usage": "Semantic + metadata-filtered search mode."
        }
      ],
      "user_actions": [
        {
          "action": "run_text_search",
          "api": "textSearchDocuments"
        },
        {
          "action": "run_vector_search",
          "api": "vectorSearchDocumentChunks"
        },
        {
          "action": "run_hybrid_search",
          "api": "hybridDocumentSearch"
        },
        {
          "action": "change_chunking_strategy_and_rerun",
          "api": "vectorSearchDocumentChunks"
        },
        {
          "action": "open_document_inspection",
          "api": "getDocumentInspection"
        }
      ],
      "loading_states": [
        "Running text search.",
        "Running vector search.",
        "Running hybrid search."
      ],
      "error_states": [
        "Validation error for missing q/top_k.",
        "Validation error for invalid vector/hybrid payload.",
        "Tenant not found.",
        "No results state for each search mode."
      ],
      "notes": [
        "API requires query_embedding for vector/hybrid search; frontend must obtain embeddings from an application-layer service not defined in this contract."
      ]
    },
    {
      "screen_id": "document_inspection",
      "purpose": "Inspect one document and its chunks for a selected chunking strategy to understand chunk boundaries and retrieval context.",
      "data_requirements": {
        "reads": [
          "document title",
          "file_name",
          "metadata",
          "content_preview",
          "chunks[].chunk_index",
          "chunks[].text",
          "chunks[].page_span",
          "chunks[].token_count",
          "chunks[].embedding_model",
          "chunking_strategy query param"
        ],
        "writes": []
      },
      "api_consumes": [
        {
          "operation_id": "getDocumentInspection",
          "usage": "Load document details and chunks for one strategy."
        }
      ],
      "user_actions": [
        {
          "action": "change_chunking_strategy",
          "api": "getDocumentInspection"
        },
        {
          "action": "return_to_search",
          "api": null
        }
      ],
      "loading_states": [
        "Loading document inspection."
      ],
      "error_states": [
        "Missing/invalid chunking strategy.",
        "Document not found for tenant."
      ],
      "notes": [
        "Useful for manual comparison across fixed_length, recursive, semantic, and contextual chunking because no aggregate comparison endpoint exists."
      ]
    },
    {
      "screen_id": "agent_memory_ingestion",
      "purpose": "Create conversational memory/context records for a tenant and session.",
      "data_requirements": {
        "reads": [
          "tenantId"
        ],
        "writes": [
          "session_id",
          "memory_type",
          "speaker_role",
          "content",
          "embedding_model",
          "embedding",
          "embedding_dimensions",
          "source_event_time",
          "metadata.agent_id",
          "metadata.conversation_id",
          "metadata.turn_index",
          "metadata.tags"
        ]
      },
      "api_consumes": [
        {
          "operation_id": "createAgentMemory",
          "usage": "Persist one memory item with embedding."
        }
      ],
      "user_actions": [
        {
          "action": "create_memory_item",
          "api": "createAgentMemory"
        },
        {
          "action": "create_another_memory_item",
          "api": "createAgentMemory"
        },
        {
          "action": "go_to_memory_search",
          "api": null
        }
      ],
      "loading_states": [
        "Submitting memory item."
      ],
      "error_states": [
        "Validation error for invalid memory payload.",
        "Tenant not found."
      ],
      "notes": [
        "Embedding generation is outside this API contract and must be handled by the application layer."
      ]
    },
    {
      "screen_id": "agent_memory_search",
      "purpose": "Retrieve semantically relevant agent memory items and show recent timeline context for a session.",
      "data_requirements": {
        "reads": [
          "query embedding",
          "optional session_id",
          "top_k",
          "num_candidates",
          "vector search results",
          "timeline session_id",
          "timeline limit",
          "recent timeline entries"
        ],
        "writes": []
      },
      "api_consumes": [
        {
          "operation_id": "vectorSearchAgentMemory",
          "usage": "Semantic retrieval over memory items."
        },
        {
          "operation_id": "getRecentAgentMemoryTimeline",
          "usage": "Show recency context for a session."
        }
      ],
      "user_actions": [
        {
          "action": "run_memory_search",
          "api": "vectorSearchAgentMemory"
        },
        {
          "action": "load_session_timeline",
          "api": "getRecentAgentMemoryTimeline"
        },
        {
          "action": "search_with_session_filter",
          "api": "vectorSearchAgentMemory"
        }
      ],
      "loading_states": [
        "Running memory search.",
        "Loading memory timeline."
      ],
      "error_states": [
        "Validation error for invalid search payload.",
        "Tenant not found.",
        "Missing session_id or invalid limit for timeline.",
        "No results state."
      ],
      "notes": [
        "Search can be tenant-wide or session-scoped; timeline requires session_id and is recency-based rather than semantic."
      ]
    },
    {
      "screen_id": "benchmark_query_manager",
      "purpose": "Create and review benchmark prompts, ground truth, and cutoffs for document search or agent memory evaluation.",
      "data_requirements": {
        "reads": [
          "selected query_type",
          "benchmark query list"
        ],
        "writes": [
          "query_text",
          "query_type",
          "provided_during_session",
          "ground_truth.relevant_document_ids",
          "ground_truth.relevant_chunk_ids",
          "ground_truth.relevant_memory_ids",
          "ground_truth.notes",
          "evaluation_cutoffs"
        ]
      },
      "api_consumes": [
        {
          "operation_id": "createBenchmarkQuery",
          "usage": "Create benchmark query."
        },
        {
          "operation_id": "listBenchmarkQueries",
          "usage": "List benchmark queries by query_type."
        }
      ],
      "user_actions": [
        {
          "action": "create_benchmark_query",
          "api": "createBenchmarkQuery"
        },
        {
          "action": "filter_queries_by_type",
          "api": "listBenchmarkQueries"
        },
        {
          "action": "refresh_query_list",
          "api": "listBenchmarkQueries"
        }
      ],
      "loading_states": [
        "Submitting benchmark query.",
        "Loading benchmark query list."
      ],
      "error_states": [
        "Validation error for invalid benchmark query payload.",
        "Tenant not found on create.",
        "Missing or invalid query_type on list.",
        "Empty state when no benchmark queries exist."
      ],
      "notes": [
        "Ground truth supports documents, chunks, or memory IDs depending on workload type."
      ]
    },
    {
      "screen_id": "benchmark_run_builder",
      "purpose": "Create a benchmark run configuration for one system under test and workload.",
      "data_requirements": {
        "reads": [
          "optional benchmark queries filtered by type to help select query_set_id if app tracks it externally"
        ],
        "writes": [
          "run_name",
          "workload_type",
          "system_under_test",
          "baseline_group",
          "configuration.embedding_model",
          "configuration.chunking_strategy",
          "configuration.top_k_values",
          "configuration.reranking_enabled",
          "query_set_id",
          "notes"
        ]
      },
      "api_consumes": [
        {
          "operation_id": "createBenchmarkRun",
          "usage": "Create run configuration."
        },
        {
          "operation_id": "listBenchmarkQueries",
          "usage": "Optionally review available query records by type before creating run."
        }
      ],
      "user_actions": [
        {
          "action": "load_queries_for_workload",
          "api": "listBenchmarkQueries"
        },
        {
          "action": "create_benchmark_run",
          "api": "createBenchmarkRun"
        }
      ],
      "loading_states": [
        "Loading benchmark queries by type.",
        "Submitting benchmark run."
      ],
      "error_states": [
        "Validation error for invalid run payload.",
        "Tenant not found.",
        "No API exists to list benchmark runs, so only newly created or directly linked runs are accessible from this screen."
      ],
      "notes": [
        "query_set_id can be captured if the app groups queries externally; API does not provide query-set management beyond individual benchmark query records."
      ]
    },
    {
      "screen_id": "benchmark_result_entry",
      "purpose": "Capture per-query outputs and metrics for a specific benchmark run, then complete the run with aggregate metrics.",
      "data_requirements": {
        "reads": [
          "runId from route",
          "benchmark queries by workload type if user loads guidance",
          "entered per-query result rows",
          "aggregate summary metrics"
        ],
        "writes": [
          "benchmark_query_id",
          "latency_ms",
          "top_k_results[].rank",
          "top_k_results[].result_type",
          "top_k_results[].result_id",
          "top_k_results[].document_id",
          "top_k_results[].score",
          "top_k_results[].snippet",
          "metrics.precision_at_k",
          "metrics.recall_at_k",
          "metrics.mrr",
          "metrics.ndcg",
          "summary_metrics.precision_at_k",
          "summary_metrics.recall_at_k",
          "summary_metrics.avg_latency_ms",
          "summary_metrics.p95_latency_ms",
          "summary_metrics.result_count"
        ]
      },
      "api_consumes": [
        {
          "operation_id": "createBenchmarkResult",
          "usage": "Store per-query result and metrics."
        },
        {
          "operation_id": "completeBenchmarkRun",
          "usage": "Finalize run with aggregate metrics."
        },
        {
          "operation_id": "getBenchmarkRunDetails",
          "usage": "Reload already-entered per-query results for the run."
        },
        {
          "operation_id": "listBenchmarkQueries",
          "usage": "Guide result entry by loading benchmark questions for a selected type if needed."
        }
      ],
      "user_actions": [
        {
          "action": "save_query_result",
          "api": "createBenchmarkResult"
        },
        {
          "action": "reload_run_results",
          "api": "getBenchmarkRunDetails"
        },
        {
          "action": "complete_run",
          "api": "completeBenchmarkRun"
        }
      ],
      "loading_states": [
        "Saving benchmark result.",
        "Loading existing run details.",
        "Completing benchmark run."
      ],
      "error_states": [
        "Validation error for result payload.",
        "Benchmark run not found.",
        "Validation error for summary metrics.",
        "Empty state when no results have been entered yet."
      ],
      "notes": [
        "API does not expose run metadata fetch directly; this screen should carry run context from creation/navigation and use run details endpoint for entered results."
      ]
    },
    {
      "screen_id": "benchmark_comparison",
      "purpose": "Show side-by-side completed benchmark outcomes across systems and chunking strategies for a workload and comparison group.",
      "data_requirements": {
        "reads": [
          "workload_type",
          "baseline_group",
          "comparison rows with system_under_test, chunking_strategy, embedding_model, top_k_values, avg_latency_ms, p95_latency_ms, precision_at_k, recall_at_k"
        ],
        "writes": []
      },
      "api_consumes": [
        {
          "operation_id": "compareBenchmarkRuns",
          "usage": "Load side-by-side completed comparison for one workload and baseline group."
        }
      ],
      "user_actions": [
        {
          "action": "run_comparison",
          "api": "compareBenchmarkRuns"
        },
        {
          "action": "change_workload_or_group",
          "api": "compareBenchmarkRuns"
        }
      ],
      "loading_states": [
        "Loading benchmark comparison."
      ],
      "error_states": [
        "Missing/invalid workload_type or baseline_group.",
        "Empty state when no completed runs exist for selection."
      ],
      "notes": [
        "Comparison response does not include run IDs, so direct drill-down to run detail is only possible if the app has saved run IDs from prior actions elsewhere."
      ]
    },
    {
      "screen_id": "benchmark_run_detail",
      "purpose": "Inspect per-query benchmark behavior, latency, and ranked outputs for one run.",
      "data_requirements": {
        "reads": [
          "results[].benchmark_query_id",
          "results[].query_text",
          "results[].query_type",
          "results[].latency_ms",
          "results[].precision_at_k",
          "results[].recall_at_k",
          "results[].mrr",
          "results[].ndcg",
          "results[].top_k_results"
        ],
        "writes": []
      },
      "api_consumes": [
        {
          "operation_id": "getBenchmarkRunDetails",
          "usage": "Load per-query outputs for one run."
        }
      ],
      "user_actions": [
        {
          "action": "refresh_run_details",
          "api": "getBenchmarkRunDetails"
        }
      ],
      "loading_states": [
        "Loading benchmark run details."
      ],
      "error_states": [
        "Invalid tenantId or runId.",
        "Benchmark run not found.",
        "Empty state when run has no stored results yet."
      ],
      "notes": [
        "This screen focuses on detailed inspection; aggregate comparison belongs on Benchmark Comparison Screen."
      ]
    }
  ],
  "components": [
    {
      "component_id": "TenantCreateForm",
      "purpose": "Collect tenant creation fields and submit createTenant.",
      "used_on": [
        "tenant_setup"
      ]
    },
    {
      "component_id": "TenantIdLoader",
      "purpose": "Accept pasted tenant ID and validate/load tenant.",
      "used_on": [
        "tenant_setup"
      ]
    },
    {
      "component_id": "TenantHeader",
      "purpose": "Display tenant identity and deployment metadata.",
      "used_on": [
        "tenant_workspace",
        "register_document",
        "document_search_playground",
        "agent_memory_ingestion",
        "benchmark_query_manager",
        "benchmark_run_builder",
        "benchmark_comparison"

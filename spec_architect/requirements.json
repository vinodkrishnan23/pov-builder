        "QP-8"
      ],
      "api_endpoints": [
        "POST /api/tickets",
        "GET /api/tickets/{ticketId}/triage-suggestion",
        "GET /api/tickets/{ticketId}/similar-resolved?limit=3|4",
        "GET /api/dashboard/ticket-volume-by-product-line",
        "GET /api/dashboard/ticket-volume-by-priority",
        "GET /api/dashboard/avg-resolution-time-by-team"

      ],
      "api_endpoints": [
        "GET /api/tickets/{ticketId}/triage-suggestion"
      ],
      "frontend_pages": [
        "ticket_review"
      ],
      "notes": "Runtime only retrieves stored inference output."
    },
    "AI-2": {
      "description": "Use free-text ticket content to generate or infer routing to the appropriate team.",
      "collections": [
        "support_tickets",
        "support_teams"

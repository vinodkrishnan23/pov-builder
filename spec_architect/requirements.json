  "gaps_and_constraints": [
    {
      "gap": "No live rule invocation endpoint",
      "impact": "FR12 is only covered for reviewing stored external-safe outcomes, not triggering new BRMS decisions from this POV."
    },
    {
      "gap": "No AI/LLM endpoint",
      "impact": "AI1 and AI2 are traceable only to the analytics and audit data access surfaces that a future agent could consume."
    },
    {
      "gap": "No purge/delete endpoint",
      "impact": "FR19 and UC5 cover retention identification and metadata changes, not destructive deletion execution."
    },
    {
      "gap": "No generic list policies/rules endpoints",
      "impact": "Frontend setup and analytics criteria rely on manual entry, route context, or seeded identifiers."
    }
  ]

{
  "business_objectives": {
    "BO-1": {
      "description": "Reduce time spent on manual support ticket triage.",
      "mapped_use_cases": [
        "UC-1",
        "UC-2",
        "UC-3"
      ],
      "collections": [
        "support_tickets"
      ],
      "query_patterns": [
        "QP-1",
        "QP-2"
      ],
      "api_endpoints": [
        "GET /api/tickets/{ticketId}/triage-suggestion",
        "GET /api/tickets/{ticketId}/similar-resolved?limit=3|4"
      ],
      "frontend_pages": [
        "ticket_review",
        "ticket_create"
      ]
    },
    "BO-2": {
      "description": "Improve triage accuracy by using ticket text rather than simple keyword-based rules.",
      "mapped_use_cases": [
        "UC-1",
        "UC-2"
      ],
      "collections": [
        "support_tickets",
        "support_teams"
      ],
      "query_patterns": [
        "QP-1"
      ],
      "api_endpoints": [
        "GET /api/tickets/{ticketId}/triage-suggestion"
      ],
      "frontend_pages": [
        "ticket_review"
      ]
    },
    "BO-3": {
      "description": "Help agents resolve tickets faster by reusing knowledge from similar previously resolved tickets.",
      "mapped_use_cases": [
        "UC-3"
      ],
      "collections": [
        "support_tickets",
        "support_teams"
      ],
      "query_patterns": [
        "QP-2"
      ],
      "api_endpoints": [
        "GET /api/tickets/{ticketId}/similar-resolved?limit=3|4"
      ],
      "frontend_pages": [
        "ticket_review"
      ]
    },
    "BO-4": {
      "description": "Provide live operational visibility for support leadership instead of weekly manual reporting.",
      "mapped_use_cases": [
        "UC-4"
      ],
      "collections": [
        "support_tickets",
        "support_teams",
        "dashboard_metric_snapshots"
      ],
      "query_patterns": [
        "QP-3",
        "QP-4",
        "QP-5",
        "QP-6",
        "QP-7",
        "QP-8"
      ],
      "api_endpoints": [
        "GET /api/dashboard/ticket-volume-by-product-line",
        "GET /api/dashboard/ticket-volume-by-priority",
        "GET /api/dashboard/avg-resolution-time-by-team"
      ],
      "frontend_pages": [
        "dashboard"
      ]
    }
  },
  "functional_requirements": {
    "FR-1": {
      "description": "Use support ticket records containing subject, free-text description, customer account tier, product line, and current priority data.",
      "collections": [
        "support_tickets"
      ],
      "fields": [
        "ticket_id",
        "subject",
        "description",
        "customer_account_tier",
        "product_line",
        "manual_priority"
      ],
      "query_patterns": [],
      "api_endpoints": [
        "POST /api/tickets",
        "GET /api/tickets/{ticketId}"
      ],
      "frontend_pages": [
        "ticket_create",
        "ticket_review"
      ]
    },
    "FR-2": {
      "description": "Support ticket data originating from email, chat, and phone channels within the imported dataset.",
      "collections": [
        "support_tickets"
      ],
      "fields": [
        "channel"
      ],
      "query_patterns": [
        "QP-2"
      ],
      "api_endpoints": [
        "POST /api/tickets",
        "GET /api/tickets/{ticketId}"
      ],
      "frontend_pages": [
        "ticket_create",
        "ticket_review"
      ]
    },
    "FR-3": {
      "description": "Automatically suggest a priority for a ticket.",
      "collections": [
        "support_tickets"
      ],
      "fields": [
        "triage_suggestion.suggested_priority",
        "triage_suggestion.generated_at",
        "triage_suggestion.model_version",
        "triage_suggestion.confidence"
      ],
      "query_patterns": [
        "QP-1"
      ],
      "api_endpoints": [
        "GET /api/tickets/{ticketId}/triage-suggestion"
      ],
      "frontend_pages": [
        "ticket_review"
      ]
    },
    "FR-4": {
      "description": "Recommend routing a ticket to the appropriate team.",
      "collections": [
        "support_tickets",
        "support_teams"
      ],
      "fields": [
        "triage_suggestion.suggested_team_id",
        "assigned_team_id"
      ],
      "query_patterns": [
        "QP-1"
      ],
      "api_endpoints": [
        "GET /api/tickets/{ticketId}/triage-suggestion",
        "GET /api/teams"
      ],
      "frontend_pages": [
        "ticket_review",
        "ticket_create"
      ]
    },
    "FR-5": {
      "description": "Priority and routing suggestions should be based on ticket text content rather than only keyword rules.",
      "collections": [
        "support_tickets"
      ],
      "fields": [
        "subject",
        "description",
        "triage_suggestion"
      ],
      "query_patterns": [
        "QP-1"
      ],
      "api_endpoints": [
        "GET /api/tickets/{ticketId}/triage-suggestion"
      ],
      "frontend_pages": [
        "ticket_review"
      ]
    },
    "FR-6": {
      "description": "Show 3-4 similar previously resolved tickets when reviewing a ticket.",
      "collections": [
        "support_tickets"
      ],
      "fields": [
        "text_embedding",
        "status",
        "is_historical_import"
      ],
      "query_patterns": [
        "QP-2"
      ],
      "api_endpoints": [
        "GET /api/tickets/{ticketId}/similar-resolved?limit=3|4"
      ],
      "frontend_pages": [
        "ticket_review"
      ]
    },
    "FR-7": {
      "description": "Include how prior similar tickets were resolved.",
      "collections": [
        "support_tickets"
      ],
      "fields": [
        "resolution.category",
        "resolution.summary"
      ],
      "query_patterns": [
        "QP-2"
      ],
      "api_endpoints": [
        "GET /api/tickets/{ticketId}/similar-resolved?limit=3|4"
      ],
      "frontend_pages": [
        "ticket_review"
      ]
    },
    "FR-8": {
      "description": "Use historical tickets tagged with resolution category and resolution summary as the search basis for similar-ticket retrieval.",
      "collections": [
        "support_tickets"
      ],
      "fields": [
        "is_historical_import",
        "status",
        "resolution.category",
        "resolution.summary",
        "text_embedding"
      ],
      "query_patterns": [
        "QP-2"
      ],
      "api_endpoints": [
        "GET /api/tickets/{ticketId}/similar-resolved?limit=3|4"
      ],
      "frontend_pages": [
        "ticket_review"
      ]
    },
    "FR-9": {
      "description": "Provide a dashboard showing ticket volume by product line over time.",
      "collections": [
        "support_tickets",
        "dashboard_metric_snapshots"
      ],
      "fields": [
        "created_at",
        "product_line"
      ],
      "query_patterns": [

        "QP-6"
      ],
      "api_endpoints": [
        "GET /api/dashboard/ticket-volume-by-product-line"
      ],
      "frontend_pages": [
        "dashboard"
      ]
    },
    "FR-10": {
      "description": "Provide a dashboard showing ticket volume by priority over time.",
      "collections": [
        "support_tickets",
        "dashboard_metric_snapshots"
      ],
      "fields": [
        "created_at",
        "manual_priority"
      ],
      "query_patterns": [
        "QP-4",
        "QP-7"
      ],
      "api_endpoints": [
        "GET /api/dashboard/ticket-volume-by-priority"
      ],
      "frontend_pages": [
        "dashboard"
      ]
    },
    "FR-11": {
      "description": "Provide a dashboard showing average resolution time by team.",
      "collections": [
        "support_tickets",
        "support_teams",
        "dashboard_metric_snapshots"
      ],
      "fields": [
        "assigned_team_id",
        "created_at",
        "resolved_at",
        "status"
      ],
      "query_patterns": [
        "QP-5",
        "QP-8"
      ],
      "api_endpoints": [
        "GET /api/dashboard/avg-resolution-time-by-team",
        "GET /api/teams"
      ],
      "frontend_pages": [
        "dashboard"
      ]
    },
    "FR-12": {
      "description": "Provide live dashboard visibility rather than weekly manual reporting.",
      "collections": [
        "support_tickets",
        "dashboard_metric_snapshots"
      ],
      "fields": [
        "created_at",
        "resolved_at",
        "last_computed_at"
      ],
      "query_patterns": [
        "QP-3",
        "QP-4",
        "QP-5",
        "QP-6",
        "QP-7",
        "QP-8"
      ],
      "api_endpoints": [
        "GET /api/dashboard/ticket-volume-by-product-line",
        "GET /api/dashboard/ticket-volume-by-priority",
        "GET /api/dashboard/avg-resolution-time-by-team"
      ],
      "frontend_pages": [
        "dashboard"
      ]
    },
    "FR-13": {

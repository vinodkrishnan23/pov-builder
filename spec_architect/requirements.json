      "item": "Public synchronous write APIs for execution_requests/execution_rule_steps",
      "status": "intentionally not included",
      "basis": "API contract explicitly excludes them because ingestion is asynchronous and no authoritative query pattern defines public log-write APIs."
    },
    {
      "item": "Delete/purge log endpoints",
      "status": "intentionally not included",
      "basis": "Retention visibility/settings exist, but no authoritative delete query pattern or purge endpoint is defined."
    },
    {
      "item": "Rule execution service invocation APIs",
      "status": "out of scope",
      "basis": "API contract explicitly excludes BRMS rule execution service invocation for end-customer applications."
    },
    {
      "item": "Full auth protocol design",
      "status": "out of scope",
      "basis": "API contract notes endpoints are for authorized users, but exact auth mechanism is not designed here."
    },
    {
      "item": "Generic list/get endpoints for all policies or policy versions",
      "status": "intentionally not included",
      "basis": "API contract explicitly avoids inventing read patterns beyond the defined compare-context retrieval."
    }
  ]

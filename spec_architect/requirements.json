        "comparePolicyVersionRules",
        "getRequestOutcomesTimeseries",
        "getRulePerformanceSummary",
        "getChannelSourceSummary",
        "getPolicyDefinition",
        "listPolicyDefinitions",
        "createExecutionRequest",
        "appendExecutionStep",
        "updateExecutionRequestStatus"

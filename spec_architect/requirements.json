  "pages": {
    "home": {
      "route": "/",
      "endpoints": [
        "GET /api/teams?active=true"
      ],
      "supports_requirements": [
        "FR-13",
        "FR-16",
        "FR-17"
      ]
    },
    "ticket_create": {
      "route": "/tickets/new",
      "endpoints": [
        "GET /api/teams?active=true",
        "POST /api/tickets"
      ],
      "supports_requirements": [
        "FR-1",
        "FR-4",
        "FR-15",
        "FR-16",
        "FR-17"
      ]
    },
    "ticket_review": {
      "route": "/tickets/:ticketId",
      "endpoints": [
        "GET /api/tickets/{ticketId}",
        "GET /api/tickets/{ticketId}/triage-suggestion",
        "GET /api/tickets/{ticketId}/similar-resolved?limit=4",
        "GET /api/teams?active=true"
      ],
      "supports_requirements": [
        "FR-1",
        "FR-3",
        "FR-4",
        "FR-5",
        "FR-6",
        "FR-7",
        "FR-8",
        "FR-15",
        "FR-16",
        "FR-17",
        "AI-1",
        "AI-2",
        "AI-3"
      ]
    },
    "dashboard": {
      "route": "/dashboard",
      "endpoints": [
        "GET /api/dashboard/ticket-volume-by-product-line",
        "GET /api/dashboard/ticket-volume-by-priority",
        "GET /api/dashboard/avg-resolution-time-by-team",
        "GET /api/teams?active=true"
      ],
      "supports_requirements": [
        "FR-9",
        "FR-10",
        "FR-11",
        "FR-12",
        "FR-15"

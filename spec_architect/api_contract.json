{
  "version": "1.0",
  "pov_name": "internal_support_ticket_triage",
  "auth": {
    "description": "All endpoints require an authenticated internal user context. The backend must validate the acting user via qp8_validate_internal_user_access before executing the endpoint logic.",
    "authentication": {
      "type": "internal_user_context",
      "request_conveyance": "Implementation-specific (for example session or bearer token). The contract assumes the resolved internal user id is available to the backend as authenticated_user_id."
    },
    "authorization": {
      "allowed_roles": [
        "support_agent",
        "admin"
      ]
    }
  },
  "endpoints": [
    {
      "operation_id": "validateInternalAccess",
      "method": "GET",
      "path": "/api/me",
      "purpose": "Validate that the current caller is an active internal user allowed to use the POV and return basic profile information for the signed-in user.",
      "request": {
        "path_params": {},
        "query_params": {},
        "headers": {
          "Authorization": "string, required by deployment auth mechanism"
        },
        "body": null
      },
      "response": {
        "status": 200,
        "body": {
          "user": {
            "id": "objectId",
            "email": "string",
            "name": "string",
            "role": "support_agent|admin",
            "is_active": "boolean"
          }
        }
      },
      "errors": [
        {
          "status": 401,
          "code": "UNAUTHENTICATED",
          "message": "Authentication is missing or invalid."
        },
        {
          "status": 403,
          "code": "FORBIDDEN",
          "message": "User is not an active internal support user or admin."
        },
        {
          "status": 404,
          "code": "USER_NOT_FOUND",
          "message": "Authenticated internal user record was not found."
        }
      ],
      "backing": "qp8_validate_internal_user_access"
    },
    {
      "operation_id": "searchTickets",
      "method": "GET",
      "path": "/api/tickets",
      "purpose": "Search support tickets by text and optionally filter by status so an agent can find a ticket to open for triage.",
      "request": {
        "path_params": {},
        "query_params": {
          "q": {
            "type": "string",
            "required": true,
            "description": "Search text applied to ticket_number, subject, and description."
          },
          "status": {
            "type": "array<string>",
            "required": false,
            "allowed_values": [
              "open",
              "in_progress",
              "resolved"
            ],
            "description": "Optional status filter. If omitted, backend should execute the query pattern without the status narrowing condition or with all statuses, matching implementation choice consistent with qp3 intent."
          }
        },
        "headers": {
          "Authorization": "string, required by deployment auth mechanism"
        },
        "body": null
      },
      "response": {
        "status": 200,
        "body": {
          "tickets": [
            {
              "id": "objectId",
              "ticket_number": "string",
              "subject": "string",
              "product_area": "string|null",
              "priority": "low|medium|high|urgent|null",
              "status": "open|in_progress|resolved",
              "created_at": "date",
              "updated_at": "date"
            }
          ],
          "count": "number"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_QUERY",
          "message": "Search text is missing or one or more status values are invalid."
        },
        {
          "status": 401,
          "code": "UNAUTHENTICATED",
          "message": "Authentication is missing or invalid."
        },
        {
          "status": 403,
          "code": "FORBIDDEN",
          "message": "User is not allowed to access this internal POV."
        }
      ],
      "backing": {
        "access_validation": "qp8_validate_internal_user_access",
        "data_query": "qp3_ticket_search_for_lookup"
      }
    },
    {
      "operation_id": "getTicketById",
      "method": "GET",
      "path": "/api/tickets/{ticketId}",
      "purpose": "Fetch a single support ticket by id for triage review, including embedded guidance reference ids for similar resolved tickets.",
      "request": {
        "path_params": {
          "ticketId": "objectId, required"
        },
        "query_params": {},
        "headers": {
          "Authorization": "string, required by deployment auth mechanism"
        },
        "body": null
      },
      "response": {
        "status": 200,
        "body": {
          "ticket": {
            "id": "objectId",
            "ticket_number": "string",
            "subject": "string",
            "description": "string",
            "customer_name": "string|null",
            "customer_email": "string|null",
            "product_area": "string|null",
            "priority": "low|medium|high|urgent|null",
            "status": "open|in_progress|resolved",
            "created_at": "date",
            "updated_at": "date",
            "resolved_at": "date|null",
            "resolution_summary": "string|null",
            "triage_guidance": {
              "generated_at": "date",
              "summary": "string",
              "suggested_category": "string|null",
              "suggested_priority": "string|null",
              "recommended_actions": [
                "string"
              ],
              "confidence": "number|null"
            },
            "similar_resolved_ticket_ids": [
              "objectId"
            ]
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_TICKET_ID",
          "message": "ticketId is not a valid object id."
        },
        {
          "status": 401,
          "code": "UNAUTHENTICATED",
          "message": "Authentication is missing or invalid."
        },
        {
          "status": 403,
          "code": "FORBIDDEN",
          "message": "User is not allowed to access this internal POV."
        },
        {
          "status": 404,
          "code": "TICKET_NOT_FOUND",
          "message": "Ticket was not found."
        }
      ],
      "backing": {
        "access_validation": "qp8_validate_internal_user_access",
        "data_query": "qp2_ticket_lookup_by_id"
      }
    },
    {
      "operation_id": "getTicketByNumber",
      "method": "GET",
      "path": "/api/tickets/by-number/{ticketNumber}",
      "purpose": "Fetch a single support ticket by exact ticket number when the agent knows the ticket number.",
      "request": {
        "path_params": {
          "ticketNumber": "string, required"
        },
        "query_params": {},
        "headers": {
          "Authorization": "string, required by deployment auth mechanism"
        },
        "body": null
      },
      "response": {
        "status": 200,
        "body": {
          "ticket": {
            "id": "objectId",
            "ticket_number": "string",
            "subject": "string",
            "description": "string",
            "customer_name": "string|null",
            "customer_email": "string|null",
            "product_area": "string|null",
            "priority": "low|medium|high|urgent|null",
            "status": "open|in_progress|resolved",
            "created_at": "date",
            "updated_at": "date",
            "resolved_at": "date|null",
            "resolution_summary": "string|null",
            "triage_guidance": {
              "generated_at": "date",
              "summary": "string",
              "suggested_category": "string|null",
              "suggested_priority": "string|null",
              "recommended_actions": [
                "string"
              ],
              "confidence": "number|null"
            },
            "similar_resolved_ticket_ids": [
              "objectId"
            ]
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_TICKET_NUMBER",
          "message": "ticketNumber is missing or invalid."
        },
        {
          "status": 401,
          "code": "UNAUTHENTICATED",
          "message": "Authentication is missing or invalid."
        },
        {
          "status": 403,
          "code": "FORBIDDEN",
          "message": "User is not allowed to access this internal POV."
        },
        {
          "status": 404,
          "code": "TICKET_NOT_FOUND",
          "message": "Ticket was not found."
        }
      ],
      "backing": {
        "access_validation": "qp8_validate_internal_user_access",
        "data_query": "qp1_ticket_lookup_by_ticket_number"
      }
    },
    {
      "operation_id": "getTicketTriageGuidance",
      "method": "GET",
      "path": "/api/tickets/{ticketId}/triage-guidance",
      "purpose": "Fetch the current ticket details together with embedded AI-suggested triage guidance for the triage experience.",
      "request": {
        "path_params": {
          "ticketId": "objectId, required"
        },
        "query_params": {},
        "headers": {
          "Authorization": "string, required by deployment auth mechanism"
        },
        "body": null
      },
      "response": {
        "status": 200,
        "body": {
          "ticket": {
            "id": "objectId",
            "ticket_number": "string",
            "subject": "string",
            "description": "string",
            "product_area": "string|null",
            "priority": "low|medium|high|urgent|null",
            "status": "open|in_progress|resolved"
          },
          "triage_guidance": {
            "generated_at": "date",
            "summary": "string",
            "suggested_category": "string|null",

              "text": "string",
              "contextualText": "string | null",
              "tokenCount": "number | null",
              "charCount": "number | null",
              "pageRange": {
                "start": "number | null",
                "end": "number | null"
              },
              "sectionPath": [
                "string"
              ],
              "embeddingModel": "string | null",

{
  "version": "1.0.0",
  "pov_scope_alignment": {
    "in_scope": [
      "Primary document-search POV over uploaded documents",
      "Workshop ingestion visibility and troubleshooting",
      "Tenant-scoped vector retrieval over document chunks",
      "Structured-plus-unstructured retrieval demos backed by document metadata",
      "Secondary agent memory semantic retrieval",
      "Benchmark run/question/result capture and reporting for side-by-side comparison"
    ],
    "out_of_scope": [
      "Generic application-database APIs beyond POV data entities",
      "Multimodal benchmarking APIs",
      "Baseline system execution APIs that would require orchestrating external Elastic/OpenSearch/Qdrant calls; this contract only stores and reads benchmark metadata/results",
      "Any endpoint that implies new query patterns not present in query_patterns.json"
    ]
  },
  "conventions": {
    "base_path": "/api/v1",
    "content_type": "application/json",
    "id_type": "objectId-string",
    "datetime_format": "ISO-8601",
    "authz_note": "All endpoints are expected to enforce tenant scoping; tenant_id appears in paths where required by the underlying data model/query patterns."
  },
  "endpoints": [
    {
      "operation_id": "createTenant",
      "method": "POST",
      "path": "/api/v1/tenants",
      "purpose": "Create an evaluation tenant to scope documents, agent memory, and benchmark runs.",
      "request": {
        "body": {
          "tenant_key": "string, required",
          "name": "string, required",
          "deployment_mode": "enum(shared_saas|isolated_customer_deployment|pov_workshop), optional"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "tenant": {
            "id": "objectId-string",
            "tenant_key": "string",
            "name": "string",
            "deployment_mode": "string|null",
            "created_at": "ISO-8601"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_REQUEST",
          "message": "Missing required fields or invalid deployment_mode."
        },
        {
          "status": 409,
          "code": "TENANT_KEY_CONFLICT",
          "message": "tenant_key already exists if uniqueness is enforced by implementation."
        }
      ],
      "backing": "MongoDB insertOne on tenants"
    },
    {
      "operation_id": "listTenants",
      "method": "GET",
      "path": "/api/v1/tenants",
      "purpose": "List evaluation tenants.",
      "request": {
        "query": {}
      },
      "response": {
        "status": 200,
        "body": {
          "tenants": [
            {
              "id": "objectId-string",
              "tenant_key": "string",
              "name": "string",
              "deployment_mode": "string|null",
              "created_at": "ISO-8601"
            }
          ]
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "INTERNAL_ERROR",
          "message": "Failed to list tenants."
        }
      ],
      "backing": "MongoDB find on tenants"
    },
    {
      "operation_id": "createDocument",
      "method": "POST",
      "path": "/api/v1/tenants/{tenantId}/documents",
      "purpose": "Register an uploaded source document and its initial ingestion metadata for the workshop flow.",
      "request": {
        "path": {
          "tenantId": "objectId-string, required"
        },
        "body": {
          "document_type": "enum(pdf|csv|google_sheet_export|text|business_document|research_paper|chat_thread_export|other), required",
          "title": "string, optional",
          "source_filename": "string, optional",
          "mime_type": "string, optional",
          "source_uri": "string, optional",
          "source_system": "enum(uploaded_in_session|s3|other), optional",
          "upload_session_label": "string, optional",
          "metadata": {
            "author": "string, optional",
            "created_date": "ISO-8601, optional",
            "language": "string, optional",
            "tags": [
              "string"
            ],
            "structured_attributes": "object, optional"
          },
          "ingest_status": "enum(uploaded|parsed|chunked|embedded|failed), required",
          "ingest_errors": [
            {
              "stage": "string",
              "message": "string",
              "timestamp": "ISO-8601"
            }
          ],
          "chunking_runs": [
            {
              "chunking_strategy": "enum(fixed_length|recursive|semantic|contextual)",
              "chunk_count": "integer",
              "parser_name": "string, optional",
              "embedding_model": "string, optional",
              "run_timestamp": "ISO-8601"
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "body": {
          "document": {
            "id": "objectId-string",
            "tenant_id": "objectId-string",
            "document_type": "string",
            "title": "string|null",
            "source_filename": "string|null",
            "mime_type": "string|null",
            "source_uri": "string|null",
            "source_system": "string|null",
            "upload_session_label": "string|null",
            "metadata": "object|null",
            "ingest_status": "string",
            "ingest_errors": "array|null",
            "chunking_runs": "array|null",
            "created_at": "ISO-8601",
            "updated_at": "ISO-8601"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_REQUEST",
          "message": "Missing required fields or invalid enum/date values."
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "message": "Tenant does not exist."
        }
      ],
      "backing": "MongoDB insertOne on documents"
    },
    {
      "operation_id": "listSessionDocuments",
      "method": "GET",
      "path": "/api/v1/tenants/{tenantId}/documents",
      "purpose": "Show uploaded customer documents for a tenant/session and their ingestion state during the workshop.",
      "request": {
        "path": {
          "tenantId": "objectId-string, required"
        },
        "query": {
          "upload_session_label": "string, required for QP1 alignment",
          "page_size": "integer, optional, defaults implementation-defined"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "documents": [
            {
              "id": "objectId-string",
              "document_type": "string",
              "title": "string|null",
              "source_filename": "string|null",
              "source_system": "string|null",
              "ingest_status": "string",
              "chunking_runs": [
                {
                  "chunking_strategy": "string",
                  "chunk_count": "integer",
                  "parser_name": "string|null",
                  "embedding_model": "string|null",
                  "run_timestamp": "ISO-8601"
                }
              ],
              "created_at": "ISO-8601",
              "updated_at": "ISO-8601"
            }
          ]
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "MISSING_UPLOAD_SESSION_LABEL",
          "message": "upload_session_label is required for this endpoint because it maps to QP1."
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "message": "Tenant does not exist."
        }
      ],
      "backing": "QP1"
    },
    {
      "operation_id": "listFailedDocuments",
      "method": "GET",
      "path": "/api/v1/tenants/{tenantId}/documents/failed",
      "purpose": "Inspect documents whose parse/chunk/embed pipeline failed.",
      "request": {
        "path": {
          "tenantId": "objectId-string, required"
        },
        "query": {}
      },
      "response": {
        "status": 200,
        "body": {
          "documents": [
            {
              "id": "objectId-string",
              "title": "string|null",
              "source_filename": "string|null",
              "document_type": "string",
              "ingest_status": "failed",
              "ingest_errors": [
                {
                  "stage": "string",
                  "message": "string",
                  "timestamp": "ISO-8601"
                }
              ],
              "updated_at": "ISO-8601"
            }
          ]
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "message": "Tenant does not exist."
        }
      ],
      "backing": "QP2"
    },
    {

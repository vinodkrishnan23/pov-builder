{
  "version": "1.0",
  "pov_name": "ThoughtSpot MongoDB Atlas + Voyage Retrieval POV",
  "principles": [
    "Endpoints are limited to straightforward CRUD on the authoritative data model or direct wrappers around the authoritative query patterns.",
    "No API is introduced for unsupported capabilities such as raw binary file storage, authentication/authorization subsystem management, or agent session database management beyond the modeled entities.",
    "Tenant scope is explicit in nearly all endpoints because the data model and query patterns are tenant-scoped."
  ],
  "conventions": {
    "base_path": "/api/v1",
    "content_type": "application/json",
    "tenant_identifier": "tenantId path parameter carrying tenants._id",
    "pagination": {
      "style": "limit_only",
      "note": "Only limit-based pagination is guaranteed because authoritative query patterns define limit but no skip/cursor pattern."
    },
    "timestamps": "ISO-8601 strings",
    "object_id": "24-char hex string"
  },
  "endpoints": [
    {
      "operationId": "createTenant",
      "method": "POST",
      "path": "/api/v1/tenants",
      "purpose": "Create a tenant record used as the isolation boundary for demo documents, queries, and benchmark runs.",
      "request": {
        "body": {
          "tenant_key": "string, required, unique",
          "name": "string, required",
          "deployment_model": "shared|isolated, optional",
          "cloud": "aws|gcp|azure|other, optional",
          "status": "active|inactive, required"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "tenant": {
            "_id": "objectId",
            "tenant_key": "string",
            "name": "string",
            "deployment_model": "shared|isolated|null",
            "cloud": "aws|gcp|azure|other|null",
            "status": "active|inactive",
            "created_at": "datetime",
            "updated_at": "datetime"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "when": "Missing required fields or invalid enum values."
        },
        {
          "status": 409,
          "code": "TENANT_KEY_CONFLICT",
          "when": "tenant_key already exists."
        }
      ],
      "backing": "CRUD insertOne on tenants"
    },
    {
      "operationId": "listTenants",
      "method": "GET",
      "path": "/api/v1/tenants",
      "purpose": "List tenants available in the POV environment.",
      "request": {
        "query": {
          "status": "active|inactive, optional",
          "limit": "integer, optional"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "tenants": [
            {
              "_id": "objectId",
              "tenant_key": "string",
              "name": "string",
              "deployment_model": "shared|isolated|null",
              "cloud": "aws|gcp|azure|other|null",
              "status": "active|inactive",
              "created_at": "datetime",
              "updated_at": "datetime"
            }
          ]
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "when": "Invalid query parameter values."
        }
      ],
      "backing": "CRUD find on tenants"
    },
    {
      "operationId": "getTenant",
      "method": "GET",
      "path": "/api/v1/tenants/{tenantId}",
      "purpose": "Retrieve one tenant by id.",
      "request": {
        "path": {
          "tenantId": "objectId, required"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "tenant": {
            "_id": "objectId",
            "tenant_key": "string",
            "name": "string",
            "deployment_model": "shared|isolated|null",
            "cloud": "aws|gcp|azure|other|null",
            "status": "active|inactive",
            "created_at": "datetime",
            "updated_at": "datetime"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_ID",
          "when": "tenantId is not a valid ObjectId."
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "when": "No tenant exists with the provided id."
        }
      ],
      "backing": "CRUD findOne on tenants"
    },
    {
      "operationId": "updateTenant",
      "method": "PATCH",
      "path": "/api/v1/tenants/{tenantId}",
      "purpose": "Update mutable tenant metadata.",
      "request": {
        "path": {
          "tenantId": "objectId, required"
        },
        "body": {
          "name": "string, optional",
          "deployment_model": "shared|isolated, optional",
          "cloud": "aws|gcp|azure|other, optional",
          "status": "active|inactive, optional"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "tenant": {
            "_id": "objectId",
            "tenant_key": "string",
            "name": "string",
            "deployment_model": "shared|isolated|null",
            "cloud": "aws|gcp|azure|other|null",
            "status": "active|inactive",
            "created_at": "datetime",
            "updated_at": "datetime"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "when": "Invalid fields or enum values."
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "when": "No tenant exists with the provided id."
        },
        {
          "status": 409,
          "code": "TENANT_KEY_IMMUTABLE",
          "when": "Attempt to update tenant_key through this endpoint."
        }
      ],
      "backing": "CRUD updateOne on tenants"
    },
    {
      "operationId": "createDocument",
      "method": "POST",
      "path": "/api/v1/tenants/{tenantId}/documents",
      "purpose": "Create a document metadata record for uploaded content or conversation-derived memory. Raw binary upload is out of scope; the API records metadata, extracted text when available, and ingest state.",
      "request": {
        "path": {
          "tenantId": "objectId, required"
        },
        "body": {
          "document_type": "pdf|csv|google_sheet|text|slack_thread|confluence_page|jira_ticket|agent_memory|other, required",
          "title": "string, optional",
          "source_system": "upload|s3|slack|confluence|jira|google_sheets|csv|pdf|agent_conversation|other, required",
          "source_uri": "string, optional",
          "mime_type": "string, optional",
          "file_name": "string, optional",
          "raw_text": "string, optional",
          "structured_attributes": "object, optional",
          "access": {
            "user_ids": [
              "objectId, optional"
            ],
            "group_ids": [
              "objectId, optional"
            ]
          },
          "ingest_status": "uploaded|text_extracted|chunked|embedded|failed, required",
          "ingest_errors": [
            "object, optional"
          ],
          "is_agent_memory": "boolean, required"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "document": {
            "_id": "objectId",
            "tenant_id": "objectId",
            "document_type": "string",
            "title": "string|null",
            "source_system": "string",
            "source_uri": "string|null",
            "mime_type": "string|null",
            "file_name": "string|null",
            "raw_text": "string|null",
            "structured_attributes": "object|null",
            "access": {
              "user_ids": [
                "objectId"
              ],
              "group_ids": [
                "objectId"
              ]
            },
            "ingest_status": "string",
            "ingest_errors": [
              "object"
            ],
            "is_agent_memory": "boolean",
            "created_at": "datetime",
            "updated_at": "datetime"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "when": "Missing required fields or invalid enum values."
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "when": "tenantId does not exist."
        }
      ],
      "backing": "CRUD insertOne on documents"
    },
    {
      "operationId": "listRetrievalReadyDocuments",

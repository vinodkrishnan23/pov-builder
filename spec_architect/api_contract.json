  "non_endpoints": [
    {
      "area": "benchmark execution orchestration",
      "status": "not_exposed_as_new_endpoint_here",
      "reason": "The authoritative query patterns support storing and reading benchmark runs/results, but do not define a query-backed execution workflow that runs retrieval, computes metrics, and writes benchmark_run_results/aggregate_metrics. This contract therefore supports CRUD for creating a run record and query-backed reads for inspecting results, but does not invent a new 'execute benchmark' API."
    },
    {
      "area": "embedding generation / reranking model invocation",
      "status": "application-layer concern",
      "reason": "Query patterns QP4/QP5/QP6 require query embeddings, and benchmark results may contain rerank scores, but the data model/query patterns do not define persistence or API contracts for model-provider calls. Endpoints accept query_text and/or query_embedding; server-side embedding/reranking, if implemented, is outside MongoDB query patterns."
    },
    {
      "area": "binary file upload transport",
      "status": "simplified_to_document-record creation",
      "reason": "The authoritative data model stores document metadata and optional source_uri/raw_text, but does not define a file blob store or multipart upload pattern. This contract therefore exposes document creation metadata rather than inventing file-storage APIs."
    }
  ]

{
  "version": "1.0.0",
  "pov_name": "MongoDB Atlas + Voyage AI POV Builder API Contract",
  "base_path": "/api/v1",
  "content_type": "application/json",
  "authentication": {
    "note": "Authentication/authorization mechanism is out of scope in the authoritative data model and query patterns. Endpoints assume caller context is already authenticated and tenant-scoped where required."
  },
  "endpoints": [
    {
      "operation_id": "createTenant",
      "method": "POST",
      "path": "/tenants",
      "purpose": "Create a tenant/account scope used to isolate uploaded documents, agent memory, and benchmark runs.",
      "request": {
        "body": {
          "tenant_key": "string, required",
          "display_name": "string, required",
          "deployment_model": "string, optional, one of [multi_tenant, isolated_per_tenant]",
          "cloud": "string, optional, one of [aws, gcp, azure, other]"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "tenant": {
            "id": "objectId",
            "tenant_key": "string",
            "display_name": "string",
            "deployment_model": "string|null",
            "cloud": "string|null",
            "created_at": "date-time"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_REQUEST",
          "cases": [
            "Missing required fields",
            "Invalid enum value"
          ]
        },
        {
          "status": 409,
          "code": "TENANT_KEY_ALREADY_EXISTS",
          "cases": [
            "Duplicate tenant_key due to unique index uk_tenant_key"
          ]
        }
      ],
      "backing": {
        "type": "CRUD",
        "collection": "tenants",
        "operation": "insertOne"
      }
    },
    {
      "operation_id": "listTenants",
      "method": "GET",
      "path": "/tenants",
      "purpose": "List tenants available in the POV environment.",
      "request": {
        "query_params": {}
      },
      "response": {
        "status": 200,
        "body": {
          "tenants": [
            {
              "id": "objectId",
              "tenant_key": "string",
              "display_name": "string",
              "deployment_model": "string|null",
              "cloud": "string|null",
              "created_at": "date-time"
            }
          ]
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "INTERNAL_ERROR",
          "cases": [
            "Unexpected read failure"
          ]
        }
      ],
      "backing": {
        "type": "CRUD",
        "collection": "tenants",
        "operation": "find"
      }
    },
    {
      "operation_id": "createDocument",
      "method": "POST",
      "path": "/tenants/{tenantId}/documents",
      "purpose": "Create a document record for an uploaded file or conversation-derived memory item so ingestion can proceed and progress can be tracked.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "body": {
          "document_type": "string, required, one of [unstructured_document, agent_memory_document]",
          "source_type": "string, required, one of [pdf, csv, google_sheet, json, text, research_paper, business_document, jira_export, slack_export, conversation, other]",
          "title": "string, optional",
          "source_uri": "string, optional",
          "mime_type": "string, optional",
          "uploaded_by_user_id": "string, optional",
          "access_tags": {
            "tenant_key": "string, optional",
            "user_ids": [
              "string, optional"
            ],
            "groups": [
              "string, optional"
            ]
          },
          "structured_metadata": {
            "author": "string, optional",
            "created_source_at": "date-time, optional",
            "labels": [
              "string, optional"
            ],
            "business_attributes": "object, optional"
          },
          "conversation_metadata": {
            "session_id": "string, optional",
            "message_count": "int, optional",
            "participants": [
              "string, optional"
            ]
          },
          "raw_text": "string, optional",
          "ingestion_status": "string, optional; if omitted server defaults to uploaded"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "document": {
            "id": "objectId",
            "tenant_id": "objectId",
            "document_type": "string",
            "source_type": "string",
            "title": "string|null",
            "source_uri": "string|null",
            "mime_type": "string|null",
            "uploaded_by_user_id": "string|null",
            "access_tags": "object|null",
            "structured_metadata": "object|null",
            "conversation_metadata": "object|null",
            "raw_text": "string|null",
            "ingestion_status": "string",
            "created_at": "date-time",
            "updated_at": "date-time"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_REQUEST",
          "cases": [
            "Missing required fields",
            "Invalid enum values",
            "Malformed metadata structure"
          ]
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "cases": [
            "tenantId does not exist"
          ]
        }
      ],
      "backing": {
        "type": "CRUD",
        "collection": "documents",
        "operation": "insertOne"
      }
    },
    {
      "operation_id": "listReadyDocuments",
      "method": "GET",
      "path": "/tenants/{tenantId}/documents",
      "purpose": "List tenant documents that are ready for search or playground use, optionally filtered by source type, document type, uploader, and recency.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "query_params": {
          "source_types": "comma-separated list of source_type values, optional",
          "document_types": "comma-separated list of [unstructured_document, agent_memory_document], optional",
          "uploaded_by_user_id": "string, optional",
          "from_date": "date-time, optional",
          "to_date": "date-time, optional",
          "limit": "int, optional"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "documents": [
            {
              "id": "objectId",
              "title": "string|null",
              "document_type": "string",
              "source_type": "string",
              "uploaded_by_user_id": "string|null",
              "structured_metadata": "object|null",
              "conversation_metadata": "object|null",
              "created_at": "date-time",
              "updated_at": "date-time"
            }
          ]
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_QUERY",
          "cases": [
            "Invalid tenantId",
            "Invalid enum filters",
            "Invalid date range"
          ]
        }
      ],
      "backing": {
        "type": "query_pattern",
        "id": "QP1",
        "name": "List tenant documents ready for search/playground"
      }
    },
    {
      "operation_id": "getDocumentIngestionStatus",
      "method": "GET",
      "path": "/tenants/{tenantId}/documents/ingestion-status",
      "purpose": "Track ingestion progress for one or more newly uploaded documents during on-the-fly demo uploads.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "query_params": {
          "document_ids": "comma-separated list of objectIds, required"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "documents": [
            {
              "id": "objectId",
              "title": "string|null",
              "source_type": "string",
              "ingestion_status": "string",
              "updated_at": "date-time",
              "created_at": "date-time"
            }
          ]
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_QUERY",
          "cases": [
            "Missing document_ids",
            "Invalid objectId in document_ids"
          ]
        }
      ],
      "backing": {
        "type": "query_pattern",
        "id": "QP2",
        "name": "Track document ingestion progress for on-the-fly uploads"
      }
    },
    {
      "operation_id": "getDocument",
      "method": "GET",
      "path": "/tenants/{tenantId}/documents/{documentId}",
      "purpose": "Fetch a single document record and metadata.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required",
          "documentId": "objectId, required"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "document": {
            "id": "objectId",
            "tenant_id": "objectId",
            "document_type": "string",
            "source_type": "string",
            "title": "string|null",
            "source_uri": "string|null",
            "mime_type": "string|null",
            "uploaded_by_user_id": "string|null",
            "access_tags": "object|null",
            "structured_metadata": "object|null",
            "conversation_metadata": "object|null",
            "raw_text": "string|null",
            "ingestion_status": "string",
            "created_at": "date-time",
            "updated_at": "date-time"
          }
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "DOCUMENT_NOT_FOUND",
          "cases": [
            "No document for tenantId + documentId"
          ]
        }
      ],
      "backing": {
        "type": "CRUD",
        "collection": "documents",
        "operation": "findOne"
      }
    },
    {
      "operation_id": "updateDocument",
      "method": "PATCH",
      "path": "/tenants/{tenantId}/documents/{documentId}",
      "purpose": "Update a document record, including ingestion status as the upload pipeline progresses.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required",
          "documentId": "objectId, required"
        },
        "body": {
          "title": "string, optional",
          "source_uri": "string, optional",
          "mime_type": "string, optional",
          "uploaded_by_user_id": "string, optional",
          "access_tags": "object, optional",
          "structured_metadata": "object, optional",
          "conversation_metadata": "object, optional",
          "raw_text": "string, optional",
          "ingestion_status": "string, optional, one of [uploaded, text_extracted, chunked, embedded, ready, failed]"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "document": {
            "id": "objectId",
            "updated_at": "date-time",
            "ingestion_status": "string"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_REQUEST",
          "cases": [
            "Invalid enum",
            "Invalid patch payload"
          ]
        },
        {
          "status": 404,
          "code": "DOCUMENT_NOT_FOUND",
          "cases": [
            "No document for tenantId + documentId"
          ]
        }
      ],
      "backing": {
        "type": "CRUD",
        "collection": "documents",
        "operation": "updateOne"
      }
    },
    {
      "operation_id": "listDocumentChunks",
      "method": "GET",
      "path": "/tenants/{tenantId}/documents/{documentId}/chunks",
      "purpose": "Browse chunks for a document under a chosen chunking strategy to inspect chunk output and compare chunking approaches.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required",
          "documentId": "objectId, required"
        },
        "query_params": {
          "chunking_strategy": "string, required, one of [fixed_length, recursive, semantic, contextual]"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "chunks": [
            {
              "id": "objectId",
              "chunk_index": "int",
              "text": "string",
              "token_count": "int|null",
              "start_offset": "int|null",
              "end_offset": "int|null",
              "embedding_model": "string",
              "metadata": {
                "title": "string|null",
                "source_type": "string|null"
              }
            }
          ]
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_QUERY",
          "cases": [
            "Missing chunking_strategy",
            "Invalid strategy value"
          ]
        }
      ],
      "backing": {
        "type": "query_pattern",
        "id": "QP3",
        "name": "Browse chunks for a document by chunking strategy"
      }
    },
    {
      "operation_id": "searchDocumentChunksVector",
      "method": "POST",
      "path": "/tenants/{tenantId}/search/documents/vector",
      "purpose": "Run vector search over unstructured document chunks with optional structured filters to answer questions against uploaded documents.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "body": {
          "query_text": "string, optional if query_embedding supplied",
          "query_embedding": [
            "float, optional if query_text supplied"
          ],
          "top_k": "int, required",
          "num_candidates": "int, required",
          "chunking_strategy": "string, optional",
          "source_types": [
            "string, optional"
          ],
          "labels": [
            "string, optional"
          ],
          "business_attribute_filters": "object, optional key-value map for structured metadata business attributes"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "results": [
            {
              "chunk_id": "objectId",
              "document_id": "objectId",
              "text": "string",
              "chunk_index": "int",
              "chunking_strategy": "string",
              "embedding_model": "string",
              "metadata": {
                "title": "string|null",
                "source_type": "string|null",
                "structured_metadata": "object|null"
              },
              "score": "float"
            }
          ]
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_REQUEST",
          "cases": [
            "Neither query_text nor query_embedding provided",
            "Invalid strategy/source types",
            "top_k or num_candidates invalid"
          ]
        }
      ],
      "backing": {
        "type": "query_pattern",
        "id": "QP4",
        "name": "Vector search unstructured document chunks with optional structured filters",
        "notes": "If query_text is provided, an application-layer embedding generation step must occur before executing QP4; that external embedding call is outside the MongoDB query pattern."
      }
    },
    {
      "operation_id": "searchDocumentChunksHybrid",
      "method": "POST",
      "path": "/tenants/{tenantId}/search/documents/hybrid",
      "purpose": "Run hybrid lexical plus vector retrieval for side-by-side comparison against pure vector retrieval on the same tenant corpus.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "body": {
          "query_text": "string, required",
          "query_embedding": [
            "float, optional if server generates embedding from query_text"
          ],
          "top_k": "int, required",
          "vector_top_k": "int, required",
          "text_top_k": "int, required",
          "num_candidates": "int, required",
          "chunking_strategy": "string, optional"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "results": [
            {
              "chunk_id": "objectId",
              "document_id": "objectId",
              "text": "string",
              "chunk_index": "int",
              "chunking_strategy": "string",
              "title": "string|null",
              "source_type": "string|null",
              "best_score": "float",
              "channels": [
                "text or vector"
              ]
            }
          ]
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_REQUEST",
          "cases": [
            "Missing query_text",
            "Invalid K parameters",
            "Invalid strategy"
          ]
        }
      ],
      "backing": {
        "type": "query_pattern",
        "id": "QP5",
        "name": "Hybrid lexical plus vector retrieval for document search",
        "notes": "If query_embedding is not supplied, the service must generate it before executing the vector portion of QP5."
      }
    },
    {
      "operation_id": "searchAgentMemory",
      "method": "POST",
      "path": "/tenants/{tenantId}/search/agent-memory",
      "purpose": "Retrieve conversation-derived agent memory using tenant and user/group access boundaries.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "body": {
          "query_text": "string, optional if query_embedding supplied",
          "query_embedding": [
            "float, optional if query_text supplied"
          ],
          "user_id": "string, required",
          "groups": [
            "string, optional"
          ],
          "top_k": "int, required",
          "num_candidates": "int, required",
          "chunking_strategy": "string, optional"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "results": [
            {
              "chunk_id": "objectId",
              "document_id": "objectId",
              "text": "string",
              "chunk_index": "int",
              "metadata": {
                "title": "string|null",
                "access_tags": "object|null",
                "structured_metadata": "object|null"
              },
              "score": "float"
            }
          ]
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_REQUEST",
          "cases": [
            "Missing user_id",
            "Neither query_text nor query_embedding provided",
            "Invalid strategy"
          ]
        }
      ],
      "backing": {
        "type": "query_pattern",
        "id": "QP6",
        "name": "Retrieve agent memory by tenant and user access tags",
        "notes": "If query_text is provided, embedding generation occurs in the application layer before QP6."
      }
    },
    {
      "operation_id": "listAgentMemoryDocuments",
      "method": "GET",
      "path": "/tenants/{tenantId}/agent-memory/documents",
      "purpose": "List recent agent memory documents for a tenant, optionally scoped to user or session.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "query_params": {
          "user_id": "string, optional",
          "session_id": "string, optional",
          "limit": "int, optional"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "documents": [
            {
              "id": "objectId",
              "title": "string|null",
              "source_type": "string",
              "conversation_metadata": "object|null",
              "access_tags": "object|null",
              "created_at": "date-time",
              "updated_at": "date-time"
            }
          ]
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_QUERY",
          "cases": [
            "Invalid tenantId",
            "Invalid limit"
          ]
        }
      ],
      "backing": {
        "type": "query_pattern",
        "id": "QP7",
        "name": "List recent agent memory documents for a user/session"
      }
    },
    {
      "operation_id": "hydrateRetrievedChunks",
      "method": "POST",
      "path": "/retrieval/chunks/hydrate",
      "purpose": "Hydrate retrieved chunk hits with parent document metadata and source information for display or agent grounding.",
      "request": {
        "body": {
          "chunk_ids": [
            "objectId, required"
          ],
          "scores_by_chunk_id": "object, optional map of chunkId to score"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "results": [
            {
              "chunk_id": "objectId",
              "document_id": "objectId",
              "text": "string",
              "chunk_index": "int",
              "chunking_strategy": "string",
              "score": "float|null",
              "document": {
                "title": "string|null",
                "source_uri": "string|null",
                "source_type": "string",
                "mime_type": "string|null",
                "structured_metadata": "object|null",
                "created_at": "date-time"
              }
            }
          ]
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_REQUEST",
          "cases": [
            "Missing chunk_ids",
            "Invalid objectId list"
          ]
        }
      ],
      "backing": {
        "type": "query_pattern",
        "id": "QP8",
        "name": "Fetch parent documents for retrieved chunks"
      }
    },
    {
      "operation_id": "createBenchmarkQuery",
      "method": "POST",
      "path": "/benchmark/queries",
      "purpose": "Create a reusable benchmark query/prompt for document search, agent memory, or hybrid structured/unstructured evaluation.",
      "request": {
        "body": {
          "tenant_id": "objectId, optional",
          "name": "string, required",
          "query_text": "string, required",
          "query_type": "string, required, one of [document_search, agent_memory, hybrid_structured_unstructured]",
          "target_document_type": "string, optional, one of [unstructured_document, agent_memory_document]",
          "filters": {
            "source_types": [
              "string, optional"
            ],
            "user_id": "string, optional",
            "chunking_strategy": "string, optional"
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "benchmark_query": {
            "id": "objectId",
            "tenant_id": "objectId|null",
            "name": "string",
            "query_text": "string",
            "query_type": "string",
            "target_document_type": "string|null",
            "filters": "object|null",
            "created_at": "date-time"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_REQUEST",
          "cases": [
            "Missing required fields",
            "Invalid enum values"
          ]
        }
      ],
      "backing": {
        "type": "CRUD",
        "collection": "benchmark_queries",
        "operation": "insertOne"
      }
    },
    {
      "operation_id": "listBenchmarkQueries",
      "method": "GET",
      "path": "/benchmark/queries",
      "purpose": "Select benchmark queries by scenario and optional filters for an evaluation run.",
      "request": {
        "query_params": {
          "tenant_id": "objectId, optional",
          "query_type": "string, required",
          "target_document_type": "string, optional",
          "source_types": "comma-separated list, optional",
          "user_id": "string, optional",
          "chunking_strategy": "string, optional"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "queries": [
            {
              "id": "objectId",
              "tenant_id": "objectId|null",
              "name": "string",
              "query_text": "string",
              "query_type": "string",
              "target_document_type": "string|null",
              "filters": "object|null",
              "created_at": "date-time"
            }
          ]
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_QUERY",
          "cases": [
            "Missing query_type",
            "Invalid enum values"
          ]
        }
      ],
      "backing": {
        "type": "query_pattern",
        "id": "QP9",
        "name": "Select benchmark queries by scenario and filters"
      }
    },
    {
      "operation_id": "createBenchmarkRelevanceJudgment",
      "method": "POST",
      "path": "/benchmark/relevance-judgments",
      "purpose": "Create a ground-truth relevance judgment linking a benchmark query to a relevant document or chunk.",
      "request": {
        "body": {
          "query_id": "objectId, required",
          "document_id": "objectId, optional",
          "chunk_id": "objectId, optional",
          "relevance_grade": "int, required",
          "notes": "string, optional"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "judgment": {
            "id": "objectId",
            "query_id": "objectId",
            "document_id": "objectId|null",
            "chunk_id": "objectId|null",
            "relevance_grade": "int",
            "notes": "string|null"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_REQUEST",
          "cases": [
            "Missing query_id",
            "Missing both document_id and chunk_id",
            "Invalid IDs or relevance_grade"
          ]
        }
      ],
      "backing": {
        "type": "CRUD",
        "collection": "benchmark_relevance_judgments",
        "operation": "insertOne",
        "notes": "The data model allows both document_id and chunk_id as optional fields; the API constrains callers to provide at least one."
      }
    },
    {
      "operation_id": "listBenchmarkRelevanceJudgments",
      "method": "GET",
      "path": "/benchmark/queries/{queryId}/relevance-judgments",

  "global_errors": [
    {
      "status": 500,
      "code": "INTERNAL_ERROR",
      "when": "Unexpected server-side failure."
    }
  ],
  "notes": [
    "The contract is intentionally limited to POV intake/review workflows because the authoritative InitialPOVSpec, data model, and query patterns provide no basis for domain-specific endpoints beyond intake clarification management.",
    "No endpoint has been added for search, pagination beyond the query pattern limit, authentication, or fine-grained open-question item mutation because those behaviors are not defined in the authoritative inputs and would require inventing unsupported query patterns or schema changes."
  ]
}
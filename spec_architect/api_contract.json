          "topK": "integer",
          "numCandidates": "integer optional for vector/hybrid",
          "documentTypes": [
            "pdf | csv | google_sheet_export | txt | md | html | doc_export | slack_export | jira_export | conversation_memory | other"
          ],
          "hybridWeights": {
            "vectorWeight": "number required for hybrid",
            "lexicalWeight": "number required for hybrid"
          }

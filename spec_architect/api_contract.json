                "week"
              ],
              "nullable": true
            },
            "startDate": {
              "type": "string",
              "format": "date-time"
            },
            "endDate": {
              "type": "string",
              "format": "date-time"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "team_id": {
                    "type": "string"
                  },
                  "team_name": {
                    "type": "string"
                  },
                  "avg_resolution_hours": {
                    "type": "number",
                    "nullable": true
                  },
                  "resolved_ticket_count": {
                    "type": "number",
                    "nullable": true
                  },
                  "time_bucket": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  },
                  "last_computed_at": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  }
                }
              }
            }
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_DATE_RANGE",
          "when": "startDate/endDate are missing, malformed, or startDate is not before endDate."
        },
        {
          "status": 400,
          "code": "INVALID_GRANULARITY",
          "when": "granularity is invalid, or omitted when source=snapshot."
        }
      ],
      "backing": {
        "type": "conditional_query_pattern",
        "options": [
          {
            "when": {
              "source": "raw"
            },
            "query_pattern_id": "QP-5"
          },
          {
            "when": {
              "source": "snapshot"
            },
            "query_pattern_id": "QP-8"
          }
        ]
      },
      "traceability": {
        "use_cases": [
          "UC-4"
        ],
        "functional_requirements": [
          "FR-11",
          "FR-12",
          "FR-15"
        ]
      }
    }
  ],
  "notes": [
    "No endpoint is defined to generate triage suggestions, compute embeddings, or refresh dashboard snapshots because those operations are not present as authoritative query patterns and are not straightforward CRUD on the provided data model.",
    "No queue-list endpoint is defined because the spec explicitly treats queue viewing as simulated/out of committed scope and no authoritative query pattern covers it.",
    "The dashboard average-resolution-time metric has an asymmetry in authoritative query patterns: raw mode returns a team aggregate across the date range, while snapshot mode can return time-bucketed points. The API preserves this rather than inventing a new raw time-series query."
  ]
}
      }
    },
    {
      "name": "searchDocumentChunks",
      "method": "POST",
      "path": "/tenants/{tenantKey}/search/documents",
      "purpose": "Run tenant-scoped document retrieval over non-agent-memory corpora using vector, lexical, or hybrid search, with optional document-type filters.",

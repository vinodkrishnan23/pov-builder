                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "_id": {
                            "type": "string"
                          },
                          "executive_summary": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "incomplete",
                              "needs_clarification",
                              "ready_for_redesign"
                            ]
                          },
                          "updated_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "open_questions": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "question": {
                                  "type": "string"
                                },
                                "category": {
                                  "type": "string"
                                },
                                "status": {
                                  "type": "string"
                                },
                                "notes": {
                                  "type": "string",
                                  "nullable": true
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "errors": [
              {
                "status": 400,
                "code": "INVALID_STATUS",
                "when": "The path status is not one of the allowed values."
              }
            ]
          }

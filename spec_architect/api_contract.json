        }
      ],
      "backed_by": {
        "type": "query_pattern",
        "id": "QP9"
      }
    },
    {
      "name": "recordBenchmarkRun",
      "method": "POST",
      "path": "/tenants/{tenantId}/benchmark-runs",
      "purpose": "Persist the measured output of a benchmark execution so results can be reviewed and compared across systems and chunking strategies.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "body": {
          "ground_truth_id": "objectId, required",
          "run_label": "string, optional",
          "system_under_test": "string, required, one of [mongodb_atlas, elastic, opensearch, qdrant, pinecone, internal_baseline, other]",
          "retrieval_mode": "string, required, one of [vector, keyword, hybrid]",
          "chunking_strategy": "string, optional, one of [fixed_length, recursive, semantic, contextual]",
          "embedding_model": "string, optional",
          "candidate_pool_filter": {
            "document_ids": [
              "objectId, optional"
            ],
            "source_types": [
              "string, optional"
            ]
          },
          "top_k_results": [
            {
              "rank": "int, required",
              "document_id": "objectId, required",
              "chunk_id": "objectId, optional",
              "score": "number, optional",
              "snippet": "string, optional",
              "is_relevant": "bool, optional"
            }
          ],
          "metrics": {
            "latency_ms": "number, required",
            "precision_at_k": "object, optional",
            "recall_at_k": "object, optional",
            "result_count": "int, optional"
          },
          "run_timestamp": "date-time string, optional; if omitted server may default to current time",
          "notes": "string, optional"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "benchmark_run": {
            "_id": "objectId",
            "tenant_id": "objectId",
            "ground_truth_id": "objectId",
            "run_label": "string|null",
            "system_under_test": "string",
            "retrieval_mode": "string",
            "chunking_strategy": "string|null",
            "embedding_model": "string|null",
            "candidate_pool_filter": "object|null",
            "top_k_results": [
              "object"
            ],
            "metrics": "object",
            "run_timestamp": "date",
            "notes": "string|null"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "when": "Required fields are missing, enums invalid, or metrics/top_k_results shape invalid."
        },
        {
          "status": 404,
          "code": "GROUND_TRUTH_NOT_FOUND",
          "when": "Referenced benchmark ground truth does not exist within tenant."
        }
      ],
      "backed_by": {
        "type": "query_pattern",
        "id": "QP10"
      }
    },
    {
      "name": "compareBenchmarkRuns",
      "method": "POST",
      "path": "/tenants/{tenantId}/benchmark-runs/compare",
      "purpose": "Provide side-by-side benchmark evidence across systems, retrieval modes, and chunking strategies for one or more prompts.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "body": {
          "ground_truth_ids": [
            "objectId, required, at least one"
          ]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "comparisons": [
            {
              "ground_truth_id": "objectId",
              "prompt_text": "string",

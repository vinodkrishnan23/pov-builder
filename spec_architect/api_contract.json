          },
          "request": {
            "query_params": [
              {
                "name": "limit",
                "type": "integer",
                "required": false,
                "default": 50,
                "maximum": 50,
                "notes": "Optional client cap; cannot exceed the authoritative query pattern limit."
              }
            ]
          },
          "response": {
            "status_codes": {
              "200": {
                "description": "Recent POV intakes returned.",
                "body": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "_id": {
                            "type": "string"
                          },
                          "executive_summary": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "incomplete",
                              "needs_clarification",
                              "ready_for_redesign"
                            ]
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updated_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "source_note": {
                            "type": "string",
                            "nullable": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "errors": []
          }
        },
        {
          "operation_id": "listPovIntakesByStatus",
          "method": "GET",
          "path": "/pov-intakes/by-status/{status}",
          "purpose": "List POV intake records filtered by workflow status, ordered by most recently updated.",
          "backed_by": {
            "type": "query_pattern",
            "query_pattern_id": "qp_list_intakes_by_status"

              },
              "sectionPath": [
                "string"
              ],
              "scores": {
                "vector": "number | null",
                "lexical": "number | null",
                "hybrid": "number | null",
                "final": "number"
              },
              "document": {
                "title": "string",
                "documentType": "string",

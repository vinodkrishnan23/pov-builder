                      "summary": {
                        "type": "object",
                        "properties": {
                          "total_events": {
                            "type": "integer"
                          },
                          "expected_final_state": {
                            "type": "string"
                          },
                          "observed_final_state": {
                            "type": "string"
                          },
                          "pass_reason": {
                            "type": "string"
                          },
                          "failure_reason": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }

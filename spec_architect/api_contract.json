    {
      "operationId": "getSimilarResolvedTicketsForTicket",
      "method": "GET",
      "path": "/api/tickets/{ticketId}/similar-resolved",
      "purpose": "Return up to 4 semantically similar resolved historical tickets, including prior resolution details, for the current ticket under review.",
      "request": {
        "pathParams": {
          "ticketId": {
            "type": "string"
          }
        },
        "queryParams": {
          "limit": {
            "type": "integer",
            "required": false,
            "default": 4,
            "allowedValues": [
              3,
              4
            ],
            "description": "UI should request 3 or 4 to align to the stated POV requirement; backend still caps at 4."
          }
        },
        "notes": [
          "Backend must first load the current ticket to obtain text_embedding and ticket_id, then execute the vector search query pattern.",
          "If the current ticket has no text_embedding, the API cannot execute the authoritative vector-search pattern."
        ]
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "ticket_id": {
              "type": "string"
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ticket_id": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "product_line": {
                    "type": "string"
                  },
                  "customer_account_tier": {
                    "type": "string"
                  },
                  "manual_priority": {
                    "type": "string",
                    "nullable": true
                  },
                  "channel": {
                    "type": "string",
                    "nullable": true
                  },
                  "resolved_at": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  },
                  "resolution": {
                    "type": "object",
                    "properties": {
                      "category": {
                        "type": "string"
                      },
                      "summary": {
                        "type": "string"
                      }
                    }
                  },
                  "assigned_team": {
                    "type": "object",
                    "nullable": true,
                    "properties": {
                      "team_id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  },
                  "similarity_score": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "TICKET_NOT_FOUND",
          "when": "No current ticket exists for the supplied ticket_id."
        },
        {
          "status": 409,
          "code": "TICKET_EMBEDDING_MISSING",
          "when": "The current ticket does not have text_embedding, so the vector-search query pattern cannot be run."
        }
      ],
      "backing": {
        "type": "query_pattern",
        "query_pattern_id": "QP-2",
        "prerequisite_read": {
          "type": "mongodb_operation",
          "collection": "support_tickets",
          "operation": "findOne",
          "filter": {
            "ticket_id": "{ticketId}"
          },
          "purpose": "Fetch current ticket embedding and validate existence before running QP-2"
        }
      },
      "traceability": {
        "use_cases": [
          "UC-3"
        ],
        "functional_requirements": [
          "FR-6",
          "FR-7",
          "FR-8",
          "FR-15"
        ],
        "ai_genai_requirements": [
          "AI-3"
        ]
      }
    },

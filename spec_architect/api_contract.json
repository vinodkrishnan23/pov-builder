        },
        {
          "status": 401,
          "code": "UNAUTHENTICATED",
          "message": "Authentication is missing or invalid."
        },
        {
          "status": 403,
          "code": "FORBIDDEN",
          "message": "User is not allowed to access this internal POV."
        },
        {
          "status": 404,
          "code": "TICKET_NOT_FOUND",
          "message": "Source ticket was not found."
        }
      ],
      "backing": {
        "access_validation": "qp8_validate_internal_user_access",
        "data_query": "qp5_fetch_similar_resolved_tickets"
      }
    },
    {
      "operation_id": "resolveTicket",
      "method": "POST",
      "path": "/api/tickets/{ticketId}/resolve",
      "purpose": "Mark a ticket as resolved and record an audit event capturing which internal user performed the action.",
      "request": {
        "path_params": {
          "ticketId": "objectId, required"
        },
        "query_params": {},
        "headers": {
          "Authorization": "string, required by deployment auth mechanism"
        },
        "body": {
          "resolution_summary": {
            "type": "string",
            "required": false,
            "description": "Optional summary of how the ticket was resolved."
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ticket": {
            "id": "objectId",
            "status": "resolved",
            "resolved_at": "date",
            "resolution_summary": "string|null",
            "updated_at": "date"
          },
          "resolution_event": {
            "id": "objectId",
            "ticket_id": "objectId",
            "resolved_by_user_id": "objectId",
            "resolved_at": "date",
            "resolution_summary": "string|null",
            "status_after_action": "resolved"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_TICKET_ID",
          "message": "ticketId is not a valid object id."
        },
        {
          "status": 400,
          "code": "INVALID_REQUEST",
          "message": "Request body is invalid."
        },
        {
          "status": 401,
          "code": "UNAUTHENTICATED",
          "message": "Authentication is missing or invalid."
        },
        {
          "status": 403,
          "code": "FORBIDDEN",
          "message": "User is not allowed to access this internal POV."
        },
        {
          "status": 404,
          "code": "TICKET_NOT_FOUND",
          "message": "Ticket was not found."
        },
        {
          "status": 409,
          "code": "TICKET_NOT_RESOLVABLE",
          "message": "Ticket is already resolved or is not in a resolvable state."
        },
        {
          "status": 500,
          "code": "RESOLUTION_EVENT_WRITE_FAILED",
          "message": "Ticket status may have been updated but writing the audit event failed; backend should use a transaction to avoid this state."
        }
      ],
      "backing": {
        "access_validation": "qp8_validate_internal_user_access",
        "write_queries": [
          "qp6_resolve_ticket_update",
          "qp7_create_resolution_event"
        ],
        "transaction_required": true
      }
    }
  ],
  "notes": [
    "No endpoint has been defined for creating, editing, or regenerating triage guidance because the authoritative data model and query patterns only support viewing current embedded guidance, not managing it.",
    "No endpoint has been defined for listing resolution history because the query patterns include only creation of resolution events, not retrieval of event history.",
    "No customer-facing access endpoints are included; all contract paths are internal-only by design and rely on internal user validation."
  ]
}
    {
      "operationId": "getDashboardTicketVolumeByProductLine",
      "method": "GET",
      "path": "/api/dashboard/ticket-volume-by-product-line",
      "purpose": "Get live chart points for ticket volume by product line over time.",
      "request": {
        "queryParams": {
          "startDate": {
            "type": "string",
            "format": "date-time",
            "required": true
          },
          "endDate": {
            "type": "string",
            "format": "date-time",
            "required": true
          },
          "granularity": {
            "type": "string",
            "required": true,
            "enum": [
              "hour",
              "day",
              "week"
            ]
          },
          "source": {
            "type": "string",
            "required": false,
            "enum": [
              "raw",
              "snapshot"
            ],
            "default": "raw",
            "description": "Chooses whether the endpoint is backed by raw-ticket aggregation or materialized snapshots."
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "metric": {
              "type": "string",

{
  "version": "1.0.0",
  "name": "thoughtspot_pov_api_contract",
  "description": "API contract for MongoDB POV Builder benchmark-oriented document search, agent memory, and side-by-side evaluation workflows.",
  "assumptions": [
    "Tenant context is always supplied in the path and enforced server-side against authenticated access.",
    "Embedding generation, document parsing, and benchmark execution orchestration happen in the application layer; the API persists and retrieves their outputs using the authoritative data model and query patterns.",
    "No endpoint is included for binary file upload streaming because the authoritative data model/query patterns only support storing document metadata plus external storage URI, not raw file blobs.",
    "No endpoint is included to list tenants because no query pattern supports it; tenant creation/get would be straightforward CRUD on the tenants collection and is included only where directly implied by the data model."
  ],
  "endpoints": [
    {
      "operation_id": "createTenant",
      "method": "POST",
      "path": "/v1/tenants",
      "purpose": "Create a tenant/deployment record so documents, agent memory, and benchmark runs can be isolated per customer or demo environment.",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "tenant_key": "string, required",
          "display_name": "string, required",
          "deployment_mode": "enum[saas_isolated|customer_cloud|on_prem_legacy|demo], required",
          "cloud": "enum[aws|gcp|azure|other], optional",
          "status": "enum[active|inactive], required"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "tenant": {
            "id": "objectId",
            "tenant_key": "string",
            "display_name": "string",
            "deployment_mode": "string",
            "cloud": "string|null",
            "status": "string",
            "created_at": "ISO-8601 datetime"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "message": "Missing required fields or invalid enum value."
        },
        {
          "status": 409,
          "code": "TENANT_KEY_CONFLICT",
          "message": "tenant_key already exists if uniqueness is enforced by the application/index."
        }
      ],
      "backing": "MongoDB insertOne on tenants (straightforward CRUD implied by data model)"
    },
    {
      "operation_id": "getTenant",
      "method": "GET",
      "path": "/v1/tenants/{tenantId}",
      "purpose": "Fetch a tenant/deployment record for display and scoping.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "tenant": {
            "id": "objectId",
            "tenant_key": "string",
            "display_name": "string",
            "deployment_mode": "string",
            "cloud": "string|null",
            "status": "string",
            "created_at": "ISO-8601 datetime"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_TENANT_ID",
          "message": "tenantId is not a valid objectId."
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "message": "No tenant found for the given id."
        }
      ],
      "backing": "MongoDB findOne on tenants by _id (straightforward CRUD implied by data model)"
    },
    {
      "operation_id": "createDocumentMetadata",
      "method": "POST",
      "path": "/v1/tenants/{tenantId}/documents",
      "purpose": "Register an uploaded or seeded document and its storage/extraction metadata so it can enter extraction and retrieval workflows.",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "path_params": {
          "tenantId": "objectId, required"
        },
        "body": {
          "source_type": "enum[live_upload|seeded|baseline_import], required",
          "title": "string, required",
          "file_name": "string, optional",
          "mime_type": "string, optional",
          "file_size_bytes": "int64, optional",
          "storage": {
            "provider": "enum[s3|gcs|azure_blob|local|none], required when storage supplied",
            "uri": "string, required when storage supplied"
          },
          "metadata": {
            "source_system": "string, optional",
            "uploaded_by": "string, optional",
            "tags": [
              "string, optional"
            ],
            "language": "string, optional",
            "page_count": "int32, optional"
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "document": {
            "id": "objectId",
            "tenant_id": "objectId",
            "source_type": "string",
            "title": "string",
            "file_name": "string|null",
            "mime_type": "string|null",
            "file_size_bytes": "number|null",
            "storage": {
              "provider": "string",
              "uri": "string"
            },
            "metadata": {
              "source_system": "string|null",
              "uploaded_by": "string|null",
              "tags": [
                "string"
              ],
              "language": "string|null",
              "page_count": "number|null"
            },
            "extraction": {
              "status": "pending"
            },
            "created_at": "ISO-8601 datetime"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "message": "Missing required fields or invalid enum value."
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "message": "Tenant does not exist."
        }
      ],
      "backing": "QP1"
    },
    {
      "operation_id": "updateDocumentExtraction",
      "method": "PATCH",
      "path": "/v1/tenants/{tenantId}/documents/{documentId}/extraction",
      "purpose": "Update extraction progress, extracted text, preview text, and errors for a document after parsing.",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "path_params": {
          "tenantId": "objectId, required",
          "documentId": "objectId, required"
        },
        "body": {
          "status": "enum[processing|completed|failed], required",
          "extracted_text": "string, optional",
          "content_preview": "string, optional",
          "error_message": "string, optional"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "document": {
            "id": "objectId",
            "tenant_id": "objectId",
            "extraction": {
              "status": "string",
              "extracted_text": "string|null",
              "content_preview": "string|null",
              "error_message": "string|null",
              "processed_at": "ISO-8601 datetime"
            }
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "message": "Invalid extraction payload."
        },
        {
          "status": 404,
          "code": "DOCUMENT_NOT_FOUND",
          "message": "Document not found for tenant."
        }
      ],
      "backing": "QP2"
    },
    {
      "operation_id": "createDocumentChunks",
      "method": "POST",
      "path": "/v1/tenants/{tenantId}/documents/{documentId}/chunks:batchCreate",
      "purpose": "Store chunked text and embeddings for one document under a chosen chunking strategy.",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "path_params": {
          "tenantId": "objectId, required",
          "documentId": "objectId, required"
        },
        "body": {
          "chunks": [
            {
              "chunking_strategy": "enum[fixed_length|recursive|semantic|contextual], required",
              "chunk_index": "int32, required",
              "text": "string, required",
              "token_count": "int32, optional",
              "page_span": {
                "start_page": "int32, optional",
                "end_page": "int32, optional"
              },
              "embedding_model": "string, required",
              "embedding": [
                "float, required"
              ],
              "embedding_dimensions": "int32, required"
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "body": {
          "inserted_count": "number",
          "document_id": "objectId",
          "tenant_id": "objectId",
          "chunking_strategy": "string",
          "chunk_ids": [
            "objectId"
          ]
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "message": "Invalid chunk batch payload."
        },
        {
          "status": 404,
          "code": "DOCUMENT_NOT_FOUND",
          "message": "Document not found for tenant."
        }
      ],
      "backing": "QP3"
    },
    {
      "operation_id": "vectorSearchDocumentChunks",
      "method": "POST",
      "path": "/v1/tenants/{tenantId}/search/document-vector",
      "purpose": "Retrieve the most relevant document chunks for a query embedding within one tenant and one chunking strategy.",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "path_params": {

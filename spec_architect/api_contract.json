                "ticket_volume_by_product_line"
              ]
            },
            "source": {
              "type": "string",
              "enum": [
                "raw",
                "snapshot"
              ]
            },
            "granularity": {
              "type": "string",
              "enum": [
                "hour",
                "day",
                "week"
              ]
            },
            "startDate": {
              "type": "string",
              "format": "date-time"
            },
            "endDate": {
              "type": "string",
              "format": "date-time"
            },
            "points": {
              "type": "array",

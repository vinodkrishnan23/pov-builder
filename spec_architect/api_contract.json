                  },
                  "product_line": {
                    "type": "string"
                  },
                  "ticket_count": {
                    "type": "number"
                  },
                  "last_computed_at": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  }
                }
              }
            }
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_DATE_RANGE",
          "when": "startDate/endDate are missing, malformed, or startDate is not before endDate."

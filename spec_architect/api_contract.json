{
  "service": "northwind_support_pov_api",
  "version": "1.0.0",
  "scope": {
    "in_scope": [
      "ticket triage suggestion retrieval for simulated/internal POV review",
      "similar resolved ticket retrieval for agent assistance",
      "live dashboard metric retrieval",
      "reference retrieval of support teams",
      "straightforward CRUD needed to create and inspect simulated POV tickets"
    ],
    "out_of_scope": [
      "production helpdesk integration",
      "customer-facing access",
      "workflow actions like full queue management or mark-resolved APIs unless directly supported by existing model/query patterns",
      "inventing model-training or inference orchestration endpoints not backed by the authoritative model/query patterns"
    ]
  },
  "resources": {
    "tickets": {
      "collection": "support_tickets",
      "identifier": "ticket_id"
    },
    "teams": {
      "collection": "support_teams",
      "identifier": "team_id"
    },
    "dashboard_metric_snapshots": {
      "collection": "dashboard_metric_snapshots"
    }
  },
  "endpoints": [
    {
      "operationId": "createSimulatedTicket",
      "method": "POST",
      "path": "/api/tickets",
      "purpose": "Create a simulated POV ticket that can later be reviewed for triage assistance and similar-ticket retrieval. This is a straightforward create on support_tickets and is limited to simulated/internal tickets.",
      "request": {
        "contentType": "application/json",
        "body": {
          "type": "object",
          "required": [
            "ticket_id",
            "subject",
            "description",
            "customer_account_tier",
            "product_line",
            "status",
            "created_at",
            "is_historical_import"
          ],
          "properties": {
            "ticket_id": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "customer_account_tier": {
              "type": "string"
            },
            "product_line": {
              "type": "string"
            },
            "manual_priority": {
              "type": "string",
              "nullable": true
            },
            "channel": {
              "type": "string",
              "enum": [
                "email",
                "chat",
                "phone"
              ],
              "nullable": true
            },
            "status": {
              "type": "string",
              "enum": [
                "new",
                "open",
                "resolved",
                "closed"
              ]
            },
            "assigned_team_id": {
              "type": "string",
              "description": "MongoDB ObjectId string for support_teams._id",
              "nullable": true
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "triaged_at": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "resolved_at": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "resolution": {
              "type": "object",
              "nullable": true,
              "properties": {
                "category": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                }
              }
            },
            "triage_suggestion": {
              "type": "object",
              "nullable": true,
              "properties": {
                "suggested_priority": {
                  "type": "string",
                  "nullable": true
                },
                "suggested_team_id": {
                  "type": "string",
                  "description": "MongoDB ObjectId string for support_teams._id",
                  "nullable": true
                },
                "generated_at": {
                  "type": "string",
                  "format": "date-time",
                  "nullable": true
                },
                "model_version": {
                  "type": "string",
                  "nullable": true
                },
                "confidence": {
                  "type": "number",
                  "nullable": true
                }
              }
            },
            "text_embedding": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "nullable": true
            },
            "ingest_batch_id": {
              "type": "string",
              "nullable": true
            },
            "is_historical_import": {
              "type": "boolean",
              "enum": [
                false
              ],
              "description": "For this endpoint, only simulated/non-historical tickets should be created."
            }
          }
        },
        "notes": [
          "This endpoint does not itself generate triage suggestions or embeddings; it only stores provided fields.",
          "If triage_suggestion is omitted, later triage review may return no suggestion yet."
        ]
      },
      "response": {
        "status": 201,
        "body": {
          "type": "object",
          "properties": {
            "ticket_id": {
              "type": "string"
            },
            "created": {
              "type": "boolean"
            },
            "ticket": {
              "type": "object",
              "properties": {
                "ticket_id": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "customer_account_tier": {
                  "type": "string"
                },
                "product_line": {
                  "type": "string"
                },
                "manual_priority": {
                  "type": "string",
                  "nullable": true
                },
                "channel": {
                  "type": "string",
                  "nullable": true
                },
                "status": {
                  "type": "string"
                },
                "assigned_team_id": {
                  "type": "string",
                  "nullable": true
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "triaged_at": {
                  "type": "string",
                  "format": "date-time",
                  "nullable": true
                },
                "resolved_at": {
                  "type": "string",
                  "format": "date-time",
                  "nullable": true
                },
                "resolution": {
                  "type": "object",
                  "nullable": true
                },
                "triage_suggestion": {
                  "type": "object",
                  "nullable": true
                },
                "ingest_batch_id": {
                  "type": "string",
                  "nullable": true
                },
                "is_historical_import": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "errors": [
          {
            "status": 400,
            "code": "INVALID_REQUEST",
            "when": "Required fields are missing, enum/date formats are invalid, or is_historical_import is not false."
          },
          {
            "status": 409,
            "code": "TICKET_ID_ALREADY_EXISTS",
            "when": "A ticket with the same ticket_id already exists."
          }
        ],
        "backing": {
          "type": "mongodb_operation",
          "collection": "support_tickets",
          "operation": "insertOne"
        },
        "traceability": {
          "use_cases": [
            "UC-1",
            "UC-2",
            "UC-3"
          ],
          "functional_requirements": [
            "FR-1",
            "FR-15",
            "FR-17"
          ]
        }
      },
      ":{": "invalid due to formatting issue, ignore"
    },
    {
      "operationId": "getTicketById",
      "method": "GET",
      "path": "/api/tickets/{ticketId}",
      "purpose": "Fetch a ticket by ticket_id for simulated POV review or inspection.",
      "request": {
        "pathParams": {
          "ticketId": {
            "type": "string"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {

                "status": 404,
                "code": "NOT_FOUND",
                "when": "No POV intake exists for the provided id."
              }
            ]
          }
        },
        {
          "operation_id": "updatePovIntake",
          "method": "PATCH",
          "path": "/pov-intakes/{pov_intake_id}",
          "purpose": "Update mutable fields on an existing POV intake record, such as status, review result, open questions, assumptions, success criteria, executive summary, raw input, or source note.",
          "backed_by": {
            "type": "crud",
            "mongodb_operation": "updateOne",
            "collection": "pov_intake",
            "notes": "Straightforward partial update implied by the authoritative data model. Server always updates updated_at."
          },
          "request": {
            "path_params": [
              {
                "name": "pov_intake_id",
                "type": "string",
                "required": true,
                "format": "objectId"
              }
            ],
            "body": {
              "type": "object",
              "properties": {
                "executive_summary": {
                  "type": "string"
                },
                "raw_initial_pov_spec": {
                  "type": "object"
                },
                "review_result": {
                  "type": "object"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "incomplete",
                    "needs_clarification",
                    "ready_for_redesign"
                  ]
                },
                "open_questions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "question",
                      "category",
                      "status"
                    ],
                    "properties": {
                      "question": {
                        "type": "string"
                      },
                      "category": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "notes": {
                        "type": "string",
                        "nullable": true
                      }
                    }
                  }
                },
                "assumptions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "success_criteria": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "source_note": {
                  "type": "string",
                  "nullable": true
                }
              },
              "additionalProperties": false,
              "minProperties": 1
            }
          },
          "response": {
            "status_codes": {
              "200": {
                "description": "POV intake updated.",
                "body": {
                  "type": "object",
                  "properties": {
                    "matched_count": {
                      "type": "integer"
                    },
                    "modified_count": {
                      "type": "integer"
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            },
            "errors": [
              {
                "status": 400,
                "code": "INVALID_ID",
                "when": "The pov_intake_id is not a valid ObjectId."
              },
              {
                "status": 400,
                "code": "VALIDATION_ERROR",
                "when": "Body is empty, contains unknown fields, invalid types, or invalid status values."
              },
              {
                "status": 404,
                "code": "NOT_FOUND",
                "when": "No POV intake exists for the provided id."
              }
            ]
          }
        },

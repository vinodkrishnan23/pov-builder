{
  "version": "1.0.0",
  "pov_scope": "Assess or validate the fixed streaming progress endpoint through end-to-end testing.",
  "resources": [
    {
      "name": "test_runs",
      "description": "End-to-end validation runs for the streaming progress endpoint.",
      "endpoints": [
        {
          "operationId": "createTestRun",
          "method": "POST",
          "path": "/test-runs",
          "purpose": "Create a new end-to-end validation run record before or at test start.",
          "request": {
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "type": "object",
              "required": [
                "status",
                "started_at",
                "endpoint_path",
                "endpoint_method"
              ],
              "properties": {
                "run_name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "queued"
                  ],
                  "description": "Must be queued on creation, per qp-1."
                },
                "started_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "endpoint_path": {
                  "type": "string"
                },
                "endpoint_method": {
                  "type": "string",
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE"
                  ]
                },
                "environment": {
                  "type": "string"
                },
                "initiated_by": {
                  "type": "string"
                },
                "summary": {
                  "type": "object",
                  "properties": {
                    "total_events": {
                      "type": "integer"
                    },
                    "expected_final_state": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "response": {
            "status": 201,
            "body": {
              "type": "object",
              "properties": {
                "_id": {
                  "type": "string",
                  "description": "MongoDB ObjectId as hex string"
                },
                "run_name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "queued"
                  ]
                },
                "started_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "endpoint_path": {
                  "type": "string"
                },
                "endpoint_method": {
                  "type": "string",
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE"
                  ]
                },
                "environment": {
                  "type": "string"
                },
                "initiated_by": {
                  "type": "string"
                },
                "summary": {
                  "type": "object",
                  "properties": {
                    "total_events": {
                      "type": "integer"
                    },
                    "expected_final_state": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "errors": [
            {
              "status": 400,
              "code": "INVALID_REQUEST",
              "cases": [
                "Missing required fields",
                "status is not 'queued' on create",
                "endpoint_method is not one of allowed values",
                "Body contains fields not supported by the data model/query pattern"
              ]
            }
          ],
          "backing": "qp-1"
        },
        {
          "operationId": "listTestRuns",
          "method": "GET",
          "path": "/test-runs",

{
  "service_name": "brms_execution_logging_api",
  "version": "1.0.0",
  "description": "API contract for MongoDB-backed BRMS execution logging POV. Endpoints are limited to straightforward CRUD on the authoritative data model or to the authoritative query patterns QP1-QP14. No unsupported endpoints are introduced for features not backed by the model/query patterns.",
  "base_path": "/api/v1",
  "content_type": "application/json",
  "authz_note": "Detailed execution-log and analytics endpoints are intended for admin/privileged users per FR11. External-consumer-facing outcome retrieval omits rule-step internals per FR12.",
  "endpoints": [
    {
      "operation_id": "getExecutionAuditByRequestId",
      "method": "GET",
      "path": "/execution-requests/{requestId}",
      "purpose": "Retrieve the full stored audit record for one execution request, including request/response payloads and all embedded rule-level steps.",
      "backed_by": {
        "type": "query_pattern",
        "id": "QP1",
        "mongodb_operation": "findOne on execution_requests"
      },
      "path_params": [
        {
          "name": "requestId",
          "type": "string",
          "required": true
        }
      ],
      "query_params": [
        {
          "name": "tenant_id",
          "type": "string",
          "required": false,
          "description": "Optional tenant scoping value. Not part of QP1 filter, but may be enforced by application-layer authorization if tenant isolation is enabled."
        }
      ],
      "request_body": null,
      "response_body": {
        "success": {
          "request_id": "string",
          "tenant_id": "string|null",
          "correlation_id": "string|null",
          "policy_id": "string",
          "policy_version": "string",
          "invocation_channel": "api|mobile|portal|banking_app|batch|other|null",
          "logging_enabled": "boolean",
          "request_received_at": "date-time",
          "execution_completed_at": "date-time|null",
          "status": "received|in_progress|completed|failed|partially_logged",
          "final_outcome": "string|null",
          "outcome_reason_codes": [
            "string"
          ],
          "request_payload": {
            "type": "object"
          },
          "response_payload": {
            "type": "object|null"
          },
          "rule_step_count": "number",
          "rule_steps": [
            {
              "step_no": "number",
              "logged_at": "date-time",
              "rule_id": "string|null",
              "rule_name": "string|null",
              "rule_sequence": "number|null",
              "stage_name": "string|null",
              "step_status": "started|completed|failed|skipped|null",
              "input_snapshot": {
                "type": "object|null"
              },
              "output_snapshot": {
                "type": "object|null"
              },
              "decision": "string|null",
              "reason": "string|null",
              "lookup_performed": "boolean|null",
              "lookup_details": {
                "type": "object|null"
              }
            }
          ],
          "ingestion_metadata": {
            "source_type": "kafka|queue|direct_api|batch|null",
            "source_message_id": "string|null",
            "ingested_at": "date-time|null",
            "ingestion_status": "pending|ingested|error|null",
            "error_message": "string|null"
          },
          "retention": {
            "expire_at": "date-time|null",
            "retention_class": "short|standard|extended|legal_hold|null",
            "purge_hold": "boolean|null"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_REQUEST_ID",
          "message": "requestId must be a non-empty string."
        },
        {
          "status": 401,
          "code": "UNAUTHORIZED",
          "message": "Authentication required."
        },
        {
          "status": 403,
          "code": "FORBIDDEN",
          "message": "Caller is not permitted to view detailed execution logs."
        },
        {
          "status": 404,
          "code": "NOT_FOUND",
          "message": "No execution request found for the supplied requestId."
        }
      ]
    },
    {

{
  "version": "1.0.0",
  "service_name": "pov-intake-api",
  "base_path": "/api",
  "content_type": "application/json",
  "resources": [
    {
      "name": "pov_intakes",
      "endpoints": [
        {
          "operation_id": "createPovIntake",
          "method": "POST",
          "path": "/pov-intakes",
          "purpose": "Create a new POV intake record from an InitialPOVSpec and review context.",
          "backed_by": {
            "type": "crud",
            "mongodb_operation": "insertOne",
            "collection": "pov_intake",
            "notes": "Straightforward create operation implied by the authoritative data model."
          },
          "request": {
            "body": {
              "type": "object",
              "required": [
                "executive_summary",
                "raw_initial_pov_spec",
                "review_result",
                "status",
                "open_questions",
                "assumptions",
                "success_criteria"
              ],
              "properties": {
                "executive_summary": {
                  "type": "string"
                },
                "raw_initial_pov_spec": {
                  "type": "object"
                },
                "review_result": {
                  "type": "object"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "incomplete",
                    "needs_clarification",
                    "ready_for_redesign"
                  ]
                },
                "open_questions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "question",
                      "category",
                      "status"
                    ],
                    "properties": {
                      "question": {
                        "type": "string"
                      },
                      "category": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "notes": {
                        "type": "string",
                        "nullable": true
                      }
                    }
                  }
                },
                "assumptions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "success_criteria": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "source_note": {
                  "type": "string"
                }
              }
            },
            "notes": "Server sets _id, created_at, and updated_at."
          },
          "response": {
            "status_codes": {
              "201": {
                "description": "POV intake created.",
                "body": {
                  "type": "object",
                  "properties": {
                    "_id": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "executive_summary": {
                      "type": "string"
                    },
                    "raw_initial_pov_spec": {
                      "type": "object"
                    },
                    "review_result": {
                      "type": "object"
                    },
                    "status": {
                      "type": "string"
                    },
                    "open_questions": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "assumptions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "success_criteria": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "source_note": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            },
            "errors": [
              {
                "status": 400,
                "code": "VALIDATION_ERROR",
                "when": "Required fields are missing, field types are invalid, or status is not an allowed value."
              }
            ]
          }
        },
        {
          "operation_id": "listRecentPovIntakes",

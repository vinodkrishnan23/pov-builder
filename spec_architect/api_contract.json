{
  "version": "1.0.0",
  "pov_name": "thoughtspot_ai_retrieval_pov",
  "base_url": "/api/v1",
  "content_type": "application/json",
  "authentication": {
    "note": "Authentication/authorization scheme is out of scope in the provided data model and query patterns. All endpoints are tenant-scoped and should enforce tenant isolation in implementation."
  },
  "conventions": {
    "id_type": "objectId",
    "timestamps": "ISO-8601 date-time strings",
    "error_response": {
      "error": {
        "code": "string",
        "message": "string",
        "details": "object|null"
      }
    }
  },
  "endpoints": [
    {
      "name": "createTenant",
      "method": "POST",
      "path": "/tenants",
      "purpose": "Create a tenant/demo context used to isolate documents, benchmark prompts, and benchmark runs for a POV session.",
      "request": {
        "body": {
          "tenant_key": "string, required, unique",
          "display_name": "string, required",
          "deployment_model": "string, optional, one of [saas_shared, saas_isolated, customer_isolated]",
          "cloud": "string, optional, one of [aws, gcp, azure, other]",
          "notes": "string, optional"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "tenant": {
            "_id": "objectId",
            "tenant_key": "string",
            "display_name": "string",
            "deployment_model": "string|null",
            "cloud": "string|null",
            "notes": "string|null",
            "created_at": "date"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "when": "Required fields are missing or enum values are invalid."
        },
        {
          "status": 409,
          "code": "TENANT_KEY_CONFLICT",
          "when": "tenant_key already exists."
        }
      ],
      "backed_by": {
        "type": "CRUD",
        "operation": "tenants.insertOne",
        "notes": "Straightforward create implied by tenants collection and unique tenant_key index."
      }
    },
    {
      "name": "listTenantDocuments",
      "method": "GET",
      "path": "/tenants/{tenantId}/documents",
      "purpose": "List recently ingested tenant documents for the live demo, with filtering by document/source type and processing status.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "query_params": {
          "document_types": "comma-separated strings, optional; defaults to uploaded_file,benchmark_supporting_doc",
          "source_types": "comma-separated strings, optional",
          "processing_statuses": "comma-separated strings, optional",
          "limit": "int, optional, max 100, default 100"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "documents": [
            {
              "_id": "objectId",
              "title": "string|null",
              "original_filename": "string|null",
              "document_type": "string",
              "source_type": "string",
              "processing_status": "string",
              "storage_location_type": "string|null",
              "ingested_at": "date",
              "metadata": {
                "tags": [
                  "string"
                ]
              }
            }
          ],
          "count": "int"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "when": "tenantId or filter values are invalid."
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "when": "Tenant does not exist."
        }
      ],
      "backed_by": {
        "type": "query_pattern",
        "id": "QP1"
      }
    },
    {
      "name": "createDocument",
      "method": "POST",
      "path": "/tenants/{tenantId}/documents",
      "purpose": "Register a new uploaded document, benchmark supporting document, or agent memory document in the tenant before or during the live session.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "body": {
          "document_type": "string, required, one of [uploaded_file, agent_memory, benchmark_supporting_doc]",
          "source_type": "string, required, one of [pdf, csv, google_sheet, text, research_paper, business_document, jira_export, slack_export, conversation_context, other]",
          "title": "string, optional",
          "original_filename": "string, optional",
          "mime_type": "string, optional",
          "source_uri": "string, optional",
          "storage_location_type": "string, optional, one of [atlas, s3, external_url, inline]",
          "raw_text": "string, optional",
          "metadata": {
            "author": "string, optional",
            "language": "string, optional",
            "tags": [
              "string"
            ],
            "created_by": "string, optional",
            "conversation_id": "string, optional",
            "session_id": "string, optional"
          },
          "processing_status": "string, required, one of [uploaded, parsed, chunked, embedded, failed]"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "document": {
            "_id": "objectId",
            "tenant_id": "objectId",
            "document_type": "string",
            "source_type": "string",
            "title": "string|null",
            "original_filename": "string|null",
            "mime_type": "string|null",
            "source_uri": "string|null",
            "storage_location_type": "string|null",
            "raw_text": "string|null",
            "metadata": "object|null",
            "processing_status": "string",
            "ingested_at": "date",
            "updated_at": "date"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "when": "Required fields are missing, enum values are invalid, or metadata shape is invalid."
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "when": "Tenant does not exist."
        }
      ],
      "backed_by": {
        "type": "CRUD",
        "operation": "documents.insertOne",
        "notes": "Straightforward create implied by documents collection."
      }
    },
    {
      "name": "listAgentMemoryDocuments",
      "method": "GET",
      "path": "/tenants/{tenantId}/agent-memory",
      "purpose": "List conversation-derived memory documents for a conversation or session before running memory retrieval.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "query_params": {
          "conversation_id": "string, conditionally required if session_id absent",
          "session_id": "string, conditionally required if conversation_id absent",
          "limit": "int, optional, max 50, default 50"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "documents": [
            {
              "_id": "objectId",
              "title": "string|null",
              "source_type": "string",
              "metadata": {
                "conversation_id": "string|null",
                "session_id": "string|null"
              },
              "processing_status": "string",
              "ingested_at": "date",
              "updated_at": "date"
            }
          ],
          "count": "int"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "when": "tenantId invalid or neither conversation_id nor session_id is provided."
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "when": "Tenant does not exist."
        }
      ],
      "backed_by": {
        "type": "query_pattern",
        "id": "QP2"
      }
    },
    {
      "name": "inspectDocumentChunks",
      "method": "GET",
      "path": "/tenants/{tenantId}/documents/{documentId}/chunks",
      "purpose": "Inspect how a document was chunked across one or more chunking strategies for comparison and troubleshooting.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required",
          "documentId": "objectId, required"
        },
        "query_params": {
          "chunking_strategies": "comma-separated strings, optional; defaults to all four strategies",
          "limit": "int, optional, max 500, default 500"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "chunks": [
            {
              "_id": "objectId",
              "document_id": "objectId",
              "chunking_strategy": "string",
              "strategy_params": {
                "chunk_size": "int|null",
                "chunk_overlap": "int|null",
                "separator_policy": "string|null",
                "notes": "string|null"
              },
              "chunk_index": "int",
              "text": "string",
              "token_count": "int|null",
              "page_span": {
                "start_page": "int|null",
                "end_page": "int|null"
              },
              "embedding_model": "string|null"
            }
          ],
          "count": "int"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "when": "tenantId, documentId, or strategy filters are invalid."
        },
        {
          "status": 404,
          "code": "DOCUMENT_NOT_FOUND",
          "when": "Document does not exist within tenant."
        }
      ],
      "backed_by": {
        "type": "query_pattern",
        "id": "QP3"
      }
    },
    {
      "name": "runDocumentKeywordSearch",
      "method": "POST",
      "path": "/tenants/{tenantId}/retrieval/document-search/keyword",
      "purpose": "Run lexical retrieval over chunk text as a keyword baseline for document search comparison.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "body": {
          "query_text": "string, required",
          "chunking_strategy": "string, required, one of [fixed_length, recursive, semantic, contextual]",
          "document_ids": [
            "objectId, optional"
          ],
          "limit": "int, optional, max 20, default 20"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "retrieval_mode": "keyword",
          "results": [
            {
              "rank": "int",
              "document_id": "objectId",
              "chunk_id": "objectId",
              "score": "number|null",
              "snippet": "string|null",
              "document_title": "string|null",
              "source_type": "string"
            }
          ],
          "count": "int"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "when": "query_text missing, tenantId invalid, or chunking_strategy invalid."
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "when": "Tenant does not exist."
        }
      ],
      "backed_by": {
        "type": "query_pattern",
        "id": "QP4",
        "notes": "Implementation may apply request limit within the aggregation response shaping, but authoritative retrieval logic is QP4."
      }
    },
    {
      "name": "runDocumentVectorSearch",
      "method": "POST",
      "path": "/tenants/{tenantId}/retrieval/document-search/vector",
      "purpose": "Run semantic vector retrieval over chunks for document search within a selected chunking strategy.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "body": {
          "query_text": "string, required for embedding generation outside MongoDB",
          "query_embedding": [
            "float, required"
          ],
          "chunking_strategy": "string, required, one of [fixed_length, recursive, semantic, contextual]",
          "document_ids": [
            "objectId, optional"
          ],
          "limit": "int, optional, max 20, default 20"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "retrieval_mode": "vector",
          "results": [
            {
              "rank": "int",
              "document_id": "objectId",
              "chunk_id": "objectId",
              "score": "number|null",
              "snippet": "string|null",
              "page_span": {
                "start_page": "int|null",
                "end_page": "int|null"
              },
              "document_title": "string|null",
              "source_type": "string",
              "document_type": "string"
            }
          ],
          "count": "int"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "when": "query_embedding missing/invalid, tenantId invalid, or chunking_strategy invalid."
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "when": "Tenant does not exist."
        }
      ],
      "backed_by": {
        "type": "query_pattern",
        "id": "QP5",
        "notes": "Embedding generation is an application-service concern; query execution is backed by QP5."
      }
    },
    {
      "name": "runHybridSearch",
      "method": "POST",
      "path": "/tenants/{tenantId}/retrieval/hybrid",
      "purpose": "Run hybrid retrieval that combines vector and keyword scores for side-by-side comparison against pure keyword or vector retrieval.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "body": {
          "query_text": "string, required",
          "query_embedding": [
            "float, required"
          ],
          "chunking_strategy": "string, required, one of [fixed_length, recursive, semantic, contextual]",
          "limit": "int, optional, max 20, default 20"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "retrieval_mode": "hybrid",
          "results": [
            {
              "rank": "int",
              "document_id": "objectId",
              "chunk_id": "objectId",
              "combined_score": "number",
              "vector_score": "number|null",
              "keyword_score": "number|null",
              "snippet": "string|null",
              "document_title": "string|null",
              "document_type": "string"
            }
          ],
          "count": "int"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "when": "query_text or query_embedding missing/invalid, tenantId invalid, or chunking_strategy invalid."
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "when": "Tenant does not exist."
        }
      ],
      "backed_by": {
        "type": "query_pattern",
        "id": "QP6"
      }
    },
    {
      "name": "runAgentMemoryVectorRetrieval",
      "method": "POST",
      "path": "/tenants/{tenantId}/retrieval/agent-memory/vector",
      "purpose": "Fetch the most relevant memory snippets for an agent from conversation-derived documents in the current conversation or session scope.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "body": {
          "query_text": "string, required for embedding generation outside MongoDB",
          "query_embedding": [
            "float, required"
          ],
          "chunking_strategy": "string, required, one of [fixed_length, recursive, semantic, contextual]",
          "conversation_id": "string, conditionally required if session_id absent",
          "session_id": "string, conditionally required if conversation_id absent"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "retrieval_mode": "vector",
          "task_type": "agent_memory",
          "results": [
            {
              "rank": "int",
              "document_id": "objectId",
              "chunk_id": "objectId",
              "score": "number|null",
              "snippet": "string|null",
              "conversation_id": "string|null",
              "session_id": "string|null",
              "updated_at": "date"
            }
          ],
          "count": "int"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "when": "query_embedding invalid or neither conversation_id nor session_id is provided."
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "when": "Tenant does not exist."
        }
      ],
      "backed_by": {
        "type": "query_pattern",
        "id": "QP7",
        "notes": "Only vector agent-memory retrieval is supported by the authoritative query patterns. No keyword/hybrid agent-memory endpoint is defined because no matching query pattern was provided."
      }
    },
    {
      "name": "createBenchmarkGroundTruth",
      "method": "POST",
      "path": "/tenants/{tenantId}/benchmark-ground-truths",
      "purpose": "Create a customer-provided benchmark prompt and expected targets during the live session.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "body": {
          "prompt_text": "string, required",
          "task_type": "string, required, one of [document_search, agent_memory]",
          "ground_truth_text": "string, optional",
          "relevant_document_ids": [
            "objectId, optional"
          ],
          "relevant_chunk_ids": [
            "objectId, optional"
          ],
          "top_k_targets": [
            "int, optional"
          ],
          "provided_during_session": "bool, required",
          "notes": "string, optional"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "benchmark_ground_truth": {
            "_id": "objectId",
            "tenant_id": "objectId",
            "prompt_text": "string",
            "task_type": "string",
            "ground_truth_text": "string|null",
            "relevant_document_ids": [
              "objectId"
            ],
            "relevant_chunk_ids": [
              "objectId"
            ],
            "top_k_targets": [
              "int"
            ],
            "provided_during_session": "bool",
            "notes": "string|null",
            "created_at": "date"
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "when": "Required fields are missing or enum values are invalid."
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "when": "Tenant does not exist."
        }
      ],
      "backed_by": {
        "type": "CRUD",
        "operation": "benchmark_ground_truths.insertOne",
        "notes": "Straightforward create implied by benchmark_ground_truths collection; listing/detail use authoritative query patterns below."
      }
    },
    {
      "name": "listBenchmarkGroundTruths",
      "method": "GET",
      "path": "/tenants/{tenantId}/benchmark-ground-truths",
      "purpose": "List customer-provided benchmark prompts and expected targets supplied during the live session.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required"
        },
        "query_params": {
          "task_type": "string, required, one of [document_search, agent_memory]",
          "provided_during_session": "bool, optional, default true"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "benchmark_ground_truths": [
            {
              "_id": "objectId",
              "prompt_text": "string",
              "task_type": "string",
              "ground_truth_text": "string|null",
              "relevant_document_ids": [
                "objectId"
              ],
              "relevant_chunk_ids": [
                "objectId"
              ],
              "top_k_targets": [
                "int"
              ],
              "notes": "string|null",
              "created_at": "date"
            }
          ],
          "count": "int"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "when": "tenantId invalid or task_type invalid/missing."
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "when": "Tenant does not exist."
        }
      ],
      "backed_by": {
        "type": "query_pattern",
        "id": "QP8",
        "notes": "Primary supported mode is provided_during_session=true per QP8; exposing false would not be backed by the authoritative pattern, so default behavior should remain true."
      }
    },
    {
      "name": "getBenchmarkGroundTruthDetail",
      "method": "GET",
      "path": "/tenants/{tenantId}/benchmark-ground-truths/{groundTruthId}",
      "purpose": "Fetch a benchmark prompt together with linked relevant documents and chunks for scoring and explanation.",
      "request": {
        "path_params": {
          "tenantId": "objectId, required",
          "groundTruthId": "objectId, required"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "benchmark_ground_truth": {
            "_id": "objectId",
            "prompt_text": "string",
            "task_type": "string",
            "ground_truth_text": "string|null",
            "top_k_targets": [
              "int"
            ],
            "relevant_documents": [
              {
                "_id": "objectId",
                "title": "string|null",
                "source_type": "string"
              }
            ],
            "relevant_chunks": [
              {
                "_id": "objectId",
                "document_id": "objectId",
                "chunking_strategy": "string",
                "chunk_index": "int",
                "text": "string"
              }
            ]
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "when": "tenantId or groundTruthId is invalid."
        },
        {
          "status": 404,
          "code": "GROUND_TRUTH_NOT_FOUND",

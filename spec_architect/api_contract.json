              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "customer_account_tier": {
              "type": "string"
            },
            "product_line": {
              "type": "string"
            },
            "manual_priority": {
              "type": "string",
              "nullable": true
            },
            "channel": {
              "type": "string",
              "nullable": true
            },
            "status": {
              "type": "string"
            },
            "assigned_team_id": {
              "type": "string",
              "nullable": true
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "triaged_at": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "resolved_at": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "resolution": {
              "type": "object",
              "nullable": true
            },
            "triage_suggestion": {
              "type": "object",
              "nullable": true
            },
            "ingest_batch_id": {
              "type": "string",
              "nullable": true
            },
            "is_historical_import": {
              "type": "boolean"
            }
          }
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "TICKET_NOT_FOUND",
          "when": "No ticket exists for the supplied ticket_id."
        }
      ],
      "backing": {
        "type": "mongodb_operation",
        "collection": "support_tickets",
        "operation": "findOne",
        "filter": {
          "ticket_id": "{ticketId}"
        }
      },
      "traceability": {
        "functional_requirements": [
          "FR-1",
          "FR-17"
        ]
      }
    },
    {

              "endpoint_path": {
                "type": "string",
                "required": false
              },
              "environment": {
                "type": "string",
                "required": false
              },
              "status": {
                "type": "string",
                "required": false,
                "enum": [
                  "queued",
                  "running",
                  "passed",
                  "failed",
                  "cancelled"
                ]
              },
              "started_at_gte": {
                "type": "string",
                "format": "date-time",
                "required": false
              },
              "started_at_lte": {
                "type": "string",
                "format": "date-time",
                "required": false
              },
              "limit": {
                "type": "integer",
                "required": false,
                "minimum": 1

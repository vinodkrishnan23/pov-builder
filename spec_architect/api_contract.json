                      "started_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "completed_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "endpoint_path": {
                        "type": "string"
                      },
                      "endpoint_method": {
                        "type": "string",
                        "enum": [
                          "GET",
                          "POST",
                          "PUT",
                          "PATCH",
                          "DELETE"
                        ]
                      },
                      "environment": {
                        "type": "string"

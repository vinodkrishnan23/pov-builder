{
  "version": "1.0.0",
  "pov_name": "thoughtspot_mongodb_voyage_pov",
  "base_url": "/api/v1",
  "tenancy": {
    "resolution": "All tenant-scoped endpoints require tenantKey in the path and are backed by tenant lookup query qp_lookup_tenant_by_key before executing collection-specific operations.",
    "tenant_path_param": "tenantKey"
  },
  "conventions": {
    "id_format": "MongoDB ObjectId as 24-char hex string",
    "timestamps": "ISO-8601 string in responses",
    "pagination": "Cursor pagination is not supported by the authoritative query patterns; list endpoints use limit with optional pageSize only.",
    "async_processing": "Document ingestion/processing and benchmark execution are asynchronous at the application layer, but persistence is represented through CRUD on documents/benchmark_runs plus status polling backed by existing query patterns."
  },
  "endpoints": [
    {
      "name": "getTenant",
      "method": "GET",
      "path": "/tenants/{tenantKey}",
      "purpose": "Resolve a tenant/workshop namespace and return its basic metadata before any upload, search, memory, or benchmark action.",
      "path_params": {
        "tenantKey": "string"
      },
      "request": {
        "query": {},
        "body": null
      },
      "response": {
        "status": 200,
        "body": {
          "tenant": {
            "id": "string",
            "tenantKey": "string",
            "name": "string",
            "deploymentMode": "shared_pov | isolated_pov | null",
            "status": "active"
          }
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "message": "No active tenant found for the provided tenant key."
        }
      ],
      "backing": {
        "type": "query_pattern",
        "query_pattern": "qp_lookup_tenant_by_key",
        "mongodb_operation": "tenants.findOne"
      }
    },
    {
      "name": "createTenant",
      "method": "POST",
      "path": "/tenants",
      "purpose": "Create a tenant/workshop namespace for an isolated POV corpus. This is a straightforward CRUD endpoint implied by the tenants data model; no custom listing/search behavior is added.",
      "request": {
        "query": {},
        "body": {
          "tenantKey": "string",
          "name": "string",
          "deploymentMode": "shared_pov | isolated_pov",
          "status": "active | inactive (optional, default active)",
          "metadata": {
            "notes": "string (optional)"
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "tenant": {
            "id": "string",
            "tenantKey": "string",
            "name": "string",
            "deploymentMode": "shared_pov | isolated_pov | null",
            "status": "active | inactive",
            "createdAt": "string",
            "metadata": {
              "notes": "string | null"
            }
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "message": "Missing or invalid tenant fields."
        },
        {
          "status": 409,
          "code": "TENANT_KEY_ALREADY_EXISTS",
          "message": "Tenant key already exists."
        }
      ],
      "backing": {
        "type": "crud",
        "mongodb_operation": "tenants.insertOne"
      }
    },
    {
      "name": "listDocuments",
      "method": "GET",
      "path": "/tenants/{tenantKey}/documents",
      "purpose": "List uploaded or processed documents for a tenant, optionally filtered by document type or source category for corpus review.",
      "path_params": {
        "tenantKey": "string"
      },
      "request": {
        "query": {
          "documentTypes": "comma-separated list of document_type values (optional)",
          "sourceCategories": "comma-separated list of source_category values (optional)",
          "pageSize": "integer optional, default 20, max 100"
        }
      },
      "body": null,
      "response": {
        "status": 200,
        "body": {
          "documents": [
            {
              "id": "string",
              "title": "string",
              "documentType": "string",
              "sourceCategory": "string",
              "status": "uploaded | processed",
              "mimeType": "string | null",
              "fileSizeBytes": "number | null",
              "checksum": "string | null",
              "createdAt": "string",
              "updatedAt": "string",
              "textExtraction": {
                "status": "pending | completed | failed | null",
                "pageCount": "number | null"
              },
              "structuredMetadata": "object | null",
              "tags": [
                "string"
              ]
            }
          ],
          "pageSize": "number"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "message": "No active tenant found for the provided tenant key."
        },
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "message": "Invalid filter or pageSize."
        }
      ],
      "backing": {
        "type": "query_pattern",
        "query_pattern": "qp_list_documents_for_tenant",
        "mongodb_operation": "documents.find"
      }
    },
    {
      "name": "createDocument",
      "method": "POST",
      "path": "/tenants/{tenantKey}/documents",
      "purpose": "Register an uploaded source document or agent-memory source record for a tenant. This endpoint supports the core upload flow by persisting document metadata; extraction/chunking/embedding execution happens asynchronously outside this contract.",
      "path_params": {
        "tenantKey": "string"
      },
      "request": {
        "query": {
          "checkDuplicate": "boolean optional, default true"
        },
        "body": {
          "documentType": "pdf | csv | google_sheet_export | txt | md | html | doc_export | slack_export | jira_export | conversation_memory | other",
          "sourceCategory": "uploaded_file | connector_export | agent_memory",
          "title": "string",
          "sourceUri": "string (optional)",
          "storageProvider": "s3 | atlas | other (optional)",
          "mimeType": "string (optional)",
          "fileSizeBytes": "number (optional)",
          "checksum": "string (optional)",
          "language": "string (optional)",
          "tags": [
            "string"
          ],
          "structuredMetadata": {
            "author": "string (optional)",
            "createdSourceAt": "string (optional ISO-8601)",
            "connectorName": "string (optional)",
            "externalIds": "object (optional)"
          },
          "textExtraction": {
            "status": "pending | completed | failed",
            "rawText": "string (optional)",
            "pageCount": "number (optional)",
            "extractedAt": "string (optional ISO-8601)",
            "errorMessage": "string (optional)"
          },
          "agentMemoryMetadata": {
            "sessionId": "string (optional)",
            "conversationId": "string (optional)",
            "speakerIds": [
              "string"
            ],
            "capturedAt": "string (optional ISO-8601)"
          },
          "status": "uploaded | processed | failed | archived"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "document": {
            "id": "string",
            "tenantId": "string",
            "documentType": "string",
            "sourceCategory": "string",
            "title": "string",
            "sourceUri": "string | null",
            "storageProvider": "string | null",
            "mimeType": "string | null",
            "fileSizeBytes": "number | null",
            "checksum": "string | null",
            "language": "string | null",
            "tags": [
              "string"
            ],
            "structuredMetadata": "object | null",
            "textExtraction": "object | null",
            "agentMemoryMetadata": "object | null",
            "status": "string",
            "createdAt": "string",
            "updatedAt": "string"
          },
          "duplicateCheck": {
            "performed": "boolean",
            "isDuplicate": "boolean",
            "existingDocument": {
              "id": "string",
              "title": "string",
              "status": "string",
              "checksum": "string",
              "createdAt": "string"
            },
            "behavior": "If checkDuplicate=true and checksum matches a non-archived document, API returns 409 instead of creating a new record."
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "message": "Missing or invalid document fields."
        },
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "message": "No active tenant found for the provided tenant key."
        },
        {
          "status": 409,
          "code": "DUPLICATE_DOCUMENT",
          "message": "A non-archived document with the same checksum already exists for this tenant."
        }
      ],
      "backing": {
        "type": "crud_plus_query_pattern",
        "steps": [
          {
            "query_pattern": "qp_lookup_tenant_by_key",
            "mongodb_operation": "tenants.findOne"
          },
          {
            "query_pattern": "qp_deduplicate_document_upload",
            "mongodb_operation": "documents.findOne",
            "conditional": "when checkDuplicate=true and checksum provided"
          },
          {
            "mongodb_operation": "documents.insertOne"
          }
        ]
      }
    },
    {
      "name": "getDocumentProcessingStatus",
      "method": "GET",
      "path": "/tenants/{tenantKey}/documents/processing-status",
      "purpose": "Review extraction and processing state for uploaded files to see whether they are ready for chunking and search.",
      "path_params": {
        "tenantKey": "string"
      },
      "request": {
        "query": {},
        "body": null
      },
      "response": {
        "status": 200,
        "body": {
          "documents": [
            {
              "id": "string",
              "title": "string",
              "documentType": "string",
              "status": "uploaded | processed | failed",
              "textExtraction": {
                "status": "pending | completed | failed",
                "extractedAt": "string | null",
                "errorMessage": "string | null"
              },
              "updatedAt": "string"
            }
          ]
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "TENANT_NOT_FOUND",
          "message": "No active tenant found for the provided tenant key."
        }
      ],
      "backing": {
        "type": "query_pattern",
        "query_pattern": "qp_document_processing_status",
        "mongodb_operation": "documents.find"
      }
    },
    {
      "name": "getDocumentChunks",
